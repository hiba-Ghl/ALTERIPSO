		<script>
		function toggleRadioFavoriteIcon(checkbox) {

		    const toggle = checkbox.closest('.radio-favori-toggle');

		    if (!toggle) return;

		    const icon = toggle.querySelector('i');

		    if (!icon) return;

		    icon.classList.toggle('glyphicon-star', checkbox.checked);
		    icon.classList.toggle('glyphicon-star-empty', !checkbox.checked);

		    // Bleu si coché, blanc sinon
		    icon.style.color = checkbox.checked ? '#20aaef' : '#ffffff';
		}

		function toggleRadioFavoriteRow(checkbox) {
		    const row = checkbox.closest('tr');

		    if (!row) return;

		    row.classList.toggle('radio-favori-row', checkbox.checked);
		}

		function toggleRadioFavoriteState(checkbox) {
		    toggleRadioFavoriteIcon(checkbox);
		    toggleRadioFavoriteRow(checkbox);
		}

		function toggleRadioFavorite(button) {
		    const checkbox = button.querySelector('.radio-favori-checkbox');
		    if (!checkbox || checkbox.disabled) {
		        return;
		    }
		    checkbox.checked = !checkbox.checked;
		    toggleRadioFavoriteState(checkbox);
		}

		function readURL(input) {
if (input.files && input.files[0]) {
var reader = new FileReader();
reader.onload = function (e) {
imgId = '#preview-' + $(input).attr('id');
$(imgId).attr('src', e.target.result);
}

reader.readAsDataURL(input.files[0]);
}
}


$("div#mainform input[type='file']").change(function () {
readURL(this);
});
$("div#mainform0 input[type='file']").change(function () {
readURL(this);
});
		</script>

