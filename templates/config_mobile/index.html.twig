<script>
document.getElementById('btnEnregistrer').addEventListener('click', function(event) {
  var infoEmailInput = document.querySelector('input[name="info_email"]');
  var infoEmailValue = infoEmailInput.value.trim();

  // Effectuer la validation de l'adresse e-mail
  if (!isValidEmail(infoEmailValue)) {
    event.preventDefault(); // Empêche l'enregistrement du formulaire
    alert("L'adresse e-mail n'est pas valide.");
    infoEmailInput.focus(); // Met l'accent sur le champ d'adresse e-mail en cas d'erreur
  }
});

function isValidEmail(email) {
  // Utilisez une expression régulière pour vérifier si l'adresse e-mail est valide
  var emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  return emailPattern.test(email);
}

// Bouton Annuler : retour à la page de configuration sans envoyer le formulaire principal
document.getElementById('btnAnnuler').addEventListener('click', function () {
  window.location.href = '{{ path('app_config_mobile') }}';
});
</script>
<script>
// ... Votre code existant ...

// Fonction pour ajouter automatiquement le préfixe "pk_" et "sk_" aux champs payement_pk et payement_sk
function handlePkSkPrefix(event) {
  if (event.target.name === 'payement_pk' || event.target.name === 'payement_sk') {
    const prefix = event.target.name === 'payement_pk' ? 'pk_' : 'sk_';
    if (!event.target.value.startsWith(prefix)) {
      event.target.value = prefix + event.target.value;
    }
  }
}

// Ajout de l'événement keydown aux champs payement_pk et payement_sk
document.querySelector('input[name="payement_pk"]').addEventListener('keydown', handlePkSkPrefix);
document.querySelector('input[name="payement_sk"]').addEventListener('keydown', handlePkSkPrefix);

// ... Suite de votre code existant ...
</script>
