                        <td>{{ votes[0] }}</td>
                        <td>{{ votes[1] }}</td>
                        <td>{{ votes[2] }}</td>
                        <td>{{ votes[3] }}</td>
                        <td>{{ votes[4] }}</td>
                    </tr>
                    {% endfor %}
                
            </tbody>
        </table>
        </div>
    </form>
