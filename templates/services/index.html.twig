    <script>
    

        var maintable = $('#dataTables-example').DataTable({
           aLengthMenu: [[-1, 10, 100, 200],["All", 10, 100, 200]],
           "aaSorting": [[ 1, "dsc" ]],
                responsive: true,
                 dom: 'Bfrtip',
                 info: false, // Masquer les informations sur le tableau
                paging: false, // Masquer la pagination
        buttons: [
            { extend: 'copy', className: 'btn-info w' ,title: 'Liste Support Connecté'},
            { extend: 'excel', className: 'btn-danger w' ,title: 'Liste Support Connecté'},
            { extend: 'csv', className: 'btn-warning w' ,title: 'Liste Support Connecté'},
            { extend: 'pdf', className: 'btn-primary w' ,title: 'Liste Support Connecté',orientation:'landscape',
             customize: function(doc) {
              const o_date = new Intl.DateTimeFormat;
              const f_date = (m_ca, m_it) => Object({...m_ca, [m_it.type]: m_it.value});
              const m_date = o_date.formatToParts().reduce(f_date, {});
              //console.log(m_date.day + '-' + m_date.month + '-' + m_date.year);
                                doc['footer'] = (function(page, pages) {
                    return {
                      columns: [
                        {
                          alignment: 'center',
                          text: [
                          
                            { text: page.toString(), italics: true },
                  ' / ',
                            { text: pages.toString(), italics: true },

                            { text: '   |'+ m_date.day + '-' + m_date.month + '-' + m_date.year },

                            
                  ]
                      }],
                      margin: [10, 0]
                    }
                  });
              }

          },   

      // { extend: 'print', className: 'btn-default w' ,title: 'Liste Support Connecté'},




        ]
        });
        </script>
