{% extends 'home/index.html.twig' %}
{% block body %}
<style>
    #div2 {
			border-radius: 25px;
			border: 2px solid #3087ce;
			width: 1300px;
			height: 250px;
			margin-left: -70px;
			margin-top: 10px;
			background-color: white;
		}
</style>

<div style="border-radius: 8px;text-align: left;margin-top:10px;margin-bottom: 10px;margin-left: -70px;color: white;font-style: oblique;font-size: 20px;background-color: #3087ce;width: 250px;padding-left: 10px;">
    <img style="margin-top: -51px;margin-left: -10px;width: 45px;float: left;" src="{{ asset('images/ler.png') }}">
        Ajouter un jeux
</div>
<div id="div2">


	
		<form action="{{path('app_ajouter_jeux')}}" method="post" enctype="multipart/form-data">


			<table style="width: 100%;">
				<tr>
					<td style="width: 33%;">
						<div class="control-label">
							<label  class=" control-label">Nom Jeux:
							</label>
							<input type="text" name="nom" class="form-control" style="width: 99%;">
						</div>

					</td>

					<td style="width: 33%;">
						<div class="control-label">
							<label  class=" control-label">Package:
							</label>
							<input type="text" name="package" class="form-control" style="width: 99%;">
						</div>

					</td>

					<td style="width: 33%;">
						<div class="control-label">
							<label  class=" control-label">Active:
							</label>


							<select class="form-control" name="active" id="active" style="width: 99%;">

								<option value='0'>0</option>
								<option value='1'>1</option>

							</select>
						</div>

					</td>


				</tr>
				
                <tr>

					<td style="width: 33%;">

						<div class="control-label">
							<label  class=" control-label">Position:
							</label>
							<input type="number" name="position" id="position" class="form-control" style="width: 99%;" >
						</div>

					</td>

					<td style="width: 33%;">
						<div class="form-group">
							<label >Logo :</label>
							<input type="file" class="form-control" id="logo" name="logo" style="width: 99%;" >
						</div>
					</td>

					<td style="width: 33%;">
						<div class="control-label">
							<label  class=" control-label">
								Protocole:
							</label>
							<select class="form-control" name="protocole" id="protocole" style="width: 99%;">
								{% for support in supports %}
									<option value="{{support.protocole}}">{{support.nom|upper}}</option>
								{% endfor %}

							</select>
						</div>

					</td>

				</tr>

			</table>

			<br>

			<div style="float:right;margin-right:-60px;">
				<a class="btn btn-danger btn-md" id = "annulerButton" style="width:130px;" href="/jeux">
					<i class="glyphicon glyphicon-remove"></i> Annuler
				</a>
				<button type="submit" class="button btn btn-primary btn-md" name="valider" >
					<i class="glyphicon glyphicon-floppy-disk"></i>
					Enregistrer
				</button>
				</div>
		</form>



	

</div>
<!-- Scripts -->
<script type="text/javascript">


</script>
	


{% endblock %}
