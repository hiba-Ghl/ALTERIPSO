{% extends 'home/index.html.twig' %}
{% block body %}

	<link rel="stylesheet" type="text/css" media="screen" href="{{ asset('css/bootstrap-datetimepicker.min.css') }}">
	<link rel="stylesheet" type="text/css" media="screen" href="{{ asset('css/datetimepicker-style.css') }}">

	<style>

		@media print {
			.noprint {
				display: none
			}
		}
	</style>
	<div class="col-md-12 ">

		<form class="form-inline" action="{{ path('historique_gratuite')}}" method="post">

			<div class="form-group input-append date noprint" id="datetimepicker" style="width: 24%; margin-right: -2%;">
				<label for="exampleInputName2">Du :
				</label>
				<input id='date1' name="date1" value='{{date1}}' class="form-control" type="text" style="width: 45%;"></input>
			<span class="add-on" style="height: 30px;">
				<i class="glyphicon glyphicon-time"></i>
			</span>

		</div>


		<div class="form-group input-append date noprint" id="datetimepicker2" style="width: 24%; margin-right: -2%;">
			<label for="exampleInputName2">Au :
			</label>
			<input id='date2' name="date2" value='{{date2}}' class="form-control" type="text" style="width: 45%;"></input>
		<span class="add-on" style="height: 30px;">
			<i class="glyphicon glyphicon-time"></i>
		</span>

	</div>


	<div class="form-group noprint ">

		<button type="submit" class=" btn btn-sm btn-success" data-toggle="tooltip" data-placement="top" title="Rechercher">
			<i class="glyphicon glyphicon-search"></i>
		</button>

		<a data-toggle="tooltip" data-placement="top" title="Imprimer" class=" btn btn-sm   btn-warning" href="javascript:window.print()">
			<i class="glyphicon glyphicon-print"></i>
		</a>


		<div
			class="btn-group "><!--	<button id="btnExport" type="submit" class=" btn btn-sm btn-default" data-toggle="tooltip" data-placement="top" title="Exporter EXCEL">
								<i class="glyphicon glyphicon-Sauvegarder"></i>
							</button>-->


		</div>


	</div>


</form>

<h3>Historique des opérations du
	<strong>{{date1}}
	</strong>au
	<strong>{{ date2 }}
	</strong>

</h3>


<hr></div>{#{dump(historiquegratuite)}#}<div class="col-md-12">
<div class="panel panel-success">
	<div class="panel-heading">Historique d'opération</div>
	<div class="panel-body">


		<table class="table table-striped header-fixed table-bordered table-hover table-checkable order-column" style="width:100%">
			<thead>

				<tr>
					<th style="text-align: center; width: 215px;height:50px;">
					Date d'opération
					</th>
					<th style="text-align: center; width: 215px;height:50px;">
						Mode de gratuité
					</th>
					<th style="text-align: center; width: 215px;height:50px;">
						Date début de gratuité
					</th>
					<th style="text-align: center; width: 215px;height:50px;">
					Date fin de gratuité
					</th>
					<th style="text-align: center; width: 216px;height:50px;">
					Nb de Tv
					</th>


				</tr>
			</thead>

			<tbody>
				{% for hg in historiquegratuite %}
					{#{dump(hg.date|date('Y-m-d', 'Europe/Paris'))}}
									{{dump(date1|date('Y-m-d', 'Europe/Paris'))}}
									{{dump(date2|date('Y-m-d', 'Europe/Paris'))}#}

					{% if hg.date|date('Y-m-d', 'Europe/Paris') <= date2|date('Y-m-d', 'Europe/Paris')  and hg.date|date('Y-m-d', 'Europe/Paris') >=  date1|date('Y-m-d', 'Europe/Paris')   %}
						<tr>
							<td style="text-align: center; width: 215px;height:50px;">{{hg.date}}</td>
							<td style="text-align: center; width: 215px;height:50px;">
								{{hg.type}}</td>
							<td style="text-align: center; width: 215px;height:50px;">
								{{hg.datein}}</td>
							<td style="text-align: center; width: 215px;height:50px;">{{hg.dateout}}
							</td>

							<td style="text-align: center; width: 215px;height:50px;">{{nbbox}}
							</td>


						</tr>
					{% endif %}
				{% endfor %}

			</tbody>

		</table>

	</div>
</div></div></div></div></div><script src="{{asset('javascript/jquery.min.js')}}"></script><script>$(document).ready(function () {


$(".bootstrap-datetimepicker-widget").mouseleave(function () {

var box = $("#date1").val();

$('#date11').val(box)


var box = $("#date2").val();

$('#date22').val(box)


});


});</script><script type="text/javascript">var refresh = window.getElementById('refresh');
refresh.addEventListener('click', location.reload(), false);</script><script type="text/javascript" src="http://cdnjs.cloudflare.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script><script type="text/javascript" src="{{ asset('javascript/bootstrap-datetimepicker.min.js') }}"></script><script type="text/javascript" src="{{ asset('javascript/bootstrap-datetimepicker.pt-BR.js') }}"></script><script type="text/javascript">$('#datetimepicker').datetimepicker({format: 'dd-MM-yyyy', language: 'pt-BR'});

$('#datetimepicker2').datetimepicker({format: 'dd-MM-yyyy', language: 'pt-BR'});</script>{% endblock %}
