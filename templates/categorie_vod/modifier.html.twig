{% extends 'home/index.html.twig' %}
{% block body %}

<link rel="stylesheet" href="{{ asset('css/css_categVod.css') }}" />

<div class="cv-mod-header">
    <img class="cv-mod-header-icon" src="{{ asset('images/ler.png') }}">
    Modifier la  catégorie VOD : {{categorie_v_o_ds.nom}}
</div>

<div class="cv-mod-container">

    <form name="" class="cv-mod-form form-horizontal" method="post" action="{{ path('app_modifier_categorievod',{'id': categorie_v_o_ds.getId()}) }}" enctype="multipart/form-data" onsubmit="return validateForm()" >

        <div class="row cv-mod-row">
            <!-- Colonne pour le logo -->
            <div class="col-md-4 text-center">
                    <div class="form-group">
                            <img src="{{ path('afficher_image', { filename: categorie_v_o_ds.logo|split('/')|last, directory: 'categorie_vod_directory' }) }}" id="cv-mod-logo-preview-img" class="cv-mod-logo-preview" />
                </div>
            </div>

            <!-- Colonne pour les autres champs -->
            <div class="col-md-8">
                <div class="form-group row">
                    <label for="nom" class="col-lg-2 col-form-label">Nom</label>
                    <div class="col-lg-10">
                        <input type="text" id="nom" name="nom" class="form-control" value="{{categorie_v_o_ds.nom}}"/>
                    </div>
                </div>

                <div class="form-group row">
                    <label for="active" class="col-lg-2 col-form-label">Active</label>
                    <div class="col-lg-10">
                        <select id="active" name="active" class="form-control">
                        {% if categorie_v_o_ds.active == 0 %}
						<option value="0">Non Active</option>
						<option value="1">Active</option>
                        {% else %}
                        <option value="1">Active</option>
                        <option value="0">Non Active</option>
                        {% endif %}
					    </select>

                    </div>
                </div>

                <div class="form-group row">
                    <label for="position" class="col-lg-2 col-form-label">Position</label>
                    <div class="col-lg-10">
                        <select id="position" name="position" class="form-control">
                            <option value="{{ categorie_v_o_ds.position }}">{{ categorie_v_o_ds.position }}</option>
                                {% for position in availablePositions %}
                                    <option value="{{ position }}">{{ position }}</option>
                                {% endfor %}
                        </select>
                    </div>
                </div>

                <div class="form-group row">
                    <label for="cv-mod-logo-input" class="col-lg-2 col-form-label">Logo</label>
                    <div class="col-lg-10">
                        <input type="file" class="form-control-file" id="cv-mod-logo-input" name="logo" accept=".jpg, .jpeg, .png" onchange="previewLogo(event)">
                        <p class="cv-error-message" id="file-error">La taille maximale du fichier est de 400 Ko.</p>       
                    </div>
                </div>
                <div class="form-group ">
            <label class="col-lg-2 control-label cv-accordion-toggle cv-label-left" style="text-align:left;" data-toggle="collapse" data-parent="#accordion" href="#collapseTwo">Langues</label>
            <!-- le bouton de traduction -->
            <div class="col-lg-10">
            <button type="button" id="translateBtn" class="btn btn-info btn-sm">
                <i class="glyphicon glyphicon-globe"></i> Traduire le texte
            </button>
                <a type="button" class="cv-accordion-toggle" data-toggle="collapse" data-parent="#accordion" href="#collapseTwo">
                <span><i class="glyphicon glyphicon-plus"></i></span>
            </a>
            <div>
             <div class="cv-mod-lang-container">

            <!-- les langues --> 
          <div id="collapseTwo" class="panel-collapse collapse">
                <div class="panel-body">
                  <div id="inputGroup1" >
                    <div class="form-row cv-form-row-custom">
                        <div class="form-group col-md-6">
                            <img class="cv-lang-icon" src=" {{asset('images/eng.png')}}">
                        <label for="EN">English</label>
                        <input type="text" class="form-control" id="EN" name="EN" value="{{categorie_v_o_ds.en}}">
                        </div>
                        <div class="form-group col-md-6 cv-form-group-custom">
                            <img class="cv-lang-icon" src="{{asset('images/es.png')}}">
                        <label for="ES">Espagnol</label>
                        <input type="text" class="form-control" id="ES" name="ES" value="{{categorie_v_o_ds.es}}">
                        </div>
                    </div>
              
                    <div class="form-row cv-form-row-custom">
                        <div class="form-group col-md-6">
                            <img class="cv-lang-icon" src=" {{asset('images/pt.png')}}">
                        <label for="PT">Portugues</label>
                        <input type="text" class="form-control" id="PT" name="PT" value="{{categorie_v_o_ds.pt}}">
                        </div>
                        <div class="form-group col-md-6 cv-form-group-custom">
                            <img class="cv-lang-icon" src=" {{asset('images/ita.png')}}">
                        <label for="IT">Italiano</label>
                        <input type="text" class="form-control" id="IT" name="IT" value="{{categorie_v_o_ds.it}}">
                        </div>
                    </div>
                    <div class="form-row cv-form-row-custom">
                        <div class="form-group col-md-6">
                            <img class="cv-lang-icon" src=" {{asset('images/rus.png')}}">
                        <label for="RU">Russian</label>
                        <input type="text" class="form-control" id="RU" name="RU" value="{{categorie_v_o_ds.ru}}">
                        </div>
                        <div class="form-group col-md-6 cv-form-group-custom">
                          <img class="cv-lang-icon" src=" {{asset('images/deu.png')}}">
                        <label for="DE">Deutsch</label>
                        <input type="text" class="form-control" id="DE" name="DE" value="{{categorie_v_o_ds.de}}">
                        </div>
                    </div>
                    <div class="form-row cv-form-row-custom">
                        <div class="form-group col-md-6">
                            <img class="cv-lang-icon" src=" {{asset('images/ch.png')}}">
                        <label for="ZH">China</label>
                        <input type="text" class="form-control" id="ZH" name="ZH" value="{{categorie_v_o_ds.zh}}">
                        </div>
                        <div class="form-group col-md-6 cv-form-group-custom">
                            <img class="cv-lang-icon" src=" {{asset('images/ma.png')}}">
                        <label for="AR">العربية</label>
                        <input type="text" class="form-control" id="AR" name="AR" value="{{categorie_v_o_ds.ar}}">
                        </div>
                    </div>
                  </div>
                </div>
              </div>
        </div>
                </div>
            </div>
        </div>


        <!-- les boutons des formulaires -->

        <div class="cv-mod-btn-group">
         <a class="btn btn-danger btn-md cv-mod-btn-annuler" id = "annulerButton" href="/categorie/vod">
             <i class="glyphicon glyphicon-remove"></i> Annuler
         </a>
         <button type="submit" class="btn btn-primary btn-md" name="valider" >
             <i class="glyphicon glyphicon-floppy-disk"></i>
             Enregistrer
         </button>
 </div>


    </form>


</div>



<br> <br> <br> <br>



 
<script>
    // control de la taille du logo 
    function validateForm() {
            //la partie de la taille du logo
            var fileInput = document.getElementById('cv-mod-logo-input');
            var file = fileInput.files[0];
            var maxSize = 400 * 1024; // 50 KB

            if (file && file.size > maxSize) {
                var sizeerrorMessage = document.getElementById('file-error');
                sizeerrorMessage.style.display = 'block';
                return false; // Empêche la soumission du formulaire
            }
    }

    // affichage du logo apres lupload directement 
    function previewLogo(event) {
            var reader = new FileReader();
            reader.onload = function(){
                var output = document.getElementById('cv-mod-logo-preview-img');
                output.src = reader.result;
            };
            reader.readAsDataURL(event.target.files[0]);
        }
</script>


  <!-- la partie de traduction -->

      <script>
const configApp = {{configApp | raw}}
document.addEventListener('DOMContentLoaded', function () {
	const traduireButton = document.getElementById('translateBtn');
	 const languageInputs = {
            en: document.getElementById("EN"),
            es: document.getElementById("ES"),
            pt: document.getElementById("PT"),
            it: document.getElementById("IT"),
            ru: document.getElementById("RU"),
            de: document.getElementById("DE"),
            zh: document.getElementById("ZH"),
            ar: document.getElementById("AR"),
        };
        let translations = {};
        async function translateAll(text) {
            const languages = Object.keys(languageInputs);
            let results = [];
             while(1)
             {
                results = await translate(text, languages, 'fr');
                if(results)
                    break;
             }
            languages.forEach((lang, index) => {
                translations[lang] = results[index];
            });
        }
        if (traduireButton) {
            traduireButton.addEventListener('click', async(event) => {
                const textInput = document.getElementById("nom");
                const text = textInput.value.trim() ;
                if (text === '') {
                    alert("Veuillez entrer un texte à traduire.");
                    return;
                }
                if(configApp.Status === 'Offline')
                {
                    alert("Aucun internet disponible : vous pouvez faire la traduction manuellement");
                    return ;
                }
                await translateAll(text);
                Object.keys(languageInputs).forEach(lang => {
                    if (translations[lang]) {
                        languageInputs[lang].value = translations[lang];
                    }
                });
            });
        }
});

</script>
