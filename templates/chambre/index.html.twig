<script type="text/javascript">
  // recherhe par service
function getval(sel)
{
   
     $('#myInput').val(sel.value);
     $("#myTable tr").filter(function() {
      $(this).toggle($(this).text().toLowerCase().indexOf(sel.value.toLowerCase()) > -1)
    });
}
</script>
