

{% extends 'home/index.html.twig' %}
{% block body %}

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<style>
		#div1 {
			border-radius: 25px;
			border: 2px solid #3087ce;
			padding: 43px;
			width: 1091px;
			height: 300px;
			margin-left: 10px;
			margin-top: 10px;

		}
	</style>

<div style="border-radius: 8px;text-align: left;margin-bottom: 10px;margin-left: -120px;color: white;font-style: oblique;font-size: 20px;background-color: #3087ce;width: 250px;padding-left: 10px;">
    <img style="margin-top: -51px;margin-left: -10px;width: 45px;float: left;" src="{{ asset('images/ler.png') }}">
       Charte Patient
</div>
<div id="div2">
<form action="" method="post" enctype="multipart/form-data">

<input  type="file" name="file" id="file" class="upload"   accept=".pdf"   /> <br> 
<label style="color: red" >Seul les fichiers pdf peuvent être téléchargés </label><br>
<div>
  <button type="submit" {% if app.user.SauvegarderChartPatient == '0' %} disabled {% endif %} name="valider" class="btn btn-success btn-sm" style="margin-bottom: 10px; border: 2px; padding: 8px; margin-right: 5px;width:150px;">
        <i class="glyphicon glyphicon-floppy-disk"></i>
            Sauvegarder
    </button>

    <a name="annuler"  class="btn btn-danger btn-sm" style="margin-bottom: 10px; border: 2px; padding: 8px;width:150px;" href="/home">
        <i class="glyphicon glyphicon-remove"></i>
        Annuler
    </a>
</div>
<div style="display:flex;justify-content:center;width:100%;height:530px">
    <object data="{{ asset(package)}}" type="application/pdf" width="50%" height="100%" style="border-radius:5px;">
        <p>Impossible d'afficher le fichier PDF. Vous pouvez le <a href="{{ asset(package)}}">télécharger ici</a>.</p>
    </object>
</div>
</form>
</div>


{% endblock %}