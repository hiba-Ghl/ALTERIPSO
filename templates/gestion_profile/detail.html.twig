
{% extends 'home/index.html.twig' %}
{# Cette section concerne la conception de modèles pour l'ajout d'un service.#}
{% block body %}

{# offline #}
{% if appConfig.StatusServeur is same as('Offline') %}

<script src="{{ asset('javascript/all.min.js') }}"></script>{% else %}
{# online #}
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/js/all.min.js"></script>

{% endif %}
<link rel="stylesheet" href="{{ asset('css/css_detailUser.css') }}">

<div class="detail-user-header">
    <img class="detail-user-header-logo" src="{{ asset('images/ler.png') }}">
        Détails de l'utilisateur : {{user.username | capitalize}}
</div>
<div>
<div class="detail-user-wrapper">
<h3 class="detail-user-section-title">Informations personnelles</h3>
<div class="detail-user-section-box">
			<div class="detail-user-field-row">
			<label for="inputEmail">Identifiant:</label>
			<div class="detail-user-field-value">{{user.username | capitalize }}</div>
			</div>
			<div class="detail-user-field-row">
			<label for="inputEmail">Email:</label>
			<div class="detail-user-field-value">
				{{user.email | capitalize }}
			</div>
			</div>
			<div class="detail-user-field-row">
			<label for="inputEmail">Fonction:</label>
			<div class="detail-user-field-value"> 
				{% for role in user.roles %}{{ role  | capitalize }}{% endfor %}
			</div>
			</div>
</div>
<h3 class="detail-user-section-title">
	Liste des opérations autorisées
</h3>
<div class="detail-user-section-box">
					 <div class="detail-user-operation-row">
			<label>Ajouter une catégorie</label>
			{% if user is defined and user.AjoutCategorie %}
				<i class="glyphicon glyphicon-ok" style="color: green;"></i> 
			{% else %}
				<i class="glyphicon glyphicon-remove" style="color: red;"></i>
			{% endif %}
            </div>
					 <div class="detail-user-operation-row">
            <label>Mettre à jour les TV</label>
			{% if user is defined and user.MjTv %}
				<i class="glyphicon glyphicon-ok" style="color: green;"></i> 
			{% else %}
				<i class="glyphicon glyphicon-remove" style="color: red;"></i>
			{% endif %}
            </div>
					 <div class="detail-user-operation-row">
			<label>Changer Catégories page d'acceuil</label>
			{% if user is defined and user.ChangeCat %}
				<i class="glyphicon glyphicon-ok" style="color: green;"></i> 
			{% else %}
				<i class="glyphicon glyphicon-remove" style="color: red;"></i>
			{% endif %}
            </div>
			<div class="detail-user-operation-row">
			<label>Changer font d'écran de page d'accuei</label>
			{% if user is defined and user.FondEcran %}
				<i class="glyphicon glyphicon-ok" style="color: green;"></i> 
			{% else %}
				<i class="glyphicon glyphicon-remove" style="color: red;"></i>
			{% endif %}
            </div>
					 <div class="detail-user-operation-row">
			<label>Enregistrer les échanges des catégories de pages d'accueil</label>
			{% if user is defined and user.SauvegarderAcceuil %}
				<i class="glyphicon glyphicon-ok" style="color: green;"></i> 
			{% else %}
				<i class="glyphicon glyphicon-remove" style="color: red;"></i>
			{% endif %}
            </div>
			<div class="detail-user-operation-row">
			<label>Contrôler l’affichage du logo sur TV</label>
			{% if user is defined and user.CocherLogo %}
				<i class="glyphicon glyphicon-ok" style="color: green;"></i> 
			{% else %}
				<i class="glyphicon glyphicon-remove" style="color: red;"></i>
			{% endif %}
            </div>
