<style>
    table {
    width: 100%;
    border-collapse: collapse;
    }
    tbody {
        display: block;
        max-height: 350px; 
        overflow-y: auto;
    }
    thead {
    background-color: #f2f2f2;
    position: sticky;
    top: 0;
    z-index: 2;
    }
    tr {
    display: table;
    width: 100%;
    table-layout: fixed;
}


    
</style>


<!--le title header-->
<p id='p'></p>
<div style="border-radius: 8px;text-align: left;margin-bottom: 10px;margin-left: -120px;color: white;font-style: oblique;font-size: 20px;background-color: #3087ce;width: 250px;padding-left: 10px;">
    <img style="margin-top: -51px;margin-left: -10px;width: 45px;float: left;" src="{{ asset('images/ler.png') }}">
    Journal des Annonces
</div>
   
<!--le tableau-->
<div id="div2">
<!--le bouton d'ajout-->
<div style="display:flex;align-items:center;justify-content:space-between;gap:3px;">
<div>
    <a href="{{ path('app_annonce') }}" class="button btn btn-danger" name="add" id="add" style="margin-bottom: 10px; margin-right: 5px;">
            <i class="glyphicon glyphicon-arrow-left"></i>
            Retour
</a>
</div>
<!--la barre de recherche-->
</div>
 <table class="table table-striped table-bordered header-fixed table-hover" id="dataTables-example" style="width: 100%;margin-top:20px;">
    <thead style="width:100%"> 
        <tr style = "width:100%;">
        <th style="height: 30px;width:30%;text-align:center;">Date envoie</th>
        <th style="height: 30px;width:30%;text-align:center;">Chambre</th>
        <th style="height: 30px;width:30%;text-align:center;" >Annonce</th>
        </tr>
    </thead> 
    <tbody id="myTable">
    {% for ann in annonceHistorique  %}
    <tr style="width:100%">
        <td style="height: 30px;width:31%;text-align:center;">{{ ann.date|date('d/m/Y H:i') }}</td>
        <td style="height: 30px;width:31%;text-align:center;">{{ann.nom_chambre.nom}}</td>
        <td style="height: 30px;width:31%;text-align:center;">{{ann.nom_annonce.nom}}</td>
    </tr>
    {% endfor %}
    </tbody>

</table>
</div>
<script>
   $(document).ready(function () {
      $('#dataTables-example').DataTable({
         language: {
            search: "Recherche:",
            emptyTable: "Aucun Annonce disponible."
         },
         paging: false,
         searching: true,
         ordering: true,
         info: false,
      });
   });
</script>


{% endblock %}
