      <div class="form-group f_date">
  <label for="inputEmail" class="control-label required">Valeurs:exemple: 1-3-5 (saisir des chiffres croissant)</label>
  <input type="text" name="date_valeurs" value="{{config.dateValeurs}}" class="form-control" oninput="formatInput(this)">
  <br>
</div>

<script>
function formatInput(input) {
  // Remove any non-digit characters from the input
  const cleanedInput = input.value.replace(/\D/g, '');

  // Limit the input to three digits
  const formattedInput = cleanedInput.slice(0, 3);

  // Insert dashes at the appropriate positions
  const formattedValue = formattedInput
    .replace(/(\d{1})(\d{1})/, '$1-$2')
    .replace(/(\d{1})(\d{1})$/, '$1-$2');

  // Update the input field value with the formatted value
  input.value = formattedValue;
}
</script>

