{% extends 'home/index.html.twig' %}
{% block body %}


<script src="{{ asset('javascript/jquery.min.js') }}"></script>

<style type="text/css">
  
    {# .table {
        width: 100%;
        border-collapse: collapse;
        margin: 20px 0;
        font-size: 15px;
        text-align: left;
    }

    .table thead tr {
        background-color: #E3E9EE;
        color: #333;
        font-weight: bold;
    }

    .table thead th {
        padding: 12px 15px;
        border: 1px solid #edfbfe;
        text-align: center;
    } #}

    {# .table tbody tr {
        border-bottom: 1px solid #f2f2f2;
    } #}

    {# .table tbody td {
        padding: 12px 15px;
        text-align: center;
    } #}

    {# .table tbody tr:nth-child(even) {
        background-color: #F5F7F9;
    }

    .form-check-input {
        margin-top: 0;
    }

    .form-check-label {
        margin-left: 5px;
    }

    .table tbody td:last-child {
        text-align: center;
    } #}

    .div {
        border-radius: 25px;
        border: 2px solid #3087ce;
        padding: 20px;
        width: auto;
        height: auto;
        margin-left: -70px;
        margin-top: 10px;
        background-color: white;
    }

    .table-container {
        width: 100%;
        overflow-y:scroll;
        height: 500px; 
    }
</style>
<div style="border-radius: 8px;text-align: left;margin-bottom: 10px;margin-left: -120px;color: white;font-style: oblique;font-size: 20px;background-color: #3087ce;width: 250px;padding-left: 10px;">
    <img style="margin-top: -51px;margin-left: -10px;width: 45px;float: left;" src="{{ asset('images/ler.png') }}">
    Liste QUESTIONNAIRE
</div>
<div id="div2">
    <div>
        <form method="post" action="{{ path('update_active') }}">
                <div style="width:100%;display:flex;gap:5px">
                        <a href="{{ path('app_ajouter_question') }}" class="btn btn-info btn-sm" name="add" id="add"   {% if app.user.Ajouteqs == '0' %}   disabled {% endif %}>
                            <i class="glyphicon glyphicon-plus"></i> Ajouter des questions
                        </a>
                        <button  class="btn btn-success btn-sm" type="submit" name="Sauvegarder-button" id="Sauvegarder-button" {% if app.user.Sauvgarderqs == '0' %} disabled {% endif %} style="width:150px;">
                            <i class="glyphicon glyphicon-inbox"></i> Sauvegarder
                        </button>
                        <a name="annuler" href="{{ path('app_questionnaire') }}" class="btn btn-danger btn-sm" style="width:150px;">
        			<i class="glyphicon glyphicon-remove"></i>
        			Annuler
    			</a>
                </div>
                <div style="display:flex;justify-content:space-between;">
                        <label style="margin-top:20px;font-size:14px" class="form-label" for="myselect">Liste des services établissement créés :</label>
                    {% set selectedServiceId = app.request.query.get('serviceId') %}
                        <div style="height:40px;">
                        <select id="myselect" class="form-control" name="selectservices">
                            <option value="" slected>Recherche par service</option>
                            {% for s in serviceetablissement %}
                                <option value="{{ s.id }}" {% if s.id == selectedServiceId %}selected{% endif %}>{{ s.nom|upper }}</option>
                            {% endfor %}
                        </select>
                        </div>
                </div>
            <div >
 <table class="table table-striped table-bordered header-fixed table-hover" id="dataTables-example" style="width: 100%;margin-top:20px;">
                    <thead>
                        <tr style="width:100%">
                            <th style="width:50%;height: 50px;text-align:left;">Question</th>
                            <th style="width:10%;height: 50px;text-align:center;">Position</th>
                            <th style="width:10%;height: 50px;text-align:center;">Service</th>
                            <th style="width:10%;height: 50px;text-align:center;">
                            {# <p style="display:flex;gap:10px;"> #}
                                <span>Active</span>
                                <input type="checkbox" id="checklist"></th>
                        {# </p>   #}
                                                  </th>
                            <th style="width: 20%;;height: 50px;text-align:center;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="questionnaireTableBody" style="height:490px;">
                     {% for questionnaire in questionnaire %}
                    <tr class="questionnaire-row" data-service="{{ questionnaire.service.id }}">
                                <td style="text-align:left;width:50.5%;">{{ questionnaire.fr }}</td>
                                <td style="width:138px;text-align:center;">{{ questionnaire.position }}</td>
                                <td style="width:138px;text-align:center;">{{ questionnaire.service.nom }}</td>
                                <td style="width:138px;text-align:center;">
                                    <input name='list[{{ questionnaire.id }}]' type="checkbox" class="btncheckbox" {% if questionnaire.active %}checked{% endif %} {% if app.user.Sauvgarderqs == '0' %} disabled {% endif %}>
                                </td>
                                <td style="text-align:center;width:18%;">
                                    <a data-toggle="tooltip" data-placement="top"   {% if app.user.Modifierqs == '0'%} disabled {% endif %} title="Modifier la question" href="{{ path('app_modifier_question', {'id': questionnaire.id}) }}" class="btn btn-warning btn-xs btn-modifier">
                                        <i class="glyphicon glyphicon-pencil"></i>
                                    </a>                                 
                                    <a data-toggle="tooltip" data-placement="top"  {% if app.user.Supprimerqs == '0' %} disabled {% endif %} title="Supprimer la question" href="{{ path('app_supprimer_question', {'id': questionnaire.id}) }}" onclick="return confirm('Voulez-vous vraiment supprimer cette question : {{ questionnaire.fr }} ?')" class="btn btn-danger btn-xs btn-supprimer">
                                        <i class="glyphicon glyphicon-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </form>
    </div>
</div>


<script>
    document.addEventListener('DOMContentLoaded', function() {
        const rows = document.querySelectorAll('#myTab tbody tr');
        let actionsVisible = false;

        rows.forEach(row => {
            const modifierButton = row.querySelector('.btn-modifier');
            const supprimerButton = row.querySelector('.btn-supprimer');

            if (modifierButton || supprimerButton) {
                actionsVisible = true;
            }
        });

        if (!actionsVisible) {
            document.querySelector('#myTab thead th:last-child').style.display = 'none';
            rows.forEach(row => {
                row.querySelector('td:last-child').style.display = 'none';
            });
        }
    });
</script>

<script>
    document.getElementById('myselect').addEventListener('change', function() {
        var selectedService = this.value.toLowerCase();
        var rows = document.querySelectorAll('.questionnaire-row');

        rows.forEach(function(row) {
            var serviceId = row.getAttribute('data-service');
            if (selectedService === "" || serviceId === selectedService) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    });

    // Filtrer les lignes lors du chargement de la page
    window.addEventListener('load', function() {
        var selectedService = document.getElementById('myselect').value.toLowerCase();
        var rows = document.querySelectorAll('.questionnaire-row');

        rows.forEach(function(row) {
            var serviceId = row.getAttribute('data-service');
            if (selectedService === "" || serviceId === selectedService) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    });

    document.getElementById('checklist').addEventListener('click', function() {
        var selectedService = document.getElementById('myselect').value.toLowerCase();
        var checkboxes;
        if (selectedService === "") {
            checkboxes = document.querySelectorAll('.btncheckbox');
        } else {
            checkboxes = document.querySelectorAll('.questionnaire-row[data-service="' + selectedService + '"] .btncheckbox');
        }
        checkboxes.forEach(function(checkbox) {
            checkbox.checked = document.getElementById('checklist').checked;
        });
    });
</script>

{% endblock %}
