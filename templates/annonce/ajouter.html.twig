<!-- le control de la validite de l'adresse ip-->
<script>
        document.getElementById('ip').addEventListener('input', function() {
    var ipPattern = /^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$/;
    var ipAddress = this.value;

    if (!ipPattern.test(ipAddress)) {
        this.setCustomValidity("Veuillez entrer une adresse IP valide (par exemple, 192.168.1.1)");
    } else {
        this.setCustomValidity("");
    }
    });

</script>


<!-- le control de l'extension, la taille et les positions selon le type -->
<script>

    // Handle file validation on form submission
    document.getElementById('annonceForm').addEventListener('submit', function(event) {
        const type = document.getElementById('type').value;
        const fileInput = document.getElementById('file');
        const errorMessage = document.getElementById('error-message');
        const file = fileInput.files[0];
        
        // Clear previous messages
        errorMessage.textContent = '';

        if (type === 'Image' || type === 'Video' || type === 'PDF') {
            if (!file) {
                errorMessage.textContent = 'Veuillez choisir un fichier.';
                event.preventDefault();
                return;
            }

            const fileSize = file.size;
            let valid = true;

            if (type === 'Image') {
                const maxSize = 400 * 1024; // 400 KB
                if ( fileSize > maxSize) {
                    valid = false;
                    errorMessage.textContent = 'Le fichier image ne respecte pas les critères requis. La taille maximale est de 400 Ko et les formats acceptés sont PNG, JPEG, ou JPG.';
                }
            } else if (type === 'Video') {
                const maxSize = 80 * 1024 * 1024; // 60 MB
                if ( fileSize > maxSize) {
                    valid = false;
                    errorMessage.textContent = 'Le fichier vidéo ne respecte pas les critères requis. La taille maximale est de 60 Mo et les formats acceptés sont MP4, MPG2, M2T, ou 3GP.';
                }
            } else if (type === 'PDF') {
                const maxSize = 100 * 1024 * 1024; // 100 MB
                if ( fileSize > maxSize) {
                    valid = false;
                    errorMessage.textContent = 'La taille du PDF est invalide. La taille maximale est de 100 Mo.';
                }
            }

            if (!valid) {
                event.preventDefault(); // Prevent form submission
            }
        }
    });

    // Update file input based on the selected type
    document.getElementById('type').addEventListener('change', function() {
        const type = this.value;
        const fileInput = document.getElementById('file');
        //const description = document.querySelector('.backk22');
        const container = document.querySelector('.here');

        // Clear previous input 
        container.innerHTML = '';

        if (type === 'Video') {
            container.innerHTML = '<input type="file" id="file" accept=".mp4" name="file" class="form-control" style="width:100%">';
        } else if (type === 'Image') {
            container.innerHTML = '<input type="file" id="file" accept=".jpg, .jpeg, .png" name="file" class="form-control" style="width:100%">';
        } else {
            container.innerHTML = '<input type="file" id="file" accept=".pdf" name="file" class="form-control" style="width:100%">';
        }
    });


    // Update position options based on the selected type
    document.getElementById('type').addEventListener('change', function() {
        const type = this.value;
        const positionSelect = document.getElementById('position');
        const positions = type === 'Video' || type === 'Localtv' || type === 'PDF'
            ? ['Milieu']
            : ['Haut', 'Bas', 'Gauche', 'Droite', 'Milieu'];

        // Clear previous options
        positionSelect.innerHTML = '';

        positions.forEach(function(pos) {
            const option = document.createElement('option');
            option.value = pos;
            option.textContent = pos.charAt(0).toUpperCase() + pos.slice(1);
            positionSelect.appendChild(option);
        });
    });


</script>


       

