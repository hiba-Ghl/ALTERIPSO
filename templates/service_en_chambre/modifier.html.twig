  <!-- script d'ajout des requetes  -->
  <script>
    function addText() {
      // Récupérer la valeur du champ de saisie
      var inputText = document.getElementById("requete").value;

      // Récupérer le contenu actuel du textarea
      var currentText = document.getElementById("listrequte").value;

      // Ajouter le texte du champ dans le textarea avec un saut de ligne
      document.getElementById("listrequte").value = currentText + inputText + "\n";

      // Effacer le champ de saisie après l'ajout
      document.getElementById("requete").value = "";
    }
  </script>
<!--ajouter des nouveux champs dans la table menu-->
<script>
    document.getElementById("add-button").addEventListener("click", function() {
        var table = document.getElementById("exampleo").getElementsByTagName('tbody')[0];
        var newRow = table.insertRow(table.rows.length);

        var cell1 = newRow.insertCell(0);
        var cell2 = newRow.insertCell(1);
        var cell3 = newRow.insertCell(2);
        var cell4 = newRow.insertCell(3);

        cell1.innerHTML = '<input type="text" name="inputname[]" class="form-control"><div class="hide"></div>';
        cell2.innerHTML = '<input type="text" name="inputdesc[]"  class="form-control" maxlength="120"><div class="hide"></div>';
        cell3.innerHTML = '<input type="text" name="inputprice[]" class="form-control" onblur="ajouterDecimales(this)"><div class="hide"></div>';

        // Créer le menu déroulant pour les catégories
        var selectOptions = '<select class="form-control" name="inputcat[]">';
        {% if categorieOptions is empty %}
            selectOptions += '<option value="" selected>Vide</option>';
        {% else %}
            {% for category in categorieOptions %}
                selectOptions += '<option>{{ category.name }}</option>';
            {% endfor %}
        {% endif %}
        selectOptions += '</select>';
        cell4.innerHTML = selectOptions;
    });
</script>

 <!-- script pour ajout nouveau champ prix/quantit -->
 <script>
    function createElement(type, className, textContent = null) {
      var element = document.createElement(type);
      element.className = className;
        if (textContent !== null) {
           element.textContent = textContent;
        }
              
       return element;
    }
              
    function ajouterChampQuantitePrix() {
      var divRow = createElement("div", "form-row");
      divRow.style.marginLeft = "27px";
              
      // Créer les éléments pour Quantité
      var divQuantite = createElement("div", "form-group col-md-6");
      divQuantite.appendChild(createElement("label", null, "Quantité:"));
      divQuantite.appendChild(createElement("input", "form-control", null, "quantite"));
              
      // Créer les éléments pour Prix
      var divPrix = createElement("div", "form-group col-md-6");
      divPrix.style.marginLeft = "27px";
      divPrix.appendChild(createElement("label", null, "Prix:"));
      divPrix.appendChild(createElement("input", "form-control", null, "prix"));
              
      divRow.appendChild(divQuantite);
      divRow.appendChild(divPrix);
              
      // Récupérer le conteneur prixquantite
      var prixquantite = document.getElementById("prixquantite");
              
      // Insérer les nouveaux champs avant le bouton Enregistrer
      prixquantite.insertBefore(divRow, prixquantite.lastElementChild.previousElementSibling);
    }
  </script>

 <!-- script pour changer le forum entre forum prix normal et prix par quantite  -->
  <script>
    // Fonction pour basculer entre les formats en fonction du bouton radio sélectionné
    function toggleFormat(format) {
        if (format === 'format1') {
            document.getElementById('prixnormal').style.display = 'block';
            document.getElementById('prixquantite').style.display = 'none';
            document.getElementById('prixRadio').checked = true;
        } else if (format === 'format2') {
            document.getElementById('prixnormal').style.display = 'none';
            document.getElementById('prixquantite').style.display = 'block';
            document.getElementById('quantiteRadio').checked = true;
        }
    }

    // Écouteur d'événements pour détecter le changement dans le bouton radio
    document.querySelectorAll('input[name="typePrix"]').forEach(function(radio) {
        radio.addEventListener('change', function() {
            toggleFormat(this.value);
        });
    });

    // Appel initial pour afficher le bon format en fonction du formatContenu au chargement de la page
    toggleFormat('{{ formatContenu }}');
</script>
<!--script pour changement de radio-->
<script>
    // Fonction pour basculer entre les formats en fonction du bouton radio sélectionné
    function toggleFormat() {
        if (document.getElementById('prixRadio').checked) {
            document.getElementById('prixnormal').style.display = 'block';
            document.getElementById('prixquantite').style.display = 'none';
        } else if (document.getElementById('quantiteRadio').checked) {
            document.getElementById('prixnormal').style.display = 'none';
            document.getElementById('prixquantite').style.display = 'block';
        }
    }

    // Écouteur d'événements pour détecter le changement dans le bouton radio
    document.querySelectorAll('input[name="typePrix"]').forEach(function(radio) {
        radio.addEventListener('change', function() {
            toggleFormat();
        });
    });

    // Appel initial pour afficher le bon format en fonction du formatContenu au chargement de la page
    toggleFormat();
</script>

<!--limite caractere des requete-->
<script>
    var textarea = document.getElementById('listrequte');

    textarea.addEventListener('input', function() {
        var lines = this.value.split('\n');
        for (var i = 0; i < lines.length; i++) {
            if (lines[i].length > 40) {
                lines[i] = lines[i].substring(0, 40);
            }
        }
        this.value = lines.join('\n');
    });
</script>
