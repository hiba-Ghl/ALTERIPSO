{% extends 'home/index.html.twig' %}
{% block body %}
	<style>
		#div1 {
			border-radius: 25px;
			border: 2px solid #3087ce;
			padding: 43px;
			width: 1091px;
			height: 300px;
			margin-left: 10px;
			margin-top: 10px;

		}
		#div2 {
			border-radius: 25px;
			border: 2px solid #3087ce;
			padding: 20px;
			width: 1050px;
			height: auto;
			margin-left: 10px;
			margin-top: 10px;
			background-color: white;
		}


		.fileUpload {
			position: relative;
			overflow: hidden;
			/* margin: 10px;*/
		}
		.fileUpload input.upload {
			position: absolute;
			top: 0;
			right: 0;
			margin: 0;
			padding: 0;
			font-size: 20px;
			cursor: pointer;
			opacity: 0;
			filter: alpha(opacity=0);

		}

		.header-fixed {
			width: 1200px;
		}

		.header-fixed > thead,
		.header-fixed > tbody,
		.header-fixed > thead > tr,
		.header-fixed > tbody > tr,
		.header-fixed > thead > tr > th,
		.header-fixed > tbody > tr > td {
			display: block;
		}

		.header-fixed > tbody > tr:after,
		.header-fixed > thead > tr:after {
			content: ' ';
			display: block;
			visibility: hidden;
			clear: both;
		}

		.header-fixed > tbody {
			overflow-y: auto;
			height: 400px;
		}

		.header-fixed > tbody > tr > td,
		.header-fixed > thead > tr > th {
			/*width: 20%;*/
			float: left;
		}
	</style>


	<div style="border-radius: 8px;text-align: left;margin-left: 10px;color: white;font-style: oblique;font-size: 20px;background-color: #3087ce;width: 250px;padding-left: 10px;">
		Liste  livreaudio
	</div>

	<div id="div2">
	

		<input id="myInput3" type="text" placeholder="Search.." style="position: absolute;height: 35px;margin-top: -86px;border-color: #3087ce;margin-left: 777px;width: 130px;border: 2px solid;border-radius: 5px;">
		<form
			action="{{ path('modifier_livreaudio')}}" name="form" method="post" enctype="multipart/form-data">

			<!--<table id="" class="table table-striped header-fixed table-bordered table-hover table-checkable order-column">-->
			<table id="liste-chaines" class="table table-striped header-fixed table-bordered table-hover table-checkable order-column">


				<thead>

					<tr>
						<th style="width:150px;height: 50px;">Nom Livreaudio</th>
						<th style="height: 50px;width:250px">Url</th>
						<!--<th style="height: 50px;width:100px">Port</th>-->
						<th style="height: 50px;width:200px">Catégorie </th>
						<th style="height: 50px;width:70px">Icons</th>
						<!--<th style="height: 50px;width:100px">Pays</th>
						<th style="height: 50px;width:100px">Protocole</th>-->
						<th style="height: 50px;width:70px">Actif<input type="checkbox" id="checklist"></th>
						<th style="height: 50px;width:100px">Actions</th>


					</tr>
				</thead>

				<tbody id="myTable3">

					{% for tele in livreaudio %}


						<tr class="odd gradeX">
							<td style="width:150px">
								<label><input name='listenom[{{tele.Id}}]' type="text" value="{{tele.nom}}" class="form-control" style="font-size: 11px;"></label>
								<label style="visibility: hidden;">{{tele.nom}}</label>
							</td>

							<td style="width:250px">
								<label>
									<textarea name='listeip[{{tele.Id}}]' class="form-control" style="margin: 0px -320px 0px 0px;width: 230px;height: 45px;font-size: 11px;">{{tele.Ip}}</textarea>
								</label>
							</td>


							<!--<td style="width:100px">
								<label><input name='listeport[{{tele.Id}}]' type="text" value="{{tele.port}}" class="form-control" style="font-size: 11px;"></label>

							</td>-->


							<td style="width:200px">
								<label>
									<select class="form-control" name='listcatlivreaudio[{{tele.Id}}]'  style="width: 180px; font-size: 11px;" > 
										<option selected=selected value ='{{tele.categorie.Id}}'>{{tele.categorie.nom}}</option>
										
										 {% for a in categorielivreaudio %}      
									  {% if a.nom == tele.categorie.nom %}
									  
									  {% else %}
									  <option value ='{{a.id}}'>{{a.nom}}</option>
									  {% endif %}
									  {% endfor %} 
					  
					  
										
									</select>
									
								
								</label>
							</td>

							<td style="width:70px">


								<div class="fileUpload " id="mainform">
									<img id="preview-{{tele.Id}}" style="width:50px;height:50px;text-align:center" src="{{asset(tele.logo)}}" alt="..." class="img-rounded img-responsive center-block">
									<input id="{{tele.Id}}" type="file" class="upload" name="listelogo[{{tele.Id}}]" accept=".jpg, .jpeg, .png" style="width:50px;height:50px;text-align:center"/>


								</div>


							</td>

						
							{% set ch = ' ' %}
							{% set chg = ' ' %}
							{% if (tele.active) == 1 %}
								{% set ch = 'checked' %}
							{% endif %}
							
							<td style="width:70px">
								<label><input name='listeactive[{{tele.Id}}]' type="checkbox" {{ch}} class="jpCheckbox"></label>
							</td>


							

							<td style="width:120px">
							<!--	<a data-toggle="modal" data-target="#myModal5" name="send" class="btn btn-info btn-xs">
									<i data-toggle="tooltip" data-placement="top" title="lancer la chaîne" class="glyphicon glyphicon-play-circle"></i>
								</a>-->

								<a data-toggle="tooltip" data-placement="top" title="supprimer la chaîne" id="ida" href="{{path('supprimer_livreaudio',{'id':tele.id})}}" class="btn btn-danger btn-xs" onclick="return confirm('Voulez-vous vraiment supprimer la livreaudio : {{tele.nom}} ?')">
									<i class="glyphicon glyphicon-trash"></i>
								</a>
								

							</td>
						</tr>

					{% endfor %}


				</tbody>


			</table>
			<!-- button enregistrer et annuler  -->

			<button type="submit" class="btn btn-success btn-sm" href="{{path('modifier_chaine')}}" style="margin-left: 495px;margin-top: -1103px;width: 130px; /*position: absolute; */background-color: #3087ce;border: 2px solid #3087ce;">
				<i class="glyphicon glyphicon-floppy-disk"></i>Enregistrer</button>
			<button type="button" class="btn btn-danger btn-sm" style="margin-left: 635px;margin-top: -1139px;width: 130px; /*position: absolute;*/background-color: red;border: 2px solid red;">
				<i class="glyphicon glyphicon-remove"></i>Annuler</button>


		</form>
		<form action="{{ path('ajouter_livreaudio')}}" name="form" method="post" enctype="multipart/form-data" style="height: 70px;">
			<table class="table table-striped header-fixed table-bordered table-hover table-checkable order-column">
				<tbody style="height: auto !important;">
					<tr class="odd gradeX" style="background-color:white;">
						<td style="width:150px">
							<label><input name='nom' type="text" value="" class="form-control" style="font-size: 11px;"></label>

						</td>


						<td style="width:250px">
							<label>
								<textarea name='ip' class="form-control" style="margin: 0px -320px 0px 0px;width: 230px;height: 45px;font-size: 11px;"></textarea>
							</label>
						</td>


						<!--<td style="width:100px">
							<label><input name='port' type="text" value="" class="form-control" style="font-size: 11px;"></label>

						</td>-->


						<td style="width:200px">
							<label>
								<select class="form-control" name='catlivreaudio'  style="width: 180px; font-size: 11px;" > 
																	
									 {% for a in categorielivreaudio %}      
									  <option value ='{{a.id}}'>{{a.nom}}</option>
								  
								  {% endfor %} 
				  
				  
									
								</select>
							</label>
						</td>

						<td style="width:70px">


							<div class="fileUpload " id="mainform0">
								<img id="preview-0" style="width:50px;height:50px;text-align:center" src="{{ asset('images/no_image.png') }}" alt="..." class="img-rounded img-responsive center-block">
								<input id="0" type="file" class="upload" name="logo" accept=".jpg, .jpeg, .png" style="width:50px;height:50px;text-align:center"/>


							</div>


						</td>

				

						<td style="width:70px">
							<label><input name='active' type="checkbox"></label>
						</td>


						


						<td style="width:150px">


							<button type="submit" data-toggle="tooltip" data-placement="top" title="Ajouter une chaîne" id="" href="{{path('ajouter_chaine')}}" class="btn btn-info btn-xs">
								<i data-toggle="tooltip" data-placement="top" title="Ajouter un livre audio" class="glyphicon glyphicon-plus"></i>
							</button>
						</td>
					</tr>
				</tbody>
			</table>
		</form>
	</div>
	<br>
	<!-- Modals -->
	


		<script>
			function readURL(input) {
if (input.files && input.files[0]) {
var reader = new FileReader();

reader.onload = function (e) {
imgId = '#preview-' + $(input).attr('id');
$(imgId).attr('src', e.target.result);
}

reader.readAsDataURL(input.files[0]);
}
}


$("div#mainform input[type='file']").change(function () {
readURL(this);
});
$("div#mainform0 input[type='file']").change(function () {
readURL(this);
});
		</script>

		<script>
			$(document).ready(function () {
$("#myInput3").on("keyup", function () {
var value = $(this).val().toLowerCase();
$("#myTable3 tr").filter(function () {
$(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
});
});
});
		</script>
		<script>
			$(document).ready(function () {
$('input:livreaudio').change(function () {
if ($(this).val() === 'r_defini') {
$(".d_defini").show();
$("#d_fin").attr("required", "true");
$("#d_debut").attr("required", "true");
} else {
$(".d_defini").hide();
}
});
});
		</script>
		<script>

			$('#checklist').click(function () { // on cherche les checkbox à l'intérieur de l'id  'magazine'
var magazines = $("label").find(':checkbox.jpCheckbox');
if (this.checked) { // si 'checkAll' est coché
magazines.prop('checked', true);
} else { // si on décoche 'checkAll'
magazines.prop('checked', false);
}
});


$('#checklistgratuite').click(function () { // on cherche les checkbox à l'intérieur de l'id  'magazine'
var magazines = $("label").find(':checkbox.jpCheckbox2');
if (this.checked) { // si 'checkAll' est coché
magazines.prop('checked', true);
} else { // si on décoche 'checkAll'
magazines.prop('checked', false);
}
});
		</script>


	
<script>
    function readURL(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();

            reader.onload = function (e) {
                imgId = '#preview-' + $(input).attr('id');
                $(imgId).attr('src', e.target.result);
            }

            reader.readAsDataURL(input.files[0]);
        }
    }

    $("div#mainform input[type='file']").change(function () {
        readURL(this);
    });
    $("div#mainform0 input[type='file']").change(function () {
        readURL(this);
    });

    $(document).ready(function () {
        $("#myInput3").on("keyup", function () {
            var value = $(this).val().toLowerCase();
            $("#myTable3 tr").filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });
    });

    $(document).ready(function () {
        $('input:livreaudio').change(function () {
            if ($(this).val() === 'r_defini') {
                $(".d_defini").show();
                $("#d_fin").attr("required", "true");
                $("#d_debut").attr("required", "true");
            } else {
                $(".d_defini").hide();
            }
        });
    });

    $('#checklist').click(function () {
        var magazines = $("label").find(':checkbox.jpCheckbox');
        if (this.checked) {
            magazines.prop('checked', true);
        } else {
            magazines.prop('checked', false);
        }
    });

    $('#checklistgratuite').click(function () {
        var magazines = $("label").find(':checkbox.jpCheckbox2');
        if (this.checked) {
            magazines.prop('checked', true);
        } else {
            magazines.prop('checked', false);
        }
    });

</script>


	{% endblock %}
