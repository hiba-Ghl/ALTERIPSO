<script>
document.getElementById('btnEnregistrer').addEventListener('click', function(event) {
  var infoEmailInput = document.querySelector('input[name="info_email"]');
  var infoEmailValue = infoEmailInput.value.trim();

  // Effectuer la validation de l'adresse e-mail
  if (!isValidEmail(infoEmailValue)) {
    event.preventDefault(); // Empêche l'enregistrement du formulaire
    alert("L'adresse e-mail n'est pas valide.");
    infoEmailInput.focus(); // Met l'accent sur le champ d'adresse e-mail en cas d'erreur
  }
});

function isValidEmail(email) {
  // Utilisez une expression régulière pour vérifier si l'adresse e-mail est valide
  var emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  return emailPattern.test(email);
}
</script>
<script>
