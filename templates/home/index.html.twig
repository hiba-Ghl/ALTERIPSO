<div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
<div class="modal-dialog" role="document">
	<div class="modal-content">
		<form name="" method="post" action="{{path('ajoutercategories')}}" class="form-horizontal" enctype="multipart/form-data">
			<div class="modal-header">
				<h5 class="modal-title" id="exampleModalLabel">Ajouter une catégorie</h5>
				<button type="button" class="close" data-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">&times;</span>
				</button>
			</div>
			<div class="modal-body">


				<strong>Infos
				</strong>


				<div class="form-group">
					<label for="nom" class="col-lg-2 control-label">Nom
					</label>
					<div class="col-lg-10">

						<input type="text" id="nom" name="nom" class="form-control"/>

					</div>
				</div>

				<div class="form-group">
					<label for="titre" class="col-lg-2 control-label">Titre</label>
					<div class="col-lg-10">

						<input type="text" id="titre" name="titre" class="form-control"/>

					</div>
				</div>


				<div class="form-group">
					<label for="active" class="col-lg-2 control-label">Active</label>
					<div class="col-lg-10">

						<select id="active" name="active" class="form-control">
							<option value="0">0</option>
							<option value="1">1</option>
						</select>

					</div>
				</div>
				{% set usedPositions = [] %}
				{% for category in categories %}
					{% set usedPositions = usedPositions|merge([category.position]) %}
				{% endfor %}
				
				<div class="form-group">
					<label for="position" class="col-lg-2 control-label">Position</label>
					<div class="col-lg-10">
						<select id="position" name="position" class="form-control">
							
							{% for i in 1..40 %}
							{% if i not in usedPositions %}
								<option value="{{ i }}">{{ i }}</option>
								{% endif %}
							{% endfor %}
						</select>
					</div>
				</div>
				
				
				
				<div class="form-group">
					<label for="html" class="col-lg-2 control-label">Html</label>
					<div class="col-lg-10">

						<input type="text" id="html" name="html" class="form-control"/>

					</div>
				</div>

				<div class="form-group">
					<label for="package" class="col-lg-2 control-label">Package</label>
					<div class="col-lg-10">

						<input type="text" id="package" name="package" class="form-control"/>

					</div>
				</div>

				<br>
				<strong>Média
				</strong>


				<div class="form-group">
