{% extends 'home/index.html.twig' %}

{% block body %}
 {% if appConfig.StatusServeur is same as('Offline') %}
  <script src="{{ asset('javascript/jszip.min.js') }}"></script>
<script src="{{ asset('javascript/pdfmake.min.js') }}"></script>
<script src="{{ asset('javascript/vfs_fonts.js') }}"></script>
<script src="{{ asset('javascript/dataTables.buttons.min.js') }}"></script>
<script src="{{ asset('javascript/buttons.html5.min.js') }}"></script>
<script src="{{ asset('javascript/jquery.min.js') }}"></script>
<script src="{{ asset('javascript/jquery.dataTables.min.js') }}"></script>
<script src="{{ asset('javascript/datatables2.min.js') }}"></script>
<script src="{{ asset('javascript/xlsx.full.min.js') }}"></script> 
<script src="{{ asset('javascript/dataTables.buttons.min.js') }}"></script>
<script src="{{ asset('javascript/clipboard.min.js') }}"></script>
   {% else %}
  <script src="{{asset('javascript/jquery.min.js')}}"> </script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
	<style type="text/css" src="https://cdn.datatables.net/1.10.23/css/jquery.dataTables.min.css"></style>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
  <script src="{{ asset('javascript/datatables2.min.js') }}"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.4/xlsx.full.min.js"></script> 
  <script src="https://cdn.datatables.net/buttons/2.3.3/js/dataTables.buttons.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/clipboard.js/2.0.8/clipboard.min.js"></script> 
  {% endif %} 
<style>

    .table-container {
        max-height: 400px;
        margin-top: 10px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead, th {
        background-color: #f2f2f2;
        position: sticky;
        top: 0;
        z-index: 2;
    }
    
        

    .scrollable {
        max-height: 80px;
        overflow-y: auto;
        white-space: pre-wrap;
        word-wrap: break-word;
        display: block;
    }

      tbody {
        display: block;
        max-height: 360px; 
        overflow-y: auto;
    }

    tr {
        display: table;
        width: 100%;
        table-layout: fixed;
    }

    thead tr {
        display: table;
        width: 100%;
        table-layout: fixed;
    }
.dataTables_filter{
    float: right;
    width: 50%;
    margin-top: -27px;
}

.dataTables_filter label {
  color: #3087ce;
  font-size: 20px;
}
.dataTables_filter input {
  color:black;
  font-size: 16px;
}
</style>  

<div style="border-radius: 8px;margin-left:-130px;  margin-top:10px;text-align: left; margin-bottom: 10px; color: white; font-style: oblique; font-size: 20px; background-color: #3087ce; width: 300px; padding-left: 10px; display: inline-block;">
    <img style="margin-top: -51px; margin-left: -10px; width: 45px; float: left;" src="{{ asset('images/ler.png') }}">
    Liste VOD
</div>
<form name="form" action="{{ path('app_active_vod')}}" method="post" enctype="multipart/form-data">

    <div id="div2">
    <!--les boutons en haut du formulaire-->
    <div style="display:flex;align-items:center;justify-content:space-between;gap:3px;">
    <div>
    <a href="{{ path('app_ajouter_vod') }}" {% if app.user.AjouteVod == '0' %} disabled {% endif %} class="btn btn-info btn-sm" name="add" id="add" style="margin-right: 5px;width:150px;">
        <i class="glyphicon glyphicon-plus"></i> Ajouter VOD
    </a>
    <button type="submit" name="valider" {% if app.user.SauvegarderVod == '0' %} disabled {% endif %} class="btn btn-success btn-sm" style="margin-right: 5px;width:150px;">
        <i class="glyphicon glyphicon-floppy-disk"></i> Sauvegarder
    </button>
    <a name="annuler" href="{{ path('app_vod') }}" class="btn btn-danger btn-sm" style="margin-right: 5px;width:150px;">
        <i class="glyphicon glyphicon-remove"></i> Annuler
    </a>
    </div>
    <!--la barre de recherche-->
    <input id="myInput" type="text" placeholder="Search.." style="float: right; padding: 6px; border-radius: 5px;width:200px;">
    </div>
        <div class="table-container">
 <table class="table table-striped table-bordered header-fixed table-hover" id="dataTables-example" style="width: 100%;margin-top:20px;">
                
                <thead>
                    <tr>
                        <th style="height: 50px;width:190px;text-align:center;" >Logo</th>
                        <th style="height: 50px;width:190px;text-align:center;" >Titre</th>
                        <th style="height: 50px;width:190px;text-align:center;">Description</th>
                        <th style="height: 50px;width:190px;text-align:center;" >
                            <p style="display:flex;gap:10px;justify-content:center">
                            <span>
                                Active
                            </span>
                            <input type="checkbox" id="checklist" style="margin-top:-1px;"></th>
                            </p>                
                        </th>
                        <th style="height: 50px;width:190px;text-align:center;" >Répertoire Vidéo</th>
                        <th style="height: 50px;width:190px;text-align:center;" >Type</th>
                        <th style="height: 50px;width:214px;text-align:center;" style="width:180px">Action</th>
                    </tr>
                </thead>
                <tbody id="myTable">
                    {% for video in videos %}
                        <tr>
                            <td style="height: 50px;width:190px;text-align:center;">
                                <img style="width:40px;height:40px;text-align:center" src="{{ path('afficher_image', { filename: video.logo|split('/')|last, directory: 'vod_directory' }) }}" alt="..." class="img-rounded img-responsive center-block">
                            </td>
                            <td style="height: 50px;width:190px;text-align:center;">{{ video.nom|capitalize }}</td>
                            <td class="scrollable" style="height: 50px;width:190px;text-align:center;">{{ video.description }}</td>
                            {% set ch = video.active == 1 ? 'checked' : '' %}
                            <td style="height: 50px;width:190px;text-align:center;">
                                <label><input {% if app.user.SauvegarderVod == '0' %} disabled {% endif %} name="listeactive[{{ video.id }}]" type="checkbox" {{ ch }} class="jpCheckbox"></label>
                            </td>
                            <td style="height: 50px;width:190px;text-align:center;">{{ video.url }}</td>
                            <td style="height: 50px;width:190px;text-align:center;">{{ video.categorie.nom }}</td>
                            <td style="height: 50px;width:214px;text-align:center;display:flex;justify-content:center;gap:4px;">
                            <div>
                                <span data-toggle="tooltip" data-placement="top" title="Lire la VOD" >
                                <a  title="Lire la VOD" class="btn btn-success btn-xs play-video" data-toggle="modal" data-target="#videoModal" data-video-url="{{ asset(video.url) }}" data-video-title="{{ video.nom|capitalize }}">
                                    <i class="glyphicon glyphicon-play"></i>
                                </a>
                                </span>
                            </div>
                            <div>
                                <a  data-toggle="tooltip" data-placement="top" {% if app.user.ModifierVod == '0' %} disabled {% endif %} title="Modifier la VOD" href="{{ path('app_modifier_vod', { 'id': video.id }) }}" class="btn btn-warning btn-xs">
                                    <i class="glyphicon glyphicon-pencil"></i>
                                </a>
                            </div>
                            <div>
                                <a data-toggle="tooltip" data-placement="top" {% if app.user.SupprimerVod == '0' %} disabled {% endif %} title="Supprimer la VOD" href="{{ path('app_supprimer_vod', { 'id': video.id }) }}" class="btn btn-danger btn-xs" onclick="return confirm('Voulez-vous vraiment supprimer la VOD : {{ video.nom }} ?')">
                                    <i class="glyphicon glyphicon-trash"></i>
                                </a>
                            </div>
                                <div data-toggle="modal" data-target="#modal2-{{video.id}}" data-id ="{{video.id}}"  data-name="{{video.nom}}" class="lancer-button">
                                <a data-toggle="tooltip" data-placement="top" {% if app.user.LancerVod == '0' %} disabled {% endif %} title="Lancer la VOD" name="send" class="btn btn-info btn-xs">
                                    <i class="glyphicon glyphicon-play-circle"></i>
                                </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7">No records found</td>
                        </tr>
                    {% endfor %}
                </tbody>

                
            </table>
        </div>
    </div>
</form>

<!-- Modal Structure -->
<div class="modal fade" id="videoModal" tabindex="-1" role="dialog" aria-labelledby="videoModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
            <h5 class="modal-title" id="videoModalLabel"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="embed-responsive embed-responsive-16by9">
                    <video class="embed-responsive-item" controls id="modalVideo">
                        <source src="" type="video/mp4">  <!-- MP4 format -->
                        <source src="" type="video/mpeg"> <!-- MPEG format -->
                        <source src="" type="video/x-m2t"> <!-- M2T format -->
                        <source src="" type="video/3gpp"> <!-- 3GP format -->
                        Your browser does not support the video tag.
                    </video>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- la selection de tous les boxes dans le checkbox champ-->
<script>
    document.getElementById('checklist').addEventListener('click', function() {
        var checkboxes = document.querySelectorAll('input.jpCheckbox');
        for (var checkbox of checkboxes) {
            checkbox.checked = this.checked;
        }
    });
</script>



<!-- script pour la recherche-->
<script>
    $(document).ready(function() {
        $("#myInput").on("keyup", function() {
            var value = $(this).val().toLowerCase();
            $("#myTable tr").filter(function() {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });
    });
</script>



<!--parametrage de la video dans la modale-->
<script>
    $(document).ready(function(){
        // Initialize tooltips for all buttons
        $('[data-toggle="tooltip"]').tooltip();

        // Handle the button click for playing video
        $('.play-video').on('click', function() {
            var videoUrl = $(this).data('video-url');
            var videoTitle = $(this).data('video-title');

            // Set the video URL
            $('#modalVideo').attr('src', videoUrl);

            // Set the modal title
            $('#videoModalLabel').text(videoTitle);
        });

        // Clear video source when modal is closed
        $('#videoModal').on('hidden.bs.modal', function () {
            $('#modalVideo').attr('src', '');
        });

    });
</script>

<script>
  const chambre = {{chambre | raw }};
function createModal(index,Id,name) {
    const popUP = document.createElement('div');
    popUP.setAttribute("class", "modal fade");
    popUP.setAttribute("tabindex", "-1");
    popUP.style.marginLeft="-200px";
    popUP.setAttribute("role", "dialog");
    popUP.setAttribute("id", `modal1-${index}`);
    popUP.setAttribute("aria-labelledby", "modalLabel1");
    popUP.setAttribute("aria-hidden", "true");
    popUP.innerHTML = `
        <div class="modal-dialog" role="document">
            <div class="modal-content" style="width:800px;height:740px;">
                <div class="modal-header" style="margin-top:30px;">
                <button id="close" type="button" class="close close2" data-dismiss="modal1-${index}" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <div style="border-radius: 8px; text-align: left; margin: 10px 0; color: white; font-style: oblique; font-size: 20px; background-color: #3087ce; width: 220px; padding: 5px 10px;">
                    <img style="margin-top: -55px; margin-left: -10px; width: 45px; float: left;" src="{{ asset('images/ler.png') }}" alt="Icon">
                        Lancer Vod ${name}
                    </div>
                </div>
                <form style="height:100%" id="form" method="post" enctype="multipart/form-data" action="/vod/LancerVod/${Id}">
                <div class="modal-body" id="modal-body1-${index}" >
                <div style="font-size:16px;color:black;">Liste Support connecté à choisir</div>
                </div>
                <div class="modal-footer">
                  <button id="envoyervod" type="submit" class="btn btn-primary conf" name="envoyervod"> <i class="glyphicon glyphicon-send"></i> Lancer Vod</button>
                  <a class="btn btn-danger " style="width: 139px;" href="/vod/" role="button"><i class="glyphicon glyphicon-remove"></i> Annuler</a></div>
            </div>
            </form>
        </div>    
    `;
    return popUP;
}

document.addEventListener('click', function (event) {
    const lancerButton = event.target.closest('.lancer-button');
    console.log(lancerButton);
    if(!lancerButton)
      return ;
    const Id = lancerButton.getAttribute('data-id');
    const name = lancerButton.getAttribute('data-name');
    const active = document.getElementById(`active-${Id}`);
    let index = -1;
    if (lancerButton.getAttribute("data-target")) {
      index = lancerButton.getAttribute("data-target").split('-')[1];
      if(index >= 0)
      {
        if (active && !active.checked) {
        confirm("Attention, Vod n'est pas actif, donc non présent sur la box. Merci de le cocher.Faites dans un premier temps la mise à jour sur la BOX.Enfin, vous pouvez lancer la Vod avec l'icône bleue.");
        event.preventDefault(); 
        return false;
      }
      else{
        const body = document.getElementById('div2');
        const modal = createModal(index,Id,name);
        body.appendChild(modal);
    const modalBody1 = document.querySelector(`#modal-body1-${index}`);
    if (modalBody1 && Array.isArray(chambre)) {
      const existeTable = document.getElementById(`table-${index}`);
      if(!existeTable)
      {
      const table = document.createElement('table');
      table.style.width = "100%";
      table.setAttribute("class","table table-striped header-fixed table-bordered table-hover table-checkable order-column dataTable no-footer");
      table.id = `table-${index}`;
      const thead = document.createElement('thead');
      thead.style.width = "100%";
      thead.innerHTML = `
        <tr style="width:100%;display:flex;justify-content:space-between">
          <th style="width:120px;height:60px;display:flex;align-items: center;gap:5px"><input type="checkbox" id="checkAllboxn"/><p style="color:red">Selectionner / Désélectionner</p></th>
          <th style="width:120px;height:60px;display:flex;align-items: center;justify-content:center">Chambre</th>
          <th style="width:120px;height:60px;display:flex;align-items: center;justify-content:center">Adresse IP</th>
          <th style="width:120px;height:60px;display:flex;align-items: center;justify-content:center">Adresse MAC</th> 
        </tr>`;
      table.appendChild(thead);
      const tbody = document.createElement('tbody');
      tbody.style.width = "100%";
      let i = 0;
      chambre.forEach(chbr => {
    const tr1 = document.createElement('tr');
    tr1.style.width = "100%";
    tr1.style.height = "50px";
    tr1.style.display = "flex";
    tr1.style.justifyContent = 'space-between';
    tr1.innerHTML = `
        <td style="width:120px;height:40px;"><input type="checkbox" value=${chbr.id} name="checked[${i}]" class="boxcheck"/><input style="display:none" type="text" value=${chbr.id} name="chambre[${i}]"></td>
        <td style="width:120px;height:40px;text-align:center;">${chbr.nom}</td>
        <td style="width:120px;height:40px;text-align:center;">${chbr.ip}</td>
        <td style="width:120px;height:40px;text-align:center;">${chbr.Mac}</td>`;
    tbody.appendChild(tr1);
    i++;
});
      table.appendChild(tbody);
      modalBody1.appendChild(table);
      const modal = document.getElementById(`modal1-${index}`);
      modal.classList.remove('fade');
      modal.classList.add('show'); 
      modal.style.display = 'block';
		document.body.style.overflow = 'hidden';
		modal.style.overflowY = 'auto';
		modal.style.maxHeight = '90vh';
      if (!$.fn.dataTable.isDataTable(`#table-${index}`)) {
      $(`#table-${index}`).DataTable({
        language: {
        emptyTable: "Aucune chambre disponible."
    },
        oLanguage: {"sSearch": "Recherche:"},
        paging: false,
        searching: true,
        ordering: false,
        info: false,
        columnDefs: [{ orderable: false, targets: 0 }]
      });
    }
    }
      }
      }
      }
    }
  const checkAll = document.getElementById('checkAllboxn');
const checkboxes = document.querySelectorAll('.boxcheck');

if (checkAll) {
    checkAll.addEventListener('change', () => {
        checkboxes.forEach(checkbox => {
            checkbox.checked = checkAll.checked;
        });
    });
}

if (checkboxes) {
    checkboxes.forEach(checkbox => {
        checkbox.addEventListener('change', () => {
            if (!checkbox.checked) {
                checkAll.checked = false;
            } else if (Array.from(checkboxes).every(cb => cb.checked)) {
                checkAll.checked = true;
            }
        });
    });
}
})

document.addEventListener('click', function (event) {
    const CloseButton = event.target.closest('.close2');
    if(!CloseButton)
        return;
  const dataDismiss = CloseButton.getAttribute("data-dismiss");
   if (dataDismiss) {
    const index = dataDismiss.split('-')[1]; 
    const modal = document.getElementById(`modal1-${index}`); 
    const modalBackdrop = document.getElementsByClassName("modal-backdrop");
    if (modal) {
      modal.classList.remove('show');
      modal.classList.add('fade');
      modal.style.display = 'none';
	  document.body.style.overflow = '';
      modal.style.overflowY = '';
      modal.remove();
    }
    if (modalBackdrop[0]) {
      modalBackdrop[0].remove();
      if(modalBackdrop[0]);
      modalBackdrop[0].remove();
    }
  }

})


</script>



{% endblock %}
