{% extends 'home/index.html.twig' %}
{% block body %}
  
<link rel="stylesheet" href="{{ asset('css/css_AjoutQuest.css') }}">

<div class="header-title">
    <img  class="header-icon" src="{{ asset('images/ler.png') }}">
        Modifier Question 
</div>
    <div id="div">
        <form action="{{path('app_modifier_question',{'id':questionnaire.id})}}" method="post">
            <table>
                    <tr>
                        <td class="td-44">
                                <div class="form-group h-100">
                                <label class="control-label mb-15">Entrer question : Français (max 120 caractères)</label>
                                <textarea id="fr"  name="fr" maxlength="120" class="form-control w-75" >{{questionnaire.Fr}}</textarea>
                            </div>
                        </td>
                      <td class="td-44">
                                    <div class="form-group h-100">
                                    <label class="control-label mb-15">Services</label>
                                    <select class="form-control w-75" id="serviceSelect" name="Service">
                                    <option value="{{questionnaire.service.id }}" selected>{{questionnaire.service.nom|upper}}</option>
                                       {% for s in serviceetablissement %}
                                            {% if questionnaire.service.nom not in s.nom  %}
                                                <option value="{{s.id}}" >{{s.nom|upper}}</option>
                                            {% endif %}   

                                        {% endfor %}
                                    </select>
                                </div>
                        </td>
                    </tr>
                    <tr>
                    <td colspan="2">
                        <div>
                            <button type="button" id="translateBtn" class="btn btn-info">Traduire la question</button>
                            &nbsp;&nbsp;&nbsp;
                            <a type="button" class="accordion-toggle" data-toggle="collapse" data-parent="#accordion" href="#collapseTwo">
                                <span><i class="glyphicon glyphicon-plus"></i></span>
                            </a>
                            <label style="margin-left: 5px;">Langues</label>
                        </div>
                        <script>
                            $(document).ready(function(){
                                $('.accordion-toggle').click(function(){
                                    $(this).find('i').toggleClass('glyphicon-plus glyphicon-minus');
                                });
                            });
                        </script>
                        <div id="collapseTwo" class="panel-collapse collapse">
                            <div class="panel-body">
                                <table class="lang-table">
                                    <tr>
                                        <td>
                                            <img src=" {{asset('images/eng.png')}}">
                                            <label for="EN" class="mb-15">English</label>
                                            <textarea id="EN" name="en" maxlength="120" class="form-control e w-75">{{questionnaire.En}}</textarea>
                                        </td>
                                        <td>
                                            <img src=" {{asset('images/es.png')}}">
                                            <label for="ES" class="mb-15">Espagnol</label>
                                            <textarea id="ES" name="es" maxlength="120" class="form-control e w-75">{{questionnaire.Es}}</textarea>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                <img src=" {{asset('images/pt.png')}}">
                                            <label for="PT" class="mb-15">Portugues</label>
                                            <textarea id="PT"  name="pr" maxlength="120" class="form-control e w-75">{{questionnaire.Pt}}</textarea>
                                        </td>
                                        <td>
                                <img src=" {{asset('images/ita.png')}}">
                                            <label for="IT" class="mb-15">Italiano</label>
                                            <textarea id="IT" name="it"  maxlength="120" class="form-control e w-75">{{questionnaire.It}}</textarea>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                <img src=" {{asset('images/rus.png')}}">
                                            <label for="RU" class="mb-15">Russian</label>
                                            <textarea id="RU" name="rus" maxlength="120" class="form-control e w-75">{{questionnaire.Ru}}</textarea>
                                        </td>
                                        <td>
                                <img src=" {{asset('images/deu.png')}}">
                                            <label for="DE" class="mb-15">Deutsch</label>
                                            <textarea id="DE" name="dtsh"  maxlength="120" class="form-control e w-75">{{questionnaire.De}}</textarea>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                <img src=" {{asset('images/ch.png')}}">
                                            <label for="ZH" class="mb-15">China</label>
                                            <textarea id="ZH" name="chi"  maxlength="120" class="form-control e w-75">{{questionnaire.Zh}}</textarea>
                                        </td>
                                        <td>
                                <img src=" {{asset('images/ma.png')}}">
                                            <label for="AR" class="mb-15">العربية</label>
                                            <textarea id="AR" name="ar"  maxlength="120" class="form-control e w-75">{{questionnaire.Ar}}</textarea>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </td>
                </tr>
                <br>
                <br>
                    <tr>
                            <td class="td-44">
                                <div class="control-label">
                                    <label class="control-label mb-15"> Position: </label>
                                    <select class="form-control w-75" id="positionSelect" name="Position">
                                        <option value={{questionnaire.position}} selected>{{questionnaire.position}}</option>
                                        <option value=""></option>
                                    </select>
                                </div>
                            </td>
                            <td class="td-44">
                                <div class="form-group h-100">
                                    <label class="control-label mb-15">Actif</label>
                                    <select id="form_Active" name="Active" class="form-control w-75">
                                        {% if questionnaire.active == 0 %}
                                            <option value="0" selected>Non actif</option>
                                            <option value="1">Actif</option>
                                        {% else %}
                                            <option value="1" selected>Actif</option>
                                            <option value="0">Non actif</option>
                                        {% endif %}
                                    </select>
                                </div>
                            </td>
                    </tr>
                </table>
                <div class="form-actions">
                    <a class="btn btn-danger btn-md" id = "annulerButton" href="/questionnaire">
                        <i class="glyphicon glyphicon-remove"></i> Annuler
                    </a>
                    <button type="submit" class="btn btn-primary btn-md" name="valider" >
                        <i class="glyphicon glyphicon-floppy-disk"></i>
                        Enregistrer
                    </button>
				</div>
            </form>
        </div>
          <script>
            function showLanguageField() {
                var language = document.getElementById("languageSelect").value;
                var fields = document.getElementsByClassName("language-field");

                for (var i = 0; i < fields.length; i++) {
                    fields[i].style.display = "none";
                }

                if (language) {
                    document.getElementById(language + "-field").style.display = "block";
                }
            }
         </script>
           <script>
            document.getElementById('serviceSelect').addEventListener('change', function () {
                const serviceId = this.value;
                const positionsByService = {{ positionsByService|json_encode|raw }};
                const positionSelect = document.getElementById('positionSelect');

                // Clear the position select options
                positionSelect.innerHTML = '<option value=""></option>';

                // Get the occupied positions for the selected service
                const occupiedPositions = positionsByService[serviceId] || [];

                // Add available positions to the select
                for (let i = 1; i <= 20; i++) {
                    if (!occupiedPositions.includes(i)) {
                        const option = document.createElement('option');
                        option.value = i;
                        option.textContent = i;
                        positionSelect.appendChild(option);
                    }
                }
            });
    </script>

    <script>
     const configApp = {{configApp | raw}}
document.addEventListener('DOMContentLoaded', function () {
	const traduireButton = document.getElementById('translateBtn');
	 const languageInputs = {
            en: document.getElementById("EN"),
            es: document.getElementById("ES"),
            pt: document.getElementById("PT"),
            it: document.getElementById("IT"),
            ru: document.getElementById("RU"),
            de: document.getElementById("DE"),
            zh: document.getElementById("ZH"),
            ar: document.getElementById("AR"),
        };
        let translations = {};
        async function translateAll(text) {
            const languages = Object.keys(languageInputs);
            let results = [];
             while(1)
             {
                results = await translate(text, languages, 'fr');
                if(results)
                    break;
             }
            languages.forEach((lang, index) => {
                translations[lang] = results[index];
            });
        }
        if (traduireButton) {
            traduireButton.addEventListener('click', async(event) => {
                const textInput = document.getElementById("fr");
                const text = textInput.value.trim() ;
                if (text === '') {
                    alert("Veuillez entrer un texte à traduire.");
                    return;
                }
                if(configApp.Status === 'Offline')
                {
                    alert("Aucun internet disponible : vous pouvez faire la traduction manuellement");
                    return ;
                }
                await translateAll(text);
                Object.keys(languageInputs).forEach(lang => {
                    if (translations[lang]) {
                        languageInputs[lang].value = translations[lang];
                    }
                });
            });
        }
});

</script>
