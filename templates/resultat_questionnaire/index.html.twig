        <div class="div">
        {# partie de diagramme #}
        <table class="table">
            <caption class="title"><h6>Statistiques de satisfaction par pourcentages</h6></caption>
            <tr>
                <td id="choix">Veuillez sélectionner les diagrammes selon vos préférences</td>
            </tr>
            <tr  id="buttons">
                <td>
                    <button id="pieChartBtn" class="btn btn-sm btn-primary">Diagramme en secteur</button>
