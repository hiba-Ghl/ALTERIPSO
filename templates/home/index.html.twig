<script>
document.addEventListener("DOMContentLoaded", function() {
    var dropdowns = document.querySelectorAll('.dropdown');

    dropdowns.forEach(function(dropdown) {
        var submenu = dropdown.querySelector('.dropdown-menu');

        // Ajouter un gestionnaire de survol pour le menu déroulant et le sous-menu
        dropdown.addEventListener('mouseover', function() {  
            dropdown.classList.add('active');
            submenu.style.display = 'block';
        });

        // Ajouter un gestionnaire de sortie pour le menu déroulant et le sous-menu
        dropdown.addEventListener('mouseout', function(event) {
            // Vérifier si la souris est sortie du menu déroulant ou du sous-menu
            if (!dropdown.contains(event.relatedTarget) && !submenu.contains(event.relatedTarget)) {
                dropdown.classList.remove('active');
                submenu.style.display = 'none';
            }
        });

        submenu.addEventListener('mouseover', function() {
            dropdown.classList.add('active');
            submenu.style.display = 'block';
        });

        submenu.addEventListener('mouseout', function(event) {
            // Vérifier si la souris est sortie du menu déroulant ou du sous-menu
            if (!dropdown.contains(event.relatedTarget) && !submenu.contains(event.relatedTarget)) {
                dropdown.classList.remove('active');
                submenu.style.display = 'none';
            }
        });
    });
});
</script>

