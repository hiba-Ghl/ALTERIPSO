{% extends 'home/index.html.twig' %}
  {% block body %}

    <link rel="stylesheet" href="{{ asset('css/css_serviceChambre.css') }}" />
    <!-- En-tête de la page -->
    <div class="service-header">
    <img class="service-header-logo" src="{{ asset('images/ler.png') }}">
      Service en chambre
</div>
    <!-- Contenu principal de la page -->
    <div id="div2">
       <!-- Boutons d'ajout de service en chambre -->
      <a  {% if app.user.AjoutServiceEnChambre == '0' %} disabled {% endif %} href="{{ path('service_formu') }}" class="btn btn-info btn-sm" name="add" id="add">
          <i class="glyphicon glyphicon-plus"></i>
          Ajouter service
        </a>
        <!-- Boutons d'ajout de type de service -->
        <button {% if app.user.AjoutServiceEnChambre == '0' %} disabled {% endif %}  data-toggle="modal" data-target="#exampleModal" class="btn btn-primary btn-sm" name="add" id="add">
          <i class="glyphicon glyphicon-plus"></i>
          Ajouter Type service
        </button>
        <a  {% if app.user.SauvegarderServiceEnChambre == '0' %} disabled {% endif %} href="{{ path('service_en_chambre') }}" class="btn btn-success btn-sm" name="add" id="add">
          <i class="glyphicon glyphicon-inbox"></i>
          Sauvegarder
        </a>
		<a type="button" class="btn btn-danger btn-sm service-top-cancel" href="{{ path('service_en_chambre') }}">
				<i class="glyphicon glyphicon-remove"></i>Annuler</a>
    <!-- Affichage des services en chambre -->
    <div class="card-container">
      {% if serviceEnChambres is empty %}
          <p>Il n'y a aucun service disponible!!!</p>
      {% else %}
        {% for serviceEnChambre in serviceEnChambres %}
          <!-- Affichage des détails du service -->
          <div class="card">
              
                <!-- Affichage image du service en chambre-->
                <img src="{{ path('afficher_image', { filename: serviceEnChambre.logo|split('/')|last, directory: 'service_in_room_directory' }) }}" class="service-card-image"/>
              <div class="card-content">
                  <!-- Affichage le nom de service en chambre -->
                  <h3 class="service-card-title">{{ serviceEnChambre.getNom()}}</h3>
                  <!-- Affichage le description service en chambre -->
                  
                <a  href="{{ path('page_details_service_en_chambre', {'id': serviceEnChambre.getId()}) }}" class="btn3 service-edit-btn{% if app.user.ModifierServiceEnChambre == '0' %} disabled-service-btn{% endif %}"><i class="glyphicon glyphicon-pencil"></i></a>
                <a  href="{{path('app_supprimer_service_en_chambre',{'id':serviceEnChambre.id})}}"  class="btn1 service-delete-btn{% if app.user.SuppServiceEnChambre == '0' %} disabled-service-btn{% endif %}" data-toggle="tooltip" data-placement="top" title="supprimer le service" onclick="return confirm('Voulez-vous vraiment supprimer le service : {{serviceEnChambre.nom}} ?')"><i class="glyphicon glyphicon-trash"></i></a>
                <input {% if app.user.SauvegarderServiceEnChambre == '0' %} disabled {% endif %} type="text" value="{{ serviceEnChambre.getPosition()}}" id="position_{{ serviceEnChambre.getId() }}" name="position" onchange="updatePosition({{ serviceEnChambre.getId() }})" class="service-position-input">
                <input {% if app.user.SauvegarderServiceEnChambre == '0' %} disabled {% endif %}  type="checkbox" id="Active_{{ serviceEnChambre.getId() }}" {% if serviceEnChambre.isActive() == 0 %}checked{% endif %} onchange="updateActive({{ serviceEnChambre.getId() }})" class="service-active-checkbox" name="Active">
 
              </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
     <!-- Modal pour l'ajout de type de service -->
    <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <!-- ... (contenu du modal) ... -->
        <div class="modal-dialog" role="document">
          <div class="modal-content">
            <form name="" method="post" action="{{path('ajoutercategoriesservice')}}" class="form-horizontal" enctype="multipart/form-data">
              <div class="modal-header">
                <h5 class="modal-title modal-title-service" id="exampleModalLabel">Ajouter type service</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                  <span aria-hidden="true">&times;</span>
                </button>
              </div>
              <div class="modal-body">
                <strong>Infos</strong>
                <div class="form-group">
                  <!-- ... champ du Nom ... -->
                  <label for="nom" class="col-lg-2 control-label">Nom
                  </label>
                  <div class="col-lg-10">
                    <input type="text" id="nom" name="nom" class="form-control"/>
                  </div>
                </div>
                <div class="form-group">
                    <!-- ... champ du description ... -->
                    <label for="description" class="col-lg-2 control-label">Description</label>
                    <div class="col-lg-10">
                        <textarea id="description" name="Description" class="form-control"></textarea>
                    </div>
                </div>
              </div>
              <div class="modal-footer">
                <!-- ... boutton pour ajouter type de service ... -->
                <button type="submit" href="" class="btn btn-success btn-save-service-type">
                  <i class="glyphicon glyphicon-floppy-disk"></i>
                  Enregistrer</button>
                  <!-- ...  boutton pour annuler le module ... -->
                  <button type="button" class="btn btn-danger"  data-dismiss="modal"><i class="glyphicon glyphicon-remove"></i>Annuler</button>
                </div>
            </form>
          </div>
        </div>
      </div>
      <!--script pour changer la position du service en chambre-->
      <script>
        // Fonction pour vérifier les positions uniques
        function checkUniquePositions() {
            var positions = document.querySelectorAll('input[name="position"]');
            var positionValues = Array.from(positions).map(input => input.value);
    
            var uniquePositions = new Set(positionValues);
    
            if (uniquePositions.size !== positionValues.length) {
                // Afficher une alerte si des positions sont répétées
                alert("Veuillez saisir des valeurs de position uniques.");
            }
        }
    
        // Ajouter un gestionnaire d'événements pour les changements de position
        document.addEventListener("DOMContentLoaded", function() {
            var positionInputs = document.querySelectorAll('input[name="position"]');
            positionInputs.forEach(function(input) {
                input.addEventListener("change", checkUniquePositions);
            });
        });
    </script>
    
   <script>
    function updateActive(serviceId) {
        var isActive = document.getElementById('Active_' + serviceId).checked ? 0 : 1;
        $.ajax({
            url: "{{ path('update_active_service') }}",
            method: "POST",
            data: { id: serviceId, active: isActive },
            success: function(response) {
                // Gérer la réponse du serveur
                console.log("État mis à jour avec succès !");
            },
            error: function(xhr, status, error) {
                // Gérer les erreurs
                console.error(error);
            }
        });
    }
</script>
<script>
  // Ajouter un gestionnaire d'événements pour les changements de position
document.addEventListener("DOMContentLoaded", function() {
  var positionInputs = document.querySelectorAll('input[name="position"]');
  positionInputs.forEach(function(input) {
      input.addEventListener("change", function(event) {
          var position = event.target.value;
          var serviceId = event.target.id.split('_')[1]; // Récupérer l'ID du service

          // Envoi de la requête AJAX
          var xhr = new XMLHttpRequest();
          xhr.open("POST", "/update-position/" + serviceId, true);
          xhr.setRequestHeader("Content-Type", "application/x-www-form-urlencoded");
          xhr.onreadystatechange = function() {
              if (xhr.readyState === XMLHttpRequest.DONE) {
                  if (xhr.status === 200) {
                      // Afficher un message de succès ou effectuer d'autres actions nécessaires
                      console.log("Position mise à jour avec succès.");
                  } else {
                      // Gérer les erreurs
                      console.error("Erreur lors de la mise à jour de la position.");
                  }
              }
          };
          xhr.send("position=" + encodeURIComponent(position));
      });
  });
});

</script>



  {% endblock %}