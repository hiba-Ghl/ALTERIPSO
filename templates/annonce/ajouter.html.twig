<script>
    document.getElementById('type').addEventListener('change', function() {
        var type = this.value;
        var fileUpload = document.getElementById('fileUpload');
        var textInput = document.getElementById('textInput');
        var emojiBar = document.getElementById('emojiBar');
        var fontSelection = document.getElementById('fontSelection');
        var animationSelection = document.getElementById('animationSelection');
        var ipAddress = document.getElementById('ipAddress');
        var languagesPart = document.getElementById('languagesPart');
        var vitesseDefilementBlock = document.getElementById('vitesseDefilementBlock');
        var bgColorDefilementBlock = document.getElementById('bgColorDefilementBlock');
        var textColorDefilementBlock = document.getElementById('textColorDefilementBlock');

        // Hide all by default
        fileUpload.style.display = 'none';
        textInput.style.display = 'none';
        fontSelection.style.display = 'none';
        animationSelection.style.display = 'none';
        ipAddress.style.display = 'none';
        languagesPart.style.display = 'none';
        if (emojiBar) emojiBar.style.display = '';
        if (vitesseDefilementBlock) vitesseDefilementBlock.style.display = 'none';
        if (bgColorDefilementBlock) bgColorDefilementBlock.style.display = 'none';
        if (textColorDefilementBlock) textColorDefilementBlock.style.display = 'none';

        if (type === 'Message') {
            fileUpload.style.display = 'none';
            textInput.style.display = 'block';
            fontSelection.style.display = 'flex';
            animationSelection.style.display = 'none';
            languagesPart.style.display = 'block';
            ipAddress.style.display = 'none';
            if (emojiBar) emojiBar.style.display = 'none';
            if (bgColorDefilementBlock) bgColorDefilementBlock.style.display = 'none';
            if (textColorDefilementBlock) textColorDefilementBlock.style.display = 'none';
        } else if (type === 'Message défilant') {
            fileUpload.style.display = 'none';
            textInput.style.display = 'block';
            fontSelection.style.display = 'flex';
            animationSelection.style.display = 'flex';
            languagesPart.style.display = 'block';
            ipAddress.style.display = 'none';
            if (emojiBar) emojiBar.style.display = '';
            if (vitesseDefilementBlock) vitesseDefilementBlock.style.display = 'flex';
            if (bgColorDefilementBlock) bgColorDefilementBlock.style.display = 'flex';
            if (textColorDefilementBlock) textColorDefilementBlock.style.display = 'flex';
        } else if (type === 'Image' || type === 'Video' || type === 'PDF') {
            fileUpload.style.display = 'block';
            textInput.style.display = 'none';
            fontSelection.style.display = 'none';
            animationSelection.style.display = 'none';
            ipAddress.style.display = 'none';
            languagesPart.style.display = 'none';
        } else if (type === 'Localtv'){
            fileUpload.style.display = 'none';
            textInput.style.display = 'none';
            fontSelection.style.display = 'none';
            animationSelection.style.display = 'none';
            ipAddress.style.display = 'block';
            languagesPart.style.display = 'none';
        }
    });

</script>

