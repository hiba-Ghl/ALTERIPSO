            <button id="lineChartBtn" class="btn btn-sm btn-success">Diagramme en lignes</button>
            <button id="columnChartBtn" class="btn btn-sm btn-danger">Diagramme en colonnes</button>
            <button id="areaChartBtn" class="btn btn-sm btn-warning">Diagramme en aires</button>
        </td> 
    </tr>
    <tr>
        <td> <div id="chart_div" style="width: 900px; height: 500px;"></div> </td>
