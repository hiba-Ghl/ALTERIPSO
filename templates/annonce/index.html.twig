{% extends 'home/index.html.twig' %}

{% block body %}

<style>
    table {
    width: 100%;
    border-collapse: collapse;
    }
    tbody {
        display: block;
        max-height: 350px; 
        overflow-y: auto;
    }
    thead {
    background-color: #f2f2f2;
    position: sticky;
    top: 0;
    z-index: 2;
    }
    tr {
    display: table;
    width: 100%;
    table-layout: fixed;
}


    
</style>


<!--le title header-->
<p id='p'></p>
<div style="border-radius: 8px;text-align: left;margin-bottom: 10px;margin-left: -120px;color: white;font-style: oblique;font-size: 20px;background-color: #3087ce;width: 250px;padding-left: 10px;">
    <img style="margin-top: -51px;margin-left: -10px;width: 45px;float: left;" src="{{ asset('images/ler.png') }}">
    Gestion des Annonces
</div>
   
<!--le tableau-->
<div id="div2">
<!--le bouton d'ajout-->
<div style="display:flex;align-items:center;justify-content:space-between;gap:3px;">
<div>
<a href="{{ path('app_ajouter_annonce') }}" class="btn btn-info btn-sm" name="add" id="add" style="" {% if app.user.AjouterAnnonce == '0' %} disabled {% endif %}>
            <i class="glyphicon glyphicon-plus"></i>
            Ajouter Annonce
        </a>
        <button id="sauv" type="submit" class="btn btn-success btn-sm " {% if app.user.SauvegarderAnnonce == '0' %} disabled {% endif %}>
					<i class="glyphicon glyphicon-floppy-disk"></i>
					Sauvegarder
				</button>
				  <a name="annuler" href="{{ path('app_annonce') }}" class="btn btn-danger btn-sm" style="width:150px;">
        <i class="glyphicon glyphicon-remove"></i>
        Annuler
    </a>
</div>
<!--la barre de recherche-->
<input id="myInput" type="text" placeholder="Search.." style="float: right;width:200px; padding: 6px; border-radius: 5px;">
</div>
 <table class="table table-striped table-bordered header-fixed table-hover" id="dataTables-example" style="width: 100%;margin-top:20px;">
    <thead> 
        <tr>
        <th style="height: 50px;width:150px;text-align:center;">Nom</th>
        <th style="height: 50px;width:150px;text-align:center;">Type</th>
        <th style="height: 50px;width:150px;text-align:center;" >Thème</th>
        <th style="height: 50px;width:150px;text-align:center;" >Position</th>
        <th style="height: 50px;width:150px;text-align:center;" >Date début</th>
        <th style="height: 50px;width:150px;text-align:center;" >Date fin</th>
        <th style="height: 50px;width:150px;text-align:center;" >Durée (secondes)</th>
        <th style="height: 50px;width:280px;text-align:center;">Actions</th>
        </tr>
    </thead> 
    <tbody id="myTable">
        {% for annonce in annonces %}
            <tr class="odd gradeX" >
                <td style="height: 50px;width:150px;text-align:center;">{{annonce.nom|capitalize}}</td>
                <td style="height: 50px;width:150px;text-align:center;" >{{annonce.type}}</td>
                <td style="height: 50px;width:150px;text-align:center;">{{annonce.theme|capitalize}}</td>
                <td style="height: 50px;width:150px;text-align:center;">{{annonce.position|capitalize}}</td>
                <td style="height: 50px;width:150px;text-align:center;" >{{annonce.datedebut}}</td>
                <td style="height: 50px;width:150px;text-align:center;">{{annonce.datefin}}</td>
                <td style="height: 50px;width:150px;text-align:center;">{{annonce.duree}}</td>

                <td style="height: 50px;width:280px;text-align:center;">
                <a   data-toggle="tooltip" data-placement="top" title="Détails de l'annonce" href="{{ path('app_details_annonce', { 'id': annonce.id }) }}" class="btn btn-info btn-xs"><i class="glyphicon glyphicon-list-alt"></i></a>
                
                    <a   data-toggle="tooltip" data-placement="top" title="Modifier l'annonce " href="{{ path('app_modifier_annonce', { 'id': annonce.id }) }}" class="btn btn-warning btn-xs"  {% if app.user.ModifierAnnonce == '0' %}  disabled {% endif %}><i class="glyphicon glyphicon-edit"></i></a>									
                <a   data-toggle="tooltip" data-placement="top" title="Supprimer l'annonce" href="{{ path('app_supprimer_annonce', { 'id': annonce.id }) }}" class="ida btn btn-danger btn-xs" onClick="return(confirm('voullez vous vraiment supprimer cette annonce ?'));" {% if app.user.SuppAnnonce == '0' %} disabled {% endif %}><i class="glyphicon glyphicon-trash"></i></a>
                <a   data-toggle="tooltip" data-placement="top" title="Journal"  href="" class=" ida btn btn-success btn-xs" ><i class="glyphicon glyphicon-list" ></i></a>
                <a   data-toggle="tooltip" data-placement="top" title="Envoyer l'annonce" id="" href="" class="ida btn btn-primary btn-xs" ><i class="glyphicon glyphicon-send"></i></a>
                </td>
            </tr>
        {% else %}
                <tr>
                    <td colspan="8">No records found</td>
                </tr>
        {% endfor %}
    </tbody>

</table>
</div>



<!--Initialize tooltips for all buttons-->
<script>
 $(document).ready(function(){
        
        $('[data-toggle="tooltip"]').tooltip();
    });
</script>

<!--pour la recherche-->
<script type="text/javascript">
    $(document).ready(function() {
        $("#myInput").on("keyup", function() {
            var value = $(this).val().toLowerCase();
            $("#myTable tr").filter(function() {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });
    });    
</script>

{% endblock %}
