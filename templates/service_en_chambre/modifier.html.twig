                <script>
                    // Cette fonction ajoute .00 à la fin du nombre saisi par l'utilisateur
                    function ajouterDecimales(input) {
                        // Vérifier si l'entrée est un nombre
                        if (!isNaN(input.value)) {
                            // Formater le nombre avec deux décimales et ajouter .00 à la fin
                            input.value = parseFloat(input.value).toFixed(2);
                        }
                    }
                </script>
