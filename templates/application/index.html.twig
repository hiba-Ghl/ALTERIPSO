{% extends 'home/index.html.twig' %}
{% block body %}

	<link rel="stylesheet" href="{{ asset('css/design.css') }}" />



	<p id='p'></p>
	<div  id="titre">
    <img style="margin-top: -51px;margin-left: -10px;width: 45px;float: left;" src="{{ asset('images/ler.png') }}">
		Liste Applications
	</div>
	<div id="div2">		
        <form action="{{ path('app_modifier_homeapplication')}}" name="test" method="post" enctype="multipart/form-data" onsubmit="return check_fields(this)">           
            <input type="hidden" name="ongletActif" value="{{ app.request.query.get('ongletActif') }}">  

			<div class="col-md-12">
				<a href="{{path('app_ajouter_application')}}" class="btn btn-info btn-sm" name="add" id="add" {% if app.user.AjoutApp == '0' %} disabled {% endif %}>
					<i class="glyphicon glyphicon-plus"></i>
					<span class="btn-text">Ajouter Application</span>
				</a>
				<button id="sauv" type="submit" class="btn btn-success btn-sm " {% if app.user.SauvegarderApp == '0' %} disabled {% endif %}>
					<i class="glyphicon glyphicon-floppy-disk"></i>
					<span class="btn-text">Sauvegarder</span>
				</button>
				<a name="annuler" href="{{ path('app_application') }}" class="btn btn-danger btn-sm">
					<i class="glyphicon glyphicon-remove"></i>
					<span class="btn-text">Annuler</span>
				</a>
		<br><br><br>

		<nav>
			<div class="nav nav-tabs" id="nav-tab" role="tablist">
				{% for support in supports %}
					<a class="nav-item nav-link" id="nav-{{ support.id }}-tab" data-toggle="tab" href="#{{ support.id }}" role="tab" aria-controls="nav-{{ support.id }}" aria-selected="true">{{ support.nom }}</a>
				{% endfor %}
			</div>
		</nav>
		<br><br>
		<div class="tab-content" id="nav-tabContent" style="height:500px;overflow-y:scroll;">
			{% for support in supports %}
				<div class="tab-pane fade" id="{{support.id}}" role="tabpanel" aria-labelledby="nav-profile-tab">
					{% for application in applications %}
						{% if support.protocole == application.protocole %}
							{% set ch=' ' %}
							{% if(application.active=='1') %}
								{% set ch='checked' %}
							{% endif %}


							<div class="col-6 col-sm-4 col-md-3 col-lg-2">
								<div class="thumbnail" style="padding:0px;background-color: rgba(255, 119, 1, 0);border: 1px solid #545658;">
									<img style="width:90%;margin-left:auto;margin-right:auto;margin-top:8px;margin-bottom:8px;height: 138px;" src="{{ path('afficher_image', { filename: application.logo|split('/')|last, directory: 'application_directory' }) }}" alt="..." class="img-rounded img-responsive center-block">

									{# <img style="width:90%;margin-left:auto;margin-right:auto;margin-top:8px;margin-bottom:8px;height: 138px;" src="{{ asset(application.logo) }}" alt="..." class="img-rounded img-responsive center-block"> #}
									<div class="caption" style="background: #020202bd;padding:1px">
										<h5 style="text-align: center;color:#fff;margin-bottom: 4px;">{{application.nom}}</h5>
										{% set ch = '' %}
										{% if application.active  == 1 %}
											{% set ch = 'checked' %}
										{% endif %}

										<input name="listeactive[{{application.id}}]" class="caf3" style="width:100%" type="checkbox" {{ch}} {% if app.user.SauvegarderApp == '0' %} disabled {% endif %}>
										<input type="text" {% if app.user.SauvegarderApp == '0' %} disabled {% endif %} name="listeposition[{{application.id}}]" oninput="this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\..*?)\..*/g, '$1');" value="{{application.position}}" style="width: 27px;margin-top: -205px;position: absolute;margin-left: 59px;height: 26px;background-color: #020202bd;color: white;border-radius: 4px;"/>
										<a data-toggle="tooltip" data-placement="top" {% if app.user.ModifierApp == '0' %} disabled {% endif %} title="modifier l'application" href="{{path('app_modifier_application',{'id':application.id})}}" class="btn btn-warning btn-xs" style="margin-top: -406px;background-color: #020202bd;border-color: #020202bd;">
											<i class="glyphicon glyphicon-pencil"></i>
										</a>
										<a data-toggle="tooltip" data-placement="top" {% if app.user.SupprimerApp == '0' %} disabled {% endif %}  title="supprimer l'application" href="{{path('app_supprimer_application',{'id':application.id})}}" class="btn btn-danger btn-xs" style="margin-top: -406px;background-color: #020202bd;border-color: #020202bd;" onclick="return(confirm('voulez vous vraiment supprimer cette application ?'));">
											<i class="glyphicon glyphicon-trash"></i>
										</a>
									</div>
								</div>
							</div>

						{% endif %}
					{% endfor %}
				</div>
			{% endfor %}

		</div>
		
		</form>
	</div>
    <script>
            $(document).ready(function () {
                // Récupérer l'identifiant de l'onglet actif depuis l'URL
                var ongletActif = "{{ app.request.query.get('ongletActif') }}";

                // Si aucun onglet n'est déjà sélectionné dans l'URL, sélectionner le premier onglet
                if (!ongletActif) {
                    // Simuler un clic sur le premier onglet pour l'afficher et le marquer comme actif
                    $('.nav-item.nav-link:first').addClass('active-tab').trigger('click');
                } else {
                    // Simuler un clic sur l'onglet spécifié par le paramètre ongletActif pour l'afficher et le marquer comme actif
                    $('#nav-' + ongletActif + '-tab').addClass('active-tab').trigger('click');
                }

                // Gérer le clic sur les onglets
                $('.nav-item.nav-link').click(function () {
                    // Supprimer la classe active de tous les onglets
                    $('.nav-item.nav-link').removeClass('active-tab');
                    // Ajouter la classe active à l'onglet cliqué
                    $(this).addClass('active-tab');

                    // Mettre à jour la valeur du champ caché avec l'identifiant de l'onglet
                    var ongletId = $(this).attr('id').split('-')[1];
                    $('input[name="ongletActif"]').val(ongletId);
                });
            });
    </script>



	{% endblock %}
