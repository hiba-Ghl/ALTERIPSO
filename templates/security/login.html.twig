{% extends 'index.html.twig' %}
{% block title %}Log in!
{% endblock %}

{% block body %}
  {# offline #}
  <Link rel="stylesheet" href="{{ asset('css/login.css') }}"> 

  {# online #}
  {# <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"> #}

<script src="{{ asset('javascript/all.min.js') }}"></script>  {# online #}
    
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/js/all.min.js"></script>
	
	{% for type, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ type }}">
         	{{ message }}
        </div>
    {% endfor %}
	{% endfor %}

	<br><br>
	<div style="border-radius: 8px;text-align: left;margin-left: 10px;color: white;font-style: oblique;font-size: 20px;background-color: #3087ce;width: 250px;padding-left: 10px;">
		<img style="margin-top: -51px;margin-left: -10px;width: 45px;float: left;" src="{{ asset('images/ler.png') }}">
		CONNECTEZ-VOUS
	</div>
	<br>
	{% if error %}
				<div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
	{% endif %}
	<div id="div1">
		<form method="post" autocomplete="off">
			{% if app.user %}
				<div class="mb-3">
					Vous êtes connecté en tant que
					{{ app.user.userIdentifier }},
					<a href="{{ path('app_logout') }}">Logout</a>
				</div>
			{% endif %}


			<label for="username" style="diaplay:flex">Utilisateur</label>
			<input type="text" name="_username" value="{{last_username}}" id="username" class="form-control"  required >
			<br>
			<label for="password">Mot de passe</label>
			<input type="password" name="_password" id="password" class="form-control" required  autocomplete="new-password">
			<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

			{#
			    Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
			    See https://symfony.com/doc/current/security/remember_me.html
			            <div class="checkbox mb-3">
			                <label>
			                    <input type="checkbox" name="_remember_me"> Remember me
			                </label>
			            </div>
			        #}
					<br>
			<div class="form-group" style="display:flex;justify-content:space-between;">
					{# <input type="checkbox" name="_remember_me" id="remember_me">
					Se souvenir de moi #}
			<div>
    	<a href="#" style="font-size:16px;color: #3087ce" onclick="return redirectOublierMotDePasse()">Mot de passe oublié ?</a>
		</div>
		<script>
		function redirectOublierMotDePasse() {
    		const username = document.getElementById("username");
    		if (username.value.trim() != "") {
        		window.location.href = "/app_forgot_password_request/" + encodeURIComponent(username.value);
    		} else {
        		alert("Entrez votre identifiant, s'il vous plaît !");
   			 }
    		return false;
			}
		</script>

				<button type="submit" class="btn btn-success" style="background-color: #3087ce; border: 2px solid #3087ce;">
					<i class="glyphicon glyphicon-log-in"></i>
					Connexion
				</button>
			</div>




		</form>
	</div>
	{#{ render(controller('App\\Controller\\UserController::createUser')) }#}

