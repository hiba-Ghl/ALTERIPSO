document.addEventListener('click', function (event) {
    const submitButton = event.target.closest('.modalExport');
    if(!submitButton)
      return ;
    const Id = submitButton.getAttribute('data-id');
    let index = -1;
    if (submitButton.getAttribute('data-target')) {
      index = submitButton.getAttribute("data-target").split('-')[1];
    createModal2(Id,index);
    setTimeout(() => $(`#modal3-${Id}`).modal({ backdrop: 'static', keyboard: false }).modal('show'), 100);
    }
})




