</form><script>// Fonction pour afficher ou masquer les blocs en fonction de la valeur des champs date_version et payement_version
function handleVisibility() {
var dateVersionSelect = document.getElementById('date_version');
var payementVersionSelect = document.getElementById('payement_version');
var fDateDiv = document.querySelector('.f_date');
var fPaylineDiv = document.querySelector('.f_payline');
var fStripeDiv = document.querySelector('.f_stripe');

if (dateVersionSelect.value === '2') {
fDateDiv.style.display = 'block';
} else {
fDateDiv.style.display = 'none';
}

if (payementVersionSelect.value === 'payline') {
fPaylineDiv.style.display = 'block';
fStripeDiv.style.display = 'none';
} else if (payementVersionSelect.value === 'stripe') {
fPaylineDiv.style.display = 'none';
fStripeDiv.style.display = 'block';
} else {
fPaylineDiv.style.display = 'none';
fStripeDiv.style.display = 'none';
}
}

// Appel initial de la fonction pour mettre à jour l'affichage en fonction des valeurs initiales
handleVisibility();

// Ajout d'événements de changement pour les sélecteurs date_version et payement_version
document.getElementById('date_version').addEventListener('change', handleVisibility);
document.getElementById('payement_version').addEventListener('change', handleVisibility);
</script>
