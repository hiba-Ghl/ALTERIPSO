{% extends 'home/index.html.twig' %}
{% block body %}
	<style>
		#div1 {
			border-radius: 25px;
			border: 2px solid #3087ce;
			padding: 43px;
			width: 1091px;
			height: 300px;
			margin-left: -70px;
			margin-top: 10px;

		}
		#div2 {
			border-radius: 25px;
			border: 2px solid #3087ce;
			padding: 20px;
			width: 1300px;
			height: 900px;
			margin-left: -70px;
			margin-top: 10px;
			background-color: white;
		}
	</style>

	<p id='p'></p>
	<div style="margin-top: -40px;position: absolute;border-radius: 8px;text-align: left;margin-left: -68px;color: white;font-style: oblique;font-size: 20px;background-color: #3087ce;width: 250px;padding-left: -27px;">
		Liste Catégorie radio
	</div>

	<div id="div2">


		<a href="{{path('app_ajouter_categorieradio')}}" class="btn btn-info btn-sm" name="add" id="add">
			<i class="glyphicon glyphicon-plus"></i>
			Ajouter Catégorie radio</a>


		<table class="table table-striped table-bordered table-hover table-checkable order-column" id="sample_1">
			<thead>

				<tr>
					<th>Titre</th>
					<th>Icon</th>
					<th>Actif</th>
                    <th>Position</th>
					<th>Action</th>


				</tr>
			</thead>

			<tbody>

				{% for catradio in catradios %}


					<tr class="odd gradeX">
						<td>{{catradio.nom}}</td>
						<td>
							<img style="width:50px;height:50px;text-align:center" src="{{ asset(catradio.logo) }}" alt="..." class="img-rounded img-responsive center-block">
						</td>

						<td>{{catradio.Active}}</td>
						<td>{{catradio.position}}</td>


						<td>
							

								<a data-toggle="tooltip" data-placement="top" title="modifier Catégorie radio" href="{{path('app_modifier_categorieradio',{'id':catradio.id})}}" class="btn btn-warning btn-xs">
									<i class="glyphicon glyphicon-pencil"></i>
								</a>
						


								<a data-toggle="tooltip" data-placement="top" title="Supprimer Catégorie radio" href="{{path('app_supprimer_categorieradio',{'id':catradio.id})}}" class="btn btn-danger btn-xs"  onclick="return confirm('Voulez-vous vraiment supprimer la catégorie radio : {{catradio.nom}} ?')">
									<i class="glyphicon glyphicon-trash"></i>
								</a>
							
						

						</td>

					</tr>

					{% endfor %}
			</tbody>
		</table>


	</div>
{% endblock %}
