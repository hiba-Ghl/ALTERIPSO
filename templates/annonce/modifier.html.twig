<!-- Gérer l'affichage et la sélection depuis le bloc d'émoticônes -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const openEmojiBtn = document.getElementById('openEmojiBlock');
        const emojiBlock = document.getElementById('emojiSpecialBlock');
        const textarea = document.getElementById('text');

        if (openEmojiBtn && emojiBlock && textarea) {
            // Ouvrir/Fermer le bloc d'émojis
            openEmojiBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                emojiBlock.style.display = emojiBlock.style.display === 'none' ? 'block' : 'none';
            });

            // Insérer l'émoji et fermer
            emojiBlock.addEventListener('click', function(e) {
                if (e.target.classList.contains('emoji-item')) {
                    const char = e.target.textContent;
                    
                    // Insérer à la position du curseur
                    const startPos = textarea.selectionStart;
                    const endPos = textarea.selectionEnd;
                    textarea.value = textarea.value.substring(0, startPos) + char + textarea.value.substring(endPos, textarea.value.length);
                    
                    textarea.focus();
                    textarea.selectionStart = textarea.selectionEnd = startPos + char.length;
                    
                    // Mettre à jour l'aperçu
                    textarea.dispatchEvent(new Event('input', { bubbles: true }));
                    
                    emojiBlock.style.display = 'none'; // fermer après sélection
                }
            });

            // Fermer si on clique à l'extérieur
            document.addEventListener('click', function(e) {
                if (emojiBlock.style.display === 'block' && !emojiBlock.contains(e.target) && e.target !== openEmojiBtn) {
                    emojiBlock.style.display = 'none';
                }
            });
        }
    });
</script>

