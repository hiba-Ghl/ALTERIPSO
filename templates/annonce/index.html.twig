    if(!arreterbutton)
      return ;
    const Id = arreterbutton.getAttribute('data-id');
    const name = arreterbutton.getAttribute('data-name');

    const response = await fetch(`/annonce/GetAllchambreLancerAnnance/${Id}`);
if (!response.ok) {
    console.error(`HTTP error! Status: ${response.status}`);
    return;
}
    const data = await response.json();
    const active = document.getElementById(`active-${Id}`);
