{% extends 'home/index.html.twig' %}
{% block body %}
<link rel="stylesheet" href="{{ asset('css/css_categRadio.css') }}">

<!-- ajouter categories                                                      -->

<div class="ajouter-banner-title">
    <img class="ajouter-banner-img" src="{{ asset('images/ler.png') }}">
    Ajouter une catégorie radio
</div>

<div id="container-ajouter-categorie">
    <form name="" method="post" action="{{path('app_ajouter_categorieradio')}}" class="form-horizontal" enctype="multipart/form-data">
        <strong>Infos
        </strong>

        <div class="form-group">
            <label  class="col-lg-2 control-label">Nom
            </label>
            <div class="col-lg-10">
                <input type="text" id="nom" name="nom" class="form-control"/>
            </div>
        </div>       
		<div class="form-group">
				<label  class="col-lg-2 control-label">Active</label>
				<div class="col-lg-10">

					<select id="active" name="active" class="form-control">
						<option value="0">0</option>
						<option value="1">1</option>
					</select>

				</div>
			</div>
        <div class="form-group">
            <label  class="col-lg-2 control-label">Position</label>
            <div class="col-lg-10">
                <input type="number" id="position" name="position" class="form-control"/>
            </div>
        </div>
        <div class="form-group ajouter-form-flex">
            <label for="logo" class="col-lg-2 control-label">Logo </label>
            <div class="col-lg-10">
           <input type="file" class="form-control" id="logo_input" name="logo" required> 
           </div>
        </div>
        <div class="ajouter-langues-section">
            <!-- le boutons des langues --> 
            <label class="accordion-toggle ajouter-langue-label" data-toggle="collapse" data-parent="#accordion" href="#collapseTwo">Langues</label>
            <!-- le bouton de traduction -->
            <button type="button" id="translateBtn" class="btn btn-info btn-sm">
                <i class="glyphicon glyphicon-globe"></i> Traduire le texte
            </button>
            <a type="button" class="accordion-toggle" data-toggle="collapse" data-parent="#accordion" href="#collapseTwo">
                <span><i class="glyphicon glyphicon-plus"></i></span>
            </a>
            <!-- les champs des langues -->
            <div id="collapseTwo" class="panel-collapse collapse">
                <div class="panel-body">
                    <div id="inputGroup1">
                        <div class="form-row ajouter-langue-row">
                            <div class="form-group col-md-6">
                                <img class="ajouter-langue-img" src="{{ asset('images/eng.png') }}">
                                <label for="EN">English</label>
                                <input type="text" class="form-control" id="EN" name="EN">
                            </div>
                            <div class="form-group col-md-6">
                                <img class="ajouter-langue-img" src="{{ asset('images/es.png') }}">
                                <label for="ES">Espagnol</label>
                                <input type="text" class="form-control" id="ES" name="ES">
                            </div>
                        </div>
                        <div class="form-row ajouter-langue-row">
                            <div class="form-group col-md-6">
                                <img class="ajouter-langue-img" src="{{ asset('images/pt.png') }}">
                                <label for="PT">Portugues</label>
                                <input type="text" class="form-control" id="PT" name="PT">
                            </div>
                            <div class="form-group col-md-6">
                                <img class="ajouter-langue-img" src="{{ asset('images/ita.png') }}">
                                <label for="IT">Italiano</label>
                                <input type="text" class="form-control" id="IT" name="IT">
                            </div>
                        </div>
                        <div class="form-row ajouter-langue-row">
                            <div class="form-group col-md-6">
                                <img class="ajouter-langue-img" src="{{ asset('images/rus.png') }}">
                                <label for="RU">Russian</label>
                                <input type="text" class="form-control" id="RU" name="RU">
                            </div>
                            <div class="form-group col-md-6">
                                <img class="ajouter-langue-img" src="{{ asset('images/deu.png') }}">
                                <label for="DE">Deutsch</label>
                                <input type="text" class="form-control" id="DE" name="DE">
                            </div>
                        </div>
                        <div class="form-row ajouter-langue-row">
                            <div class="form-group col-md-6">
                                <img class="ajouter-langue-img" src="{{ asset('images/ch.png') }}">
                                <label for="ZH">China</label>
                                <input type="text" class="form-control" id="ZH" name="ZH">
                            </div>
                            <div class="form-group col-md-6">
                                <img class="ajouter-langue-img" src="{{ asset('images/ma.png') }}">
                                <label for="AR">العربية</label>
                                <input type="text" class="form-control" id="AR" name="AR">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>         
            <div class="ajouter-actions-btns">
            <a class="btn btn-danger btn-md ajouter-btn-annuler" id = "annulerButton" href="/categorieradio">
                <i class="glyphicon glyphicon-remove"></i> Annuler
            </a>
            <button type="submit" class="btn btn-primary btn-md" name="valider" >
                <i class="glyphicon glyphicon-floppy-disk"></i>
                Enregistrer
            </button>
    </div>
        </form>

</div>
 <script>
      const configApp = {{configApp | raw}}
document.addEventListener('DOMContentLoaded', function () {
	const traduireButton = document.getElementById('translateBtn');
	 const languageInputs = {
            en: document.getElementById("EN"),
            es: document.getElementById("ES"),
            pt: document.getElementById("PT"),
            it: document.getElementById("IT"),
            ru: document.getElementById("RU"),
            de: document.getElementById("DE"),
            zh: document.getElementById("ZH"),
            ar: document.getElementById("AR"),
        };
        let translations = {};
        async function translateAll(text) {
            const languages = Object.keys(languageInputs);
            let results = [];
             while(1)
             {
                results = await translate(text, languages, 'fr');
                if(results)
                    break;
             }
            languages.forEach((lang, index) => {
                translations[lang] = results[index];
            });
        }
        if (traduireButton) {
            traduireButton.addEventListener('click', async(event) => {
                const textInput = document.getElementById("nom");
                const text = textInput.value.trim() ;
                if (text === '') {
                    alert("Veuillez entrer un texte à traduire.");
                    return;
                }
                if(configApp.Status === 'Offline')
                {
                    alert("Aucun internet disponible : vous pouvez faire la traduction manuellement");
                    return ;
                }
                await translateAll(text);
                Object.keys(languageInputs).forEach(lang => {
                    if (translations[lang]) {
                        languageInputs[lang].value = translations[lang];
                    }
                });
            });
        }
});

</script>
{% endblock %}