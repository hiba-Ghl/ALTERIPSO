{% extends 'home/index.html.twig' %}
{% block body %}

<link rel="stylesheet" href="{{ asset('css/css_categories.css') }}" />

<!-- ajouter categories                                                      -->

<div class="category-title-container">
    <img class="category-title-img" src="{{ asset('images/ler.png') }}">
    Modifier  {{categorie.nom}}
</div>

<div class="category-form-container">

   
    <form name="" method="post" action="{{ path('modifiercategories', {'id': categorie.id}) }}" class="form-horizontal" enctype="multipart/form-data">

            <strong>Infos</strong>
            <div class="form-group">
                <label for="nom" class="col-lg-2 control-label">Nom
                </label>
                <div class="col-lg-10">
    
                    <input type="text" id="nom" name="nom" class="form-control" value="{{categorie.nom}}"/>
    
                </div>
            </div>
    
            <div class="form-group">
                <label for="titre" class="col-lg-2 control-label">Titre</label>
                <div class="col-lg-10">
    
                    <input type="text" id="titre" name="titre" class="form-control" value="{{categorie.titre}}" />
    
                </div>
            </div>
    
            
            <div class="form-group">
                    <label for="active" class="col-lg-2 control-label">Active</label>
                    <div class="col-lg-10">
    
                        <select id="active" name="active" class="form-control">
                            {% if (categorie.active == 0)  %}
                            <option value="0">0</option>
                            <option value="1">1</option>
                            {% else  %}
                            <option value="1">1</option>
                            <option value="0">0</option>
                            {% endif %}
                        </select>
    
                    </div>
                </div>
    
            <div class="form-group">
                <label for="position" class="col-lg-2 control-label">Position</label>
                <div class="col-lg-10">
                    <input type="number" id="position" name="position" class="form-control" value="{{categorie.position}}"  readonly/>
                </div>
            </div>
    
            <div class="form-group">
                <label for="html" class="col-lg-2 control-label">Html</label>
                <div class="col-lg-10">
    
                    <input type="text" id="html" name="html" class="form-control" value="{{categorie.html}}"/>
    
                </div>
            </div>
    
            <div class="form-group">
                <label for="package" class="col-lg-2 control-label">Package</label>
                <div class="col-lg-10">
    
                    <input type="text" id="package" name="package" class="form-control" value="{{categorie.package}}"/>
    
                </div>
            </div>

             <div class="form-group">
                    <label for="typemenu" class="col-lg-2 control-label">Active</label>
                    <div class="col-lg-10">
    
                        <select id="typemenu" name="typemenu" class="form-control">
                            {% if (categorie.typemenu == 'gauche')  %}
                            <option value="gauche">Gauche</option>
                            <option value="centre">Centre</option>
                            {% else  %}
                            <option value="centre">Centre</option>
                            <option value="gauche">Gauche</option>
                            {% endif %}
                        </select>
    
                    </div>
                </div>
    
            <br>
            <strong>Média</strong>
    
            <div class="category-media-wrapper">
                <div class="category-media-item">
                    <label for="logo" class="control-label">logo</label>
                    <img src="{{ path('afficher_image', { filename: categorie.logo|split('/')|last, directory: 'categories_directory' }) }}" class="category-img"/>
                    <input type="file" class="form-control-file" id="logo" name="logo">
                </div>
                
                <div class="category-media-item">
                    <label for="background" class="control-label">background</label>
                    <img src="{{ categorie.background ? path('afficher_image', { filename: categorie.background|split('/')|last, directory: 'categories_directory' }) : asset('images/no_image.png') }}" class="category-img"/>
                    <input type="file" class="form-control-file" id="background" name="background">
                </div>
            </div>

            <label style="margin-right: 20px; margin-top: 20px;" class="accordion-toggle" data-toggle="collapse" data-parent="#accordion" href="#collapseTwo">Langues</label>
            <!-- le bouton de traduction -->
            <button type="button" id="translateBtn" class="btn btn-info btn-sm">
                <i class="glyphicon glyphicon-globe"></i> Traduire le texte
            </button>
            <a type="button" class="accordion-toggle" data-toggle="collapse" data-parent="#accordion" href="#collapseTwo">
                <span><i class="glyphicon glyphicon-plus"></i></span>
            </a>
        <script>
            $(document).ready(function(){
                $('.accordion-toggle').click(function(){
                    $(this).find('i').toggleClass('glyphicon-plus glyphicon-minus');
                });
            });
        </script>
        <div id="collapseTwo" class="panel-collapse collapse">
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-6 col-sm-12">
                        <div class="language-item">
                            <img src="{{asset('images/eng.png')}}">
                            <label class="control-label" for="EN">English</label>
                            <input type="text" id="EN" name="EN" class="form-control" value="{{categorie.en}}">
                        </div>
                        <div class="language-item">
                            <img src="{{asset('images/pt.png')}}">
                            <label class="control-label" for="PT">Portugues</label>
                            <input type="text" id="PT" name="PT" class="form-control" value="{{categorie.pt}}">
                        </div>
                        <div class="language-item">
                            <img src="{{asset('images/rus.png')}}">
                            <label class="control-label" for="RU">Russian</label>
                            <input type="text" id="RU" name="RU" class="form-control" value="{{categorie.ru}}">
                        </div>
                        <div class="language-item">
                            <img src="{{asset('images/ch.png')}}">
                            <label class="control-label" for="ZH">China</label>
                            <input type="text" id="ZH" name="ZH" class="form-control" value="{{categorie.zh}}">
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-12">
                        <div class="language-item">
                            <img src="{{asset('images/es.png')}}">
                            <label class="control-label" for="ES">Espagnol</label>
                            <input type="text" id="ES" name="ES" class="form-control" value="{{categorie.es}}">
                        </div>
                        <div class="language-item">
                            <img src="{{asset('images/ita.png')}}">
                            <label class="control-label" for="IT">Italiano</label>
                            <input type="text" id="IT" name="IT" class="form-control" value="{{categorie.it}}">
                        </div>
                        <div class="language-item">
                            <img src="{{asset('images/deu.png')}}">
                            <label class="control-label" for="DE">Deutsch</label>
                            <input type="text" id="DE" name="DE" class="form-control" value="{{categorie.de}}">
                        </div>
                        <div class="language-item">
                            <img src="{{asset('images/ma.png')}}">
                            <label class="control-label" for="AR">العربية</label>
                            <input type="text" id="AR" name="AR" class="form-control" value="{{categorie.ar}}">
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
       <div class="category-action-buttons">
            <a class="btn btn-danger btn-md" id="annulerButton" style="width:130px;" href="/home">
                <i class="glyphicon glyphicon-remove"></i> Annuler
            </a>
             <button type="submit" class="btn btn-primary btn-md" style="width:130px;">
                <i class="glyphicon glyphicon-floppy-disk"></i> Enregistrer
            </button>
        </div>
        </form>
</div>
<br> <br> <br> <br>

    
