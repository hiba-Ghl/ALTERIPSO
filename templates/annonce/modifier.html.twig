                    <option value="">Choisir un type</option>
                    <option value="Image" {% if ann.type == 'Image' %}selected {% endif %}>Image</option>
                    <option value="Video" {% if ann.type == 'Video' %}selected {% endif %}>Video</option>
                    <option value="PDF" {% if ann.type == 'PDF' %}selected {% endif %}>PDF</option>
                    <option value="Message" {% if ann.type == 'Message' %}selected {% endif %}>Message</option>
                    <option value="Message défilant" {% if ann.type == 'Message défilant' %}selected {% endif %}>Message défilant</option>
                    <option value="Localtv" {% if ann.type == 'Localtv' %}selected {% endif %}>Localtv</option>
                </select>

                <!-- localtv ip adress section -->
                <div id="ipAddress" style="display: none;">
                    <label for="text" class="control-label">Entrer une adresse IP :</label>
                    <input type="text" class="form-control" name="ip" id="ip" {% if ann.type == 'localtv' %} value="{{ann.url}}"{% endif %} 
                        pattern="^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$"
                        title="Veuillez entrer une adresse IP valide (par exemple, 192.168.1.1)" >
