{% extends 'home/index.html.twig' %}

{% block body %}
<link rel="stylesheet" href="{{ asset('css/css_categVod.css') }}">

<!-- Gestion des flash messages -->
{% for message in app.flashes('error') %}
<div class="alert alert-danger" role="alert" >
    {{ message }}   
    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
    <span aria-hidden="true">&times;</span>
    </button>
</div>
{% endfor %}

<div class="cv-header-title">
    <img class="cv-header-icon" src="{{ asset('images/ler.png') }}">
    Liste Catégorie VOD
</div>


    <form name="form" action="{{ path('app_update_active_categorie_vod')}}" method="post" enctype="multipart/form-data">
      <div id="div2">
        <div class="cv-actions-row">
            <div>
                <a {% if app.user.AjoutCatVod == '0' %} disabled {% endif %} href="{{ path('app_ajouter_categorievod') }}" class="btn btn-info btn-sm cv-btn-add" name="add" id="add">
                    <i class="glyphicon glyphicon-plus"></i>
                    Ajouter Catégorie VOD
                </a>
                <button {% if app.user.SauvegarderCatVod == '0' %} disabled {% endif %} type="submit"  name="valider" class="btn btn-success btn-sm cv-btn-save">
                    <i class="glyphicon glyphicon-floppy-disk"></i>
                    Sauvegarder
                </button>

                <a name="annuler" href="{{ path('app_categorie_vod') }}" class="btn btn-danger btn-sm cv-btn-cancel">
                    <i class="glyphicon glyphicon-remove"></i>
                    Annuler
                </a>
            </div>
            <input id="myInput3" type="text" placeholder="Search.." class="tv-search-input">
        </div>

        <div class="table-container">
        <table class="table table-striped table-bordered cv-table-fixed table-hover cv-table-main" id="dataTables-example">
            <thead>
                <tr>
                    <th class="cv-th-name">Nom</th>
                    <th class="cv-th-logo">Logo</th>
                    <th class="cv-th-active">
                     <p class="cv-flex-center-gap10">
                        <span>Active</span>
                        <input type="checkbox" id="checklist" class="cv-checkbox-margin">
                     </p>
                    </th>
                    <th class="cv-th-position">Position</th>
                    <th class="cv-th-actions">Actions </th>
                </tr>
            </thead>


            <tbody>
                {% for catvod in categorie_v_o_ds %}
                    <tr class="odd gradeX">
                        <td class="cv-td-name" data-label="Nom">{{ catvod.nom|capitalize}}</td>
                        <td class="cv-td-logo" data-label="Logo">
                            <img src="{{ path('afficher_image', { filename: catvod.logo|split('/')|last, directory: 'categorie_vod_directory' }) }}" alt="..." class="img-rounded img-responsive center-block cv-logo-img">
                        </td>
                        <!-- checkbox -->
                        {% set ch = '' %}
                        {% if catvod.active == 1 %}
                            {% set ch = 'checked' %}
                        {% endif %}
                        <td class="cv-td-active" data-label="Active">
                            <label><input {% if app.user.SauvegarderCatVod == '0' %} disabled {% endif %} name="listeactive[{{ catvod.id }}]" type="checkbox" {{ ch }} class="jpCheckbox"></label>
                        </td>
                        <td class="cv-td-position" data-label="Position">{{ catvod.position }}</td>
                        <td class="cv-td-actions" data-label="Actions">
                            <a {% if app.user.ModifierCatVod == '0' %} disabled {% endif %} data-toggle="tooltip" data-placement="top" title="Modifier Catégorie VOD" href="{{ path('app_modifier_categorievod', { 'id': catvod.id }) }}" class="btn btn-warning btn-xs">
                                <i class="glyphicon glyphicon-pencil"></i>
                            </a>
                            <a {% if app.user.SuppCatVod == '0' %} disabled {% endif %} data-toggle="tooltip" data-placement="top" title="Supprimer Catégorie VOD" href="{{ path('app_supprimer_categorievod', { 'id': catvod.id }) }}" class="btn btn-danger btn-xs" onclick="return confirm('Voulez-vous vraiment supprimer la catégorie VOD : {{ catvod.nom }} ?')">
                                <i class="glyphicon glyphicon-trash"></i>
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5">No records found</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
       </div>  
    </form>



<!-- Script pour cocher ou décocher toutes les cases à cocher -->
<script>
    document.getElementById('checklist').addEventListener('click', function() {
        var checkboxes = document.querySelectorAll('input.jpCheckbox');
        for (var checkbox of checkboxes) {
            checkbox.checked = this.checked;
        }
    });

</script>
<script>
    $(document).ready(function(){
        // Initialize tooltips for all buttons
        $('[data-toggle="tooltip"]').tooltip();
    });
</script>



{% endblock %}
