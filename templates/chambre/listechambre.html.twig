<script>
$(document).ready(function(){
  //recherche 
  $("#myInput").bind("input propertychange", function() {
    var value = $(this).val().toLowerCase();
    $("#myTable tr").filter(function() {
      $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
    });
  });

  //affiche le modal de confirmation
  $(function () {
    $('.conf').click(function(){
      $(".confmodal").hide();
      if($(".boxcheck:checked").length==0){
        $("#checkedmodal").html("<b>Veuillez choisir au moins une sélection.</b><br/><br/>");
      }else{
          $("#"+$(this).attr("data-modal-id")).show();
          $("#checkedmodal").html("<b>Vous allez envoyer une mise à jour aux "+$(".boxcheck:checked").length+" TVs suivantes :</b><br/><br/>");
          //$(".boxcheck:visible").each(function() {
            $(".boxcheck").each(function() {
            if($(this).is(':checked')){
              var contenu = $(this).attr("data-BoxId")+"<input name='"+$(this).attr("name")+"' type='hidden' value='"+$(this).attr("name")+"'><br/>";
              console.log(contenu);
              $("#checkedmodal").append(contenu);
            }
         });
         $("#checkedmodal").append("<br/><b>Confirmer?</b>");
      }
       $('#ConfirmModal').modal('show');
          //  $.toast('<i class="glyphicon glyphicon-fire"></i> Update is running oléééééé 666666', {'align': 'top','type': 'success'});
  
    });
});




});

</script>

<script type="text/javascript">
  // recherhe par service
function getval(sel)
{
   // alert(sel.value);
     $('#myInput').val(sel.value);
     $("#myTable tr").filter(function() {
      $(this).toggle($(this).text().toLowerCase().indexOf(sel.value.toLowerCase()) > -1)
    });
}
</script>
<!-- premier modal-->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
  <div class="modal-dialog modal-sm" role="document">
    <form enctype="multipart/form-data">
      <div class="modal-content" style="width: 660px;">
        <div class="modal-header" >
          <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
          <h4 class="modal-title" id="myModalLabel">Liste Support connecté à choisir</h4>
          <br><br>
              <label style="color: blue;font-size: 15px;"> Recherche par service : &nbsp;&nbsp;&nbsp; </label>
              <select style="width: 400px;margin-top: -39px;margin-left: 175px;" onchange="getval(this);"  name="selectservices" class="form-control">
                  <option  selected value="">Tous les services</option>
                  {% for s in serviceetablissement %}
                  <option   value="{{s.nom}}">{{s.nom|upper}}</option>
                  {% endfor %}
              </select>
              <br>
              <label style="color: blue;font-size: 15px;"> Recherche du support : &nbsp;&nbsp;&nbsp; </label>
              <input id="myInput" type="text" placeholder="Search.." style="width: 400px;margin-top: -39px;margin-left: 175px;" class="form-control">
                
          <div style="height:500px;overflow-y: scroll;">
          <br><br>
            <!--<table class="table table-striped table-bordered table-hover" id="dataTables-example">-->
              <table id="example20" class="table table-striped table-bordered table-hover">
              <thead>
                <tr>
                  <th> <input  type="checkbox"  id="checkAllboxn" >   Sélectionner</th>
                  <th>   Chambre</th>
                  <th>   IP</th>
                  <th>   Service</th>
                </tr>
              </thead>
              <tbody id="myTable">
              {% for box in chambres %}
              <tr>
                <td> <label class="labelbox" ><input data-BoxId='{{box.etage}}' class='boxcheck' name='box[{{box.Id}}]' type="checkbox"> {{box.BoxId}}</label></td>
                <td>  {{box.etage}}</td>
                <td>  {{box.ip}}</td>
                <td>{{box.service.nom|capitalize}}</td>
              <tr>
              {% endfor%}
              </tbody>
            </table>
          </div>
        </div>     
        <div class="modal-footer">
          <button id='btn6' data-modal-id="mcontenu" type="button" class="btn btn-primary conf "  name="contenu" <a   data-toggle="tooltip" data-placement="top" title=" Mise à jour générale"></a> Mise à jour contenu</button> 
          <button id='btn7' data-modal-id="mtheme" type="button" class="btn btn-success conf" name="theme"  <a   data-toggle="tooltip" data-placement="top" title=" Mettre à jour les positions des catégories"></a> Mise à jour thème</button> 
          <button id='btn8' data-modal-id="mservice" type="button" class="btn btn-danger conf" name="servi"  <a   data-toggle="tooltip" data-placement="top" title=" Mettre à jour tous les icones Services"></a> Mise à jour service</button>
          <button type="button" class="btn btn-default" data-dismiss="modal">Fermer</button>
        </div>
      </div>
    </form>
  </div>
</div>


<!-- Modal d'envoie -->
<div id="ConfirmModal" class="modal fade" role="dialog" style="padding-right: 25px;margin-left: 343px;margin-top: 32px;">
  <div class="modal-dialog" >

    <!-- Modal content-->
    <div class="modal-content">
      <form action="{{ path('home')}}" name="form" method="post">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">×</button>
        <h4 class="modal-title">Confirmation </h4>
      </div>
   
         <div id="checkedmodal" style="height:500px;overflow-y: scroll;" class="modal-body">
           
          </div>
      <div class="modal-footer">
        <button id="mcontenu" type="submit" name="contenu" class="confmodal btn btn-primary"> Confirmer</button>
        <button id="mtheme"  type="submit" name="theme" class="confmodal btn btn-primary"> Confirmer</button>
        <button id="mservice"  type="submit" name="servi" class="confmodal btn btn-primary"> Confirmer</button>   
        <button type="button" class="btn btn-danger" data-dismiss="modal">Annuler</button>
      </div>
      </form>
    </div>

  </div>
</div>






  
