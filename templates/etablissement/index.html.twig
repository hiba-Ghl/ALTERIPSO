
{% extends 'home/index.html.twig' %}
{% block body %}

<head>
	<link rel="stylesheet" href="{{ asset('css/css_etablissement.css') }}">
</head>
	<!--                                                      -->
	<div class="etab-header">
    <img class="etab-header-logo" src="{{ asset('images/ler.png') }}">
		Infos Etablissement
	</div>
	<div id="div4" class="etab-container">
		<!--  -->
		<form name="" method="post" action="{{ path('modifieretablissement', {'id': app.user.etablissement.id}) }}" class="form-horizontal" enctype="multipart/form-data">


			<br>
			<!-- nom d'etablissement -->
			<div class="form-group">
				<label for="nom_etablissement" class="col-lg-2 control-label">
					<p class="etab-label-text">
						Nom d'établissement
					</p>
				</label>
				<div class="col-lg-10">
					<input type="text" id="nom_etablissement" name="nom_etablissement" class="form-control" value="{{app.user.etablissement.nometablissement}}"/>
				</div>
			</div>
			<!-- description d'etablissement  -->

			<div class="form-group">
				<label for="description" class="col-lg-2 control-label">
					<p class="etab-label-text">
						Type d'Etablissement
					</p>
				</label>
				<div class="col-lg-10">
					<label class="radio-inline">
						<input type="radio" name="description" id="description" value="Hôtel" checked>Hôtel</label>
					<label class="radio-inline">
						<input type="radio" name="description" id="description" value="hopital" {% if app.user.etablissement.description == 'hopital' %} checked {% endif %}>Hopital</label>
					<label class="radio-inline">
						<input type="radio" name="description" id="description" value="ehpad" {% if app.user.etablissement.description == 'ehpad' %} checked {% endif %}>Ehpad</label>
					<label class="radio-inline">
						<input type="radio" name="description" id="description" value="camping" {% if app.user.etablissement.description == 'camping' %} checked {% endif %}>Camping</label>
					<label class="radio-inline">
						<input type="radio" name="description" id="description" value="autres" {% if app.user.etablissement.description == 'autres' %} checked {% endif %}>Autres</label>
				</div>
			</div>
			<br>
			<!-- le genre  -->
			<div class="form-group">
				<label for="genre" class="col-lg-2 control-label">
					<p class="etab-label-text">
						Genre
					</p>
				</label>
				<div class="col-lg-10">

					<select id="genre" name="genre" class="form-control">
						<option value="Monsieur" {% if app.user.etablissement.genre == 'Monsieur' %} selected {% endif %}>Monsieur</option>
						<option value="Madame" {% if app.user.etablissement.genre == 'Madame' %} selected {% endif %}>Madame</option>
						<option value="Aucun" {% if app.user.etablissement.genre == 'Aucun' %} selected {% endif %}>Aucun</option>

					</select>
				</div>
			</div>

			<!-- nom   -->
			<div class="form-group">
				<label for="nom" class="col-lg-2 control-label">
					<p class="etab-label-text">
						Nom
					</p>
				</label>
				<div class="col-lg-10">
					<input type="text" id="nom" name="nom" class="form-control" value="{{ app.user.etablissement.nom}}"/>
				</div>
			</div>
			<!-- prenom  -->
			<div class="form-group">
				<label for="prenom" class="col-lg-2 control-label">
					<p class="etab-label-text">
						Prenom
					</p>
				</label>
				<div class="col-lg-10">

					<input type="text" id="prenom" name="prenom" class="form-control" value="{{ app.user.etablissement.prenom}}"/>

				</div>
			</div>
			<!-- pays  -->
			<div class="form-group">
				<label for="pays" class="col-lg-2 control-label">
					<p class="etab-label-text">
						Pays
					</p>
				</label>
				<div class="col-lg-10">

					<input type="text" id="pays" name="pays" class="form-control" value="{{app.user.etablissement.pays}}"/>

				</div>
			</div>
			<!-- ville  -->
			<div class="form-group">
				<label for="ville" class="col-lg-2 control-label">
					<p class="etab-label-text">
						Ville
					</p>
				</label>
				<div class="col-lg-10">

					<input type="text" id="ville" name="ville" class="form-control" value="{{ app.user.etablissement.ville}}"/>
  <ul id="ville-options" class="list-group mt-2 etab-ville-options"></ul> <!-- List for options -->
				</div>
			</div>
			
			<!-- addresse  -->
			<div class="form-group">
				<label for="adresse" class="col-lg-2 control-label">
					<p class="etab-label-text">
						Adresse
					</p>
				</label>
				<div class="col-lg-10">

					<input type="text" id="adresse" name="adresse" class="form-control" value="{{ app.user.etablissement.adresse}}"/>

				</div>
			</div>
			<!-- nombres de chambres  -->
			<div class="form-group">
				<label for="licence" class="col-lg-2 control-label">
					<p class="etab-label-text">
						Nombre de chambres
					</p>
				</label>
				<div class="col-lg-10">
					<input type="number" id="nbr_chambres" name="licence" class="form-control" value="{{ app.user.etablissement.licence}}"/>
				</div>
			</div>
			<!-- etat du logo   -->
			<div class="form-group">
				<label for="logoactive" class="col-lg-2 control-label">
					<p class="etab-label-text">
						Logo
					</p>
				</label>
				<div class="col-lg-10">

					<select id="logoactive" name="logoactive" class="form-control">
						{% if (app.user.etablissement.logoactive == 0)  %}
							<option value="0">Non actif</option>
							<option value="1">Actif</option>
						{% else  %}
							<option value="1">Actif</option>
							<option value="0">Non actif</option>
						{% endif %}
					</select>
				</div>
			</div>

			<!-- file du talechargement du logo  -->

			<div class="form-group">
				<label for="logo" class="col-lg-2 control-label">
					<p class="etab-label-text">
						Téléchargement logo
					</p>
				</label>
				<div class="col-lg-10">
					<input type="file" class="form-control" id="logo" name="logo" value="{{ app.user.etablissement.logo }}" accept =".jpg , .peg , .png">
				</div>
			</div>
			<!--- logo -->
			<div class="form-group">
				<label for="logo" class="col-lg-2 control-label"></label>
				{% if app.user.etablissement.logo is not null %}
					<img  src="{{ path('afficher_image', { filename: app.user.etablissement.logo|split('/')|last, directory: 'etablissement_directory' }) }}" class="img etab-logo-img"/>
				{% else %}
					<p>Aucun logo n'a été téléchargé.</p>
				{% endif %}
			</div>
			<!-- espace -->

			<div class="form-group">
				<div class="col-lg-10">
					   <h4 class="etab-section-title">Paramétrage des messages sur ECRAN TV </h4>
		   </div>
			</div>	
			
			<!-- fin espace -->
			<!-- message de bienvenue  -->

			<div class="form-group">
				<label for="msgbienvenu" class="col-lg-2 control-label">
					<p class="etab-label-text">
						Message bienvenue
					</p>
				</label>
				<div class="col-lg-10">

					<select id="msgbienvenu" name="msgbienvenu" class="form-control">

						{% if app.user.etablissement.msgbienvenu == 0 %}
							<option value="0">Nom/Prenom + Date de fin</option>
							<option value="1">Nom/Prenom</option>
							<option value="2">Date de fin</option>
							<option value="3">Aucun Message</option>
						{% elseif app.user.etablissement.msgbienvenu == 1 %}
							<option value="1">Nom/Prenom</option>
							<option value="0">Nom/Prenom + Date de fin</option>
							<option value="2">Date de fin</option>
							<option value="3">Aucun Message</option>
						{% elseif app.user.etablissement.msgbienvenu == 2 %}
							<option value="2">Date de fin</option>
							<option value="0">Nom/Prenom + Date de fin</option>
							<option value="1">Nom/Prenom</option>
							<option value="3">Aucun Message</option>
						{% else %}
							<option value="3">Aucun Message</option>
							<option value="0">Nom/Prenom + Date de fin</option>
							<option value="1">Nom/Prenom</option>
							<option value="2">Date de fin</option>
						{% endif %}

					</select>
				</div>
			</div>
			<!-- message ap  -->
			<div class="form-group">
				<label for="msgap" class="col-lg-2 control-label">
					<p class="etab-label-text">
						Message AP
					</p>
				</label>
				<div class="col-lg-10">

					<select id="msgap" name="msgap" class="form-control">
						{% if (app.user.etablissement.msgap == 0)  %}
							<option value="0">Non actif</option>
							<option value="1">Actif</option>
						{% else  %}
							<option value="1">Actif</option>
							<option value="0">Non actif</option>
						{% endif %}
					</select>
				</div>
			</div>

			<!-- message internet  -->
			<div class="form-group">
				<label for="accessTvInCheckout" class="col-lg-2 control-label">
					<p class="etab-label-text">
						Message internet
					</p>
				</label>
				<div class="col-lg-10">
					<select id="accessTvInCheckout" name="accessTvInCheckout" class="form-control">
						{% if (app.user.etablissement.accessTvInCheckout == 0)  %}
							<option value="0">Non actif</option>
							<option value="1">Actif</option>
						{% else  %}
							<option value="1">Actif</option>
							<option value="0">Non actif</option>
						{% endif %}
					</select>
				</div>
			</div>

	<div class="form-group">
		<div class="col-lg-10">
			<h4 class="etab-section-title">Mise en forme page principale TV</h4>
		</div>
	</div>	
	<div class="form-group">
		<label for="type_text" class="col-lg-2 control-label">
			<p class="etab-label-text">
				Type d’écriture
			</p>
		</label>
		<div class="col-lg-10">
			<select id="type_text" name="type_text" class="form-control" value="{{app.user.etablissement.Typetext}}">
					<option value="Times New Roman, serif" selected>Times New Roman, serif</option>
					<option value="Arial, sans-serif" {% if app.user.etablissement.Typetext == 'Arial, sans-serif' %} selected{% endif %}>Arial, sans-serif</option>
					<option value="Georgia,serif" {% if app.user.etablissement.Typetext == 'Georgia,serif' %} selected{% endif %}>Georgia,serif</option>
					<option value="Courier New, monospace" {% if app.user.etablissement.Typetext == 'Courier New, monospace' %} selected{% endif %}>Courier New, monospace </option>
					<option value="Verdana, sans-serif " {% if app.user.etablissement.Typetext == 'Verdana, sans-serif' %} selected{% endif %}>Verdana, sans-serif </option>
					<option value="Tahoma, sans-serif" {% if app.user.etablissement.Typetext == 'Tahoma, sans-serif' %} selected{% endif %}>Tahoma, sans-serif </option>
					<option value="Trebuchet MS, sans-serif" {% if app.user.etablissement.Typetext == 'Trebuchet MS, sans-serif' %} selected{% endif %}>Trebuchet MS, sans-serif </option>
					<option value="Lucida Console, monospace" {% if app.user.etablissement.Typetext == 'Lucida Console, monospace' %} selected{% endif %}>Lucida Console, monospace </option>
					<option value="Helvetica, sans-serif" {% if app.user.etablissement.Typetext == 'Helvetica, sans-serif' %} selected{% endif %}>Helvetica, sans-serif </option>
					<option value="Comic Sans MS, cursive" {% if app.user.etablissement.Typetext == 'Comic Sans MS, cursive' %} selected{% endif %}>Comic Sans MS, cursive </option>
			</select>
		</div>
	</div>
	<div class="form-group">
	  <label for="colorPicker" class="col-lg-2 control-label">
			<p class="etab-label-text">
				Couleur du texte (catégorie)
			</p>
	  </label>
	  <div class="col-lg-10 etab-color-row">
		<input type="color" id="colorPicker" value="{{app.user.etablissement.Couleurtext}}" class="etab-color-picker"/>
		<input type="text" id="colorCode" name="color_text" class="form-control etab-color-code" value={{app.user.etablissement.Couleurtext}}></span>
	  </div>
	</div>

<script>
  const picker = document.getElementById('colorPicker');
  const colorCode = document.getElementById('colorCode');
  picker.addEventListener('input', () => {
    colorCode.value = picker.value;
  });
   colorCode.addEventListener('input', () => {
     picker.value = colorCode.value;
  });
</script>
	<div class="form-group">
		<label for="type_text" class="col-lg-2 control-label">
			<p class="etab-label-text">
				Taille du texte (catégorie)
			</p>
		</label>
		<div class="col-lg-10">
			<select id="taille_text" name="taille_text" class="form-control" value="{{app.user.etablissement.Tailletext}}">
			</select>
		</div>
	</div>
	<script>
		const taille_text= document.getElementById('taille_text');
		const array = Array.from({ length: 65 }, (_, i) => i + 16);
		  const selectedValue = taille_text.getAttribute("value");
		array.forEach(value=>{
			const option = document.createElement("option");
			option.value = value;
			option.textContent = value;
			if(value == selectedValue)
			{
				option.selected = true;
			}
			taille_text.appendChild(option);
		})
	</script>
	<div class="form-group">
		<label for="volume_demarage" class="col-lg-2 control-label">
			<p class="etab-label-text">
				Volume au démarrage
			</p>
		</label>
		<div class="col-lg-10">
			<select id="volume_demarage" name="volume_demarage" class="form-control" value="{{app.user.etablissement.Volumedemarage}}">
			</select>
		</div>
	</div>
	<script>
		const volume_demarage= document.getElementById('volume_demarage');
		const array1 = Array.from({ length: 61 }, (_, i) => i);
		const selectedValue1 = volume_demarage.getAttribute("value");
		array1.forEach(value=>{
			const option = document.createElement("option");
			option.value = value;
			option.textContent = value;
			if(value == selectedValue1)
			{
				option.selected = true;
			}
			volume_demarage.appendChild(option);
		})
	</script>
	<div class="etab-buttons-wrapper">
    <a class="btn btn-danger btn-md etab-btn" id = "annulerButton" href="/home">
		<i class="glyphicon glyphicon-remove"></i> Annuler
	</a>
<button type="submit" class="btn btn-primary btn-md etab-btn" {% if not is_granted('ROLE_ADMIN') and not is_granted('ROLE_SUPER_ADMIN')%} disabled {% endif %}>
		<i class="glyphicon glyphicon-floppy-disk"></i> Enregistrer
	</button>
</div>
		</form>

	</div>
	<br>

	<script>
  document.addEventListener('DOMContentLoaded', function () {
    const input1 = document.getElementById('ville');
    const optionsList = document.getElementById('ville-options');

    input1.addEventListener('input', async function (e) {
      const text = e.target.value;

	const country = document.getElementById('pays').value;
	console.log(country);
      if (text.length < 1) {
        optionsList.style.display = 'none';
        optionsList.innerHTML = ""; 
        return;
      }
      const url = `https://nominatim.openstreetmap.org/search?city=${text}&country=${country}&format=json`;
      try {
        const response = await fetch(url, {
          headers: {
            "User-Agent": "MyApp/1.0"
          }
        });

        const data = await response.json();
     if (data && data.length > 0) {
          optionsList.innerHTML = "";
          optionsList.style.display = 'block';
		optionsList.style.marginRight = '30px';
          data.slice(0, 5).forEach(item => {
            const li = document.createElement("li");
            li.classList.add("list-group-item");
            li.textContent = item.name; 
            li.addEventListener('click', function () {
              input1.value = item.name; 
              optionsList.style.display = 'none';
            });
            optionsList.appendChild(li);
          });
        } else {
          optionsList.style.display = 'none';
        }
      } catch (error) {
        console.error("Error fetching city data:", error);
        optionsList.style.display = 'none';
      }
    });
    document.addEventListener('click', function (e) {
      if (!input1.contains(e.target) && !optionsList.contains(e.target)) {
        optionsList.style.display = 'none';
      }
    });
  });
</script>

   

{% endblock %}
