{% extends 'home/index.html.twig' %}
{% block body %}
    <link rel="stylesheet" href="{{ asset('css/css_categRadio.css') }}">
    <!-- Gestion des flash messages -->
{% for message in app.flashes('error') %}
    <div class="alert alert-danger" role="alert" >
        {{ message }}
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
        <span aria-hidden="true">&times;</span>
        </button>
    </div>
{% endfor %}
    <div class="category-title-banner">
        <img class="category-title-img" src="{{ asset('images/ler.png') }}">
		Liste Catégorie radio
</div>
<form name="form" action="{{ path('app_update_active_categorie_radio') }}" method="post" enctype="multipart/form-data">

	<div id="div2">
	    <div class="action-bar">
		<div>
		<a {% if app.user.AjoutCatRadio == '0' %} disabled {% endif %} href="{{path('app_ajouter_categorieradio')}}" class="btn btn-info btn-sm btn-custom-styled" name="add" id="add">
					<i class="glyphicon glyphicon-plus"></i>
					<span class="btn-text">Ajouter Catégorie radio</span></a>
			<button type="submit" {% if app.user.SauvegarderCatRadio == '0' %} disabled {% endif %} name="valider" class="btn btn-success btn-sm btn-save-custom">
				<i class="glyphicon glyphicon-floppy-disk"></i>
				<span class="btn-text">Sauvegarder</span>
			</button>
			<a name="annuler" href="{{ path('app_categorie_radio') }}" class="btn btn-danger btn-sm btn-cancel-custom">
				<i class="glyphicon glyphicon-remove"></i>
				<span class="btn-text">Annuler</span>
			</a>
			</div>
			<!-- la barre de recherche -->
			<input id="myInput" type="text" placeholder="Search.." class="search-input">
		</div>
        <div class="table-container-responsive">
            <table class="table table-striped table-bordered header-fixed table-hover data-table" id="dataTables-example">
                <thead>
                    <tr>
                        <th class="centered-cell">Titre</th>
                        <th class="centered-cell">Icon</th>
                        <th class="centered-cell">
                        <p class="active-header-content">
                            <span>
                                Active
                            </span>
                            <input type="checkbox" id="checklist" class="checklist-checkbox"></th>
                        </p>
                        </th>
                        <script>
                            document.getElementById('checklist').addEventListener('click', function() {
                                    var checkboxes = document.querySelectorAll('input.jpCheckbox');
                                    for (var checkbox of checkboxes) {
                                        checkbox.checked = this.checked;
                                    }
                                });
                        </script>
                        <th class="centered-cell">Position</th>
                        <th class="centered-cell">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for catradio in catradios %}
                        <tr class="odd gradeX">
                            <td class="centered-cell">{{catradio.nom}}</td>
                            <td class="centered-cell">
                                <img src="{{ path('afficher_image', { filename: catradio.logo|split('/')|last, directory: 'categorie_radio_directory' }) }}" alt="..." class="img-rounded img-responsive center-block category-icon">
                            </td>

                            <td class="centered-cell">
                            <input type="checkbox" value="{{ catradio.Active }}" class="jpCheckbox" name="listeactive[{{ catradio.id }}]"{% if catradio.Active == '1' %} checked {% endif %} {% if app.user.SauvegarderCatRadio == '0' %} disabled {% endif %}>
                            </td>
                            <td class="centered-cell">{{catradio.position}}</td>
                            <td class="centered-cell">
                                    <a {% if app.user.ModifierCatRadio == '0' %} disabled {% endif %} data-toggle="tooltip" data-placement="top" title="modifier Catégorie radio" href="{{path('app_modifier_categorieradio',{'id':catradio.id})}}" class="btn btn-warning btn-xs">
                                        <i class="glyphicon glyphicon-pencil"></i>
                                    </a>

                                    <a {% if app.user.SuppCatRadio == '0' %} disabled {% endif %} data-toggle="tooltip" data-placement="top" title="Supprimer Catégorie radio" href="{{path('app_supprimer_categorieradio',{'id':catradio.id})}}" class="btn btn-danger btn-xs"  onclick="return confirm('Voulez-vous vraiment supprimer la catégorie radio : {{catradio.nom}} ?')">
                                        <i class="glyphicon glyphicon-trash"></i>
                                    </a>
                            </td>
                        </tr>

                        {% endfor %}
                </tbody>
            </table>
        </div>
	</div>
	</form>
{% endblock %}
