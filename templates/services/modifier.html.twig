    console.log("src: ",src.src,image);
    const imagePath =`${URL}/${image}`;
    const imagesPath = `/images/${imagePath}/services_directory_diapo`
    DivImg.innerHTML = `
            <p class="btn btn-xs md-diapo-delete-btn" onclick="deleteOldImage(${i})" data-toggle="tooltip" data-placement="top" title="Supprimer l'image" >
                <i class="glyphicon glyphicon-trash" style="color:red"></i>
            </p>
            <img src="${imagesPath}" 
                 alt="Image ${i}" class="img1">
        `;
    let divInputs = document.createElement("div");
    divInputs.classList.add("md-diapo-inputs-container");
    divInputs.innerHTML = `
            <label>Ordre d'affichage:</label>
            <input id="numberInput-${i}" 
                   name="numberInput[${i}]" 
                   type="number" 
                   min="1"
                   class="md-diapo-input-number"
                   value="${orderValue}" onchange = "changeValeurOrder(this,${i})">
            <label>Durée d'affichage:</label>
            <div class="md-diapo-input-time-container">
            <input id="timeInput-${i}" 
                   name="timeInput[${i}]" 
                   type="number"
                   min="1"
                   class="md-diapo-input-number"
                   value="${durationValue}">
            <span class="md-diapo-unit-span">(Seconde)</span>
            </div>`;

    DivImg.appendChild(divInputs);
    divAll.appendChild(DivImg);
  });
  displayArea.appendChild(divAll);
}

</script>

{% endblock %}
