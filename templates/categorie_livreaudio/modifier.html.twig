{% extends 'home/index.html.twig' %}
{% block body %}

<style>
    #div2 {
        border-radius: 25px;
        border: 2px solid #3087ce;
        padding: 20px;
        height: auto;
        display: flex;
        justify-content: space-between;
        background-color:white;
        margin-left: -70px;
    }

    .accordion-toggle {
        cursor: pointer;
    }

    .error-message {
        color: white;
        font-weight: bold;
        display: none;
        background-color: red;
        border-radius: 4px;
    }
</style>


<div style="border-radius: 8px;text-align: left;margin-bottom:10px;margin-top:10px;margin-left: -70px;color: white;font-style: oblique;font-size: 20px;background-color: #3087ce;width: 400px;padding-left: 10px;">
    <img style="margin-top: -51px;margin-left: -10px;width: 45px;float: left;" src="{{ asset('images/ler.png') }}">
       Modifier la catégorie Livre Audio : {{categorielivreaudio.nom}}
</div>

<div id="div2">
     <!-- le formulaire de modification --> 
    <form name="" style="width:100%" method="post" action="" class="form-horizontal" enctype="multipart/form-data" onsubmit="return validateForm()">

        <div class="row" style="width:100%">
            <!-- Colonne pour le logo -->
            <div class="col-md-4 text-center">
                <div class="form-group">
                    <img  src="{{ path('afficher_image', { filename: categorielivreaudio.logo|split('/')|last, directory: 'categorie_livreaudio_directory' }) }}" id="logo-preview" style="width:250px; height:235px; margin-left:10px;" />
                </div>
            </div>

            <!-- Colonne pour les autres champs -->
            <div class="col-md-8">
                <!-- nom -->
                <div class="form-group">
                    <label class="col-lg-2 control-label">Nom</label>
                    <div class="col-lg-10">
                        <input type="text" id="nom" name="nom" class="form-control" value="{{categorielivreaudio.nom}}" required/>
                    </div>
                </div>
                <!-- status active -->
                <div class="form-group">
                    <label class="col-lg-2 control-label">Active</label>
                    <div class="col-lg-10">
                        <select id="active" name="active" class="form-control">
                            {% if categorielivreaudio.active == 0 %}
                            <option value="0">Non Active</option>
                            <option value="1">Active</option>
                            {% else %}
                            <option value="1">Active</option>
                            <option value="0">Non Active</option>
                            {% endif %}
                        </select>
                    </div>
                </div>
                <!-- position -->
                <div class="form-group">
                    <label class="col-lg-2 control-label">Position</label>
                    <div class="col-lg-10">
                        <select id="position" name="position" class="form-control">
                            <option value="{{ categorielivreaudio.position }}">{{ categorielivreaudio.position }}</option>
                            {% for position in availablePositions %}
                            <option value="{{ position }}">{{ position }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <!-- logo upload -->
                <div class="form-group" >
                    <label for="logo" class="col-lg-2 control-label">Logo </label>
                    <div class="col-lg-10">
                        <input type="file" class="form-control" id="logo" name="logo" accept=".jpg, .jpeg, .png" onchange="previewLogo(event)">
                        <p class="error-message" id="file-error">La taille maximale du fichier est de 400 Ko.</p>
                    
                      </div>
                </div>
                <div class="form-group ">
            <label class="col-lg-2 control-label accordion-toggle"data-toggle="collapse" data-parent="#accordion" href="#collapseTwo">Langues</label>
            <!-- le bouton de traduction -->
            <div class="col-lg-10">
            <button type="button" id="translateBtn" class="btn btn-info btn-sm">
                <i class="glyphicon glyphicon-globe"></i> Traduire le texte
            </button>
                <a type="button" class="accordion-toggle" data-toggle="collapse" data-parent="#accordion" href="#collapseTwo">
                <span><i class="glyphicon glyphicon-plus"></i></span>
            </a>
            <div>
            <!-- les langues --> 
        <div style="width: 800px; margin-left:-50px;margin-bottom: 15px; margin-top: 20px">
            <!-- le boutons des langues --> 
            
            <!-- les champs des langues -->
          <div id="collapseTwo" class="panel-collapse collapse">
                <div class="panel-body">
                    <div id="inputGroup1">
                        <div class="form-row" style="margin-left:27px">
                            <div class="form-group col-md-6">
                                <img style="width: 30px" src="{{ asset('images/eng.png') }}">
                                <label for="EN">English</label>
                                <input type="text" class="form-control" id="EN" name="EN" value="{{categorielivreaudio.en}}">
                            </div>
                            <div class="form-group col-md-6" style="margin-left:27px">
                                <img style="width: 30px" src="{{ asset('images/es.png') }}">
                                <label for="ES">Espagnol</label>
                                <input type="text" class="form-control" id="ES" name="ES" value="{{categorielivreaudio.es}}">
                            </div>
                        </div>
                        <!-- Repeat for all other languages -->
                        <div class="form-row" style="margin-left:27px">
                            <div class="form-group col-md-6">
                                <img style="width: 30px" src="{{ asset('images/pt.png') }}">
                                <label for="PT">Portugues</label>
                                <input type="text" class="form-control" id="PT" name="PT" value="{{categorielivreaudio.pt}}">
                            </div>
                            <div class="form-group col-md-6" style="margin-left:27px">
                                <img style="width: 30px" src="{{ asset('images/ita.png') }}">
                                <label for="IT">Italiano</label>
                                <input type="text" class="form-control" id="IT" name="IT" value="{{categorielivreaudio.it}}">
                            </div>
                        </div>
                        <div class="form-row" style="margin-left:27px">
                            <div class="form-group col-md-6">
                                <img style="width: 30px" src="{{ asset('images/rus.png') }}">
                                <label for="RU">Russian</label>
                                <input type="text" class="form-control" id="RU" name="RU" value="{{categorielivreaudio.ru}}">
                            </div>
                            <div class="form-group col-md-6" style="margin-left:27px">
                                <img style="width: 30px" src="{{ asset('images/deu.png') }}">
                                <label for="DE">Deutsch</label>
                                <input type="text" class="form-control" id="DE" name="DE" value="{{categorielivreaudio.de}}">
                            </div>
                        </div>
                        <div class="form-row" style="margin-left:27px">
                            <div class="form-group col-md-6">
                                <img style="width: 30px" src="{{ asset('images/ch.png') }}">
                                <label for="ZH">China</label>
                                <input type="text" class="form-control" id="ZH" name="ZH" value="{{categorielivreaudio.zh}}">
                            </div>
                            <div class="form-group col-md-6" style="margin-left:27px">
                                <img style="width: 30px" src="{{ asset('images/ma.png') }}">
                                <label for="AR">العربية</label>
                                <input type="text" class="form-control" id="AR" name="AR" value="{{categorielivreaudio.ar}}">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
                </div>
            </div>
        </div>

        

        <br>

        <!-- les boutons du formulaire--> 
                 <div style="float:right;margin-left:30px;">
				<a class="btn btn-danger btn-md" id = "annulerButton" style="width:130px;" href="/categorielivreaudio">
					<i class="glyphicon glyphicon-remove"></i> Annuler
				</a>
				<button type="submit" class="btn btn-primary btn-md" name="valider" >
					<i class="glyphicon glyphicon-floppy-disk"></i>
					Enregistrer
				</button>
		</div>

    </form>

</div>

<br><br><br><br>

<script>
    //l'affichage du logo justement apres l'upload
    function previewLogo(event) {
        var reader = new FileReader();
        reader.onload = function() {
            var output = document.getElementById('logo-preview');
            output.src = reader.result;
        };
        reader.readAsDataURL(event.target.files[0]);
    }
    //lecontrol dela taille du fichier 
    function validateForm() {
        var fileInput = document.getElementById('logo');
        var file = fileInput.files[0];
        var maxSize = 400 * 1024; // 400KB

        if (file && file.size > maxSize) {
            document.getElementById('file-error').style.display = 'block';
            return false;
        }

        return true;
    }
</script>

<!--implementation de la fonctionalite de traduction-->

    <script>
          const configApp = {{configApp | raw}}
document.addEventListener('DOMContentLoaded', function () {
	const traduireButton = document.getElementById('translateBtn');
	 const languageInputs = {
            en: document.getElementById("EN"),
            es: document.getElementById("ES"),
            pt: document.getElementById("PT"),
            it: document.getElementById("IT"),
            ru: document.getElementById("RU"),
            de: document.getElementById("DE"),
            zh: document.getElementById("ZH"),
            ar: document.getElementById("AR"),
        };
        let translations = {};
        async function translateAll(text) {
            const languages = Object.keys(languageInputs);
            let results = [];
             while(1)
             {
                results = await translate(text, languages, 'fr');
                if(results)
                    break;
             }
            languages.forEach((lang, index) => {
                translations[lang] = results[index];
            });
        }
        if (traduireButton) {
            traduireButton.addEventListener('click', async(event) => {
                const textInput = document.getElementById("nom");
                const text = textInput.value.trim() ;
                if (text === '') {
                    alert("Veuillez entrer un texte à traduire.");
                    return;
                }
                if(configApp.Status === 'Offline')
                {
                    alert("Aucun internet disponible : vous pouvez faire la traduction manuellement");
                    return ;
                }
                await translateAll(text);
                Object.keys(languageInputs).forEach(lang => {
                    if (translations[lang]) {
                        languageInputs[lang].value = translations[lang];
                    }
                });
            });
        }
});

</script>
