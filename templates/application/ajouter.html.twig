{% extends 'home/index.html.twig' %}
{% block body %}
	<link rel="stylesheet" href="{{ asset('css/css_design(App&jeux).css') }}" />


<div id="titre">
<img id="logo_titre" src="{{ asset('images/ler.png') }}">
	Ajouter Application 
</div>

<div id="div2_ajout">
		<form action="{{path('app_ajouter_application')}}" method="post" enctype="multipart/form-data">
			<div class="row">
				<div class="col-12 col-md-4">
					<label>Nom Application</label>
					<input type="text"name="nom" class="form-control">
				</div>

				<div class="col-12 col-md-4">
					<label>Package</label>
					<input type="text" name="package" class="form-control">
				</div>

				<div class="col-12 col-md-4">
					<label>Active</label>
					<select class="form-control" name="active">
						<option value="0">0</option>
						<option value="1">1</option>
					</select>
				</div>
			</div>
			
              <div class="row mt-3">
				<div class="col-12 col-md-4">
					<label>Position</label>
					<select class="form-control" name="position" id="positionSelect"></select>
				</div>

				<div class="col-12 col-md-4">
					<label>Logo</label>
					<input type="file" class="form-control" name="logo" required>
				</div>

				<div class="col-12 col-md-4">
					<label>Protocole</label>
					<select class="form-control" name="protocole">
						{% for support in supports %}
							<option value="{{ support.protocole }}">{{ support.nom|upper }}</option>
						{% endfor %}
					</select>
				</div>
			</div>
			<br>
			<br>
			<div class="clearfix">
				<div class="pull-right">
					<a class="btn btn-danger btn-md" id="annulerButton" style="width:130px;" href="/application">
						<i class="glyphicon glyphicon-remove"></i> Annuler
					</a>

					<button type="submit" class="btn btn-primary btn-md" name="valider">
						<i class="glyphicon glyphicon-floppy-disk"></i>
						Enregistrer
					</button>
				</div>
			</div>


			</div>
			</form>

</div>
<!-- Scripts -->
<script>
	document.addEventListener("DOMContentLoaded", function () {
		const protocoleSelect = document.getElementById('protocole');
		const positionSelect = document.getElementById('positionSelect');

		const positionsBySupport = {{ positionsBySupport|json_encode|raw }};
		const firstFreePositionBySupport = {{ firstFreePositionBySupport|json_encode|raw }};

		if (!protocoleSelect || !positionSelect) {
			console.error("Un des éléments (protocole ou positionSelect) est introuvable.");
			return;
		}

		protocoleSelect.addEventListener('change', function () {
			const protocole = this.value;

			// Efface les anciennes options
			positionSelect.innerHTML = '<option value=""></option>';

			const occupiedPositions = positionsBySupport[protocole] || [];

			// Ajoute les positions disponibles
			for (let i = 1; i <= 100; i++) {
				if (!occupiedPositions.includes(i)) {
					const option = document.createElement('option');
					option.value = i;
					option.textContent = i;
					positionSelect.appendChild(option);
				}
			}

			// Sélectionne la première position libre
			const firstFree = firstFreePositionBySupport[protocole];
			if (firstFree) {
				positionSelect.value = firstFree;
			}
		});
	});
</script>


{% endblock %}