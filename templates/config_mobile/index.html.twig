<button type="submit" class="button btn btn-primary btn-sm" style="margin-left: 800px;margin-top: -129px;" name="valider" id="btnEnregistrer">
  <i class="glyphicon glyphicon-floppy-disk"></i>
  Enregistrer
</button>
<script>
document.getElementById('btnEnregistrer').addEventListener('click', function(event) {
  var payementVersionSelect = document.getElementById('payement_version').value;
  var payementPkInput = document.querySelector('input[name="payement_pk"]');
  var payementSkInput = document.querySelector('input[name="payement_sk"]');

  if (payementVersionSelect === 'payline') {
    var payementIdInput = document.querySelector('input[name="payement_id"]');
    var payementKeyInput = document.querySelector('input[name="payement_key"]');
    var payementVadInput = document.querySelector('input[name="payement_vad"]');

    if (!/^\d{14}$/.test(payementIdInput.value)) {
      event.preventDefault(); // Empêche l'enregistrement du formulaire
      alert('Le champ "Id" doit être composé de 14 chiffres.');
    }

    if (!/^.{20}$/.test(payementKeyInput.value)) {
      event.preventDefault(); // Empêche l'enregistrement du formulaire
      alert('Le champ "Key" doit être composé de 20 caractères.');
    }

    if (!/^\d{7}$/.test(payementVadInput.value)) {
      event.preventDefault(); // Empêche l'enregistrement du formulaire
      alert('Le champ "Vad" doit être composé de 7 chiffres.');
    }
  } else if (payementVersionSelect === 'stripe') {
    if (!payementPkInput.value.startsWith('pk_') || !payementSkInput.value.startsWith('sk_')) {
      event.preventDefault(); // Empêche l'enregistrement du formulaire
      alert('Les champs "Pk" et "Sk" doivent commencer par "pk_" et "sk_" respectivement.');
    }
  }
});
</script>
