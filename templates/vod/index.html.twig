{% extends 'home/index.html.twig' %}

{% block body %}
<link rel="stylesheet" href="{{ asset('css/css_Vod.css') }}" />

{% if appConfig.StatusServeur is same as('Offline') %}
    <script src="{{ asset('javascript/jszip.min.js') }}"></script>
    <script src="{{ asset('javascript/pdfmake.min.js') }}"></script>
    <script src="{{ asset('javascript/vfs_fonts.js') }}"></script>
    <script src="{{ asset('javascript/dataTables.buttons.min.js') }}"></script>
    <script src="{{ asset('javascript/buttons.html5.min.js') }}"></script>
    <script src="{{ asset('javascript/jquery.min.js') }}"></script>
    <script src="{{ asset('javascript/jquery.dataTables.min.js') }}"></script>
    <script src="{{ asset('javascript/datatables2.min.js') }}"></script>
    <script src="{{ asset('javascript/xlsx.full.min.js') }}"></script> 
    <script src="{{ asset('javascript/dataTables.buttons.min.js') }}"></script>
    <script src="{{ asset('javascript/clipboard.min.js') }}"></script>
{% else %}
    <script src="{{asset('javascript/jquery.min.js')}}"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="{{ asset('javascript/datatables2.min.js') }}"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.4/xlsx.full.min.js"></script> 
    <script src="https://cdn.datatables.net/buttons/2.3.3/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/clipboard.js/2.0.8/clipboard.min.js"></script> 
{% endif %}

<div class="v-container">
<div class="v-header-title">
    <img class="v-header-icon" src="{{ asset('images/ler.png') }}">
    Liste VOD
</div>

<form name="form" action="{{ path('app_active_vod')}}" method="post" enctype="multipart/form-data">
    <div id="div2">
    <!--les boutons en haut du formulaire-->
    <div class="v-actions-row">
    <div class="v-btn-group">
    <a href="{{ path('app_ajouter_vod') }}" {% if app.user.AjouteVod == '0' %} disabled {% endif %} class="btn btn-info btn-sm v-btn-action" name="add" id="add">
        <i class="glyphicon glyphicon-plus"></i> <span class="v-btn-text">Ajouter VOD</span>
    </a>
    <button type="submit" name="valider" {% if app.user.SauvegarderVod == '0' %} disabled {% endif %} class="btn btn-success btn-sm v-btn-action">
        <i class="glyphicon glyphicon-floppy-disk"></i> <span class="v-btn-text">Sauvegarder</span>
    </button>
    <a name="annuler" href="{{ path('app_vod') }}" class="btn btn-danger btn-sm v-btn-action">
        <i class="glyphicon glyphicon-remove"></i> <span class="v-btn-text">Annuler</span>
    </a>
    </div>
    <!--la barre de recherche-->
    <div class="v-search-group">
        <!--<label for="myInput" class="v-search-label">Recherche:</label>-->
        <input id="myInput" type="text" placeholder="Search.." class="v-search-input">
    </div>
    </div>
        <div class="table-container">
 <table class="table table-striped table-bordered v-table-main header-fixed table-hover" id="dataTables-example">
                
                <thead>
                    <tr>
                        <th class="v-th-col" >Logo</th>
                        <th class="v-th-col" >Titre</th>
                        <th class="v-th-col">Description</th>
                        <th class="v-th-col" >
                            <div class="v-active-group">
                            <span>
                                Active
                            </span>
                            <input type="checkbox" id="checklist" class="v-checklist-input"></th>
                            </div>                
                        </th>
                        <th class="v-th-col" >Répertoire Vidéo</th>
                        <th class="v-th-col" >Type</th>
                        <th class="v-th-action">Action</th>
                    </tr>
                </thead>
                <tbody id="myTable">
                    {% for video in videos %}
                        <tr>
                            <td class="v-td-col" data-label="Logo">
                                <img src="{{ path('afficher_image', { filename: video.logo|split('/')|last, directory: 'vod_directory' }) }}" alt="..." class="img-rounded img-responsive center-block v-logo-img">
                            </td>
                            <td class="v-td-col" data-label="Titre">{{ video.nom|capitalize }}</td>
                            <td class="scrollable v-td-col" data-label="Description">{{ video.description }}</td>
                            {% set ch = video.active == 1 ? 'checked' : '' %}
                            <td class="v-td-col" data-label="Active">
                                <label class="v-checkbox-label">
                                    <input {% if app.user.SauvegarderVod == '0' %} disabled {% endif %} name="listeactive[{{ video.id }}]" type="checkbox" {{ ch }} class="jpCheckbox">
                                    <span class="v-checkbox-text">Active</span>
                                </label>
                            </td>
                            <td class="v-td-col" data-label="Répertoire Vidéo">{{ video.url }}</td>
                            <td class="v-td-col" data-label="Type">{{ video.categorie.nom }}</td>
                            <td class="v-td-action v-td-actions-group">
                            <div data-label="Lire la VOD">
                                <span data-toggle="tooltip" data-placement="top" title="Lire la VOD" >
                                <a  title="Lire la VOD" class="btn btn-success btn-xs play-video" data-toggle="modal" data-target="#videoModal" data-video-url="{{ asset(video.url) }}" data-video-title="{{ video.nom|capitalize }}">
                                    <i class="glyphicon glyphicon-play"></i>
                                </a>
                                </span>
                            </div>
                            <div data-label="Modifier">
                                <a  data-toggle="tooltip" data-placement="top" {% if app.user.ModifierVod == '0' %} disabled {% endif %} title="Modifier la VOD" href="{{ path('app_modifier_vod', { 'id': video.id }) }}" class="btn btn-warning btn-xs">
                                    <i class="glyphicon glyphicon-pencil"></i>
                                </a>
                            </div>
                            <div data-label="Supprimer">
                                <a data-toggle="tooltip" data-placement="top" {% if app.user.SupprimerVod == '0' %} disabled {% endif %} title="Supprimer la VOD" href="{{ path('app_supprimer_vod', { 'id': video.id }) }}" class="btn btn-danger btn-xs" onclick="return confirm('Voulez-vous vraiment supprimer la VOD : {{ video.nom }} ?')">
                                    <i class="glyphicon glyphicon-trash"></i>
                                </a>
                            </div>
                                <div data-toggle="modal" data-target="#modal2-{{video.id}}" data-id ="{{video.id}}"  data-name="{{video.nom}}" class="lancer-button" data-label="Lancer">
                                <a data-toggle="tooltip" data-placement="top" {% if app.user.LancerVod == '0' %} disabled {% endif %} title="Lancer la VOD" name="send" class="btn btn-info btn-xs">
                                    <i class="glyphicon glyphicon-play-circle"></i>
                                </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7">No records found</td>
                        </tr>
                    {% endfor %}
                </tbody>

                
            </table>
        </div>
    </div>
</form>

<!-- Modal Structure -->
<div class="modal fade" id="videoModal" tabindex="-1" role="dialog" aria-labelledby="videoModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
            <h5 class="modal-title" id="videoModalLabel"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="embed-responsive embed-responsive-16by9">
                    <video class="embed-responsive-item" controls id="modalVideo">
                        <source src="" type="video/mp4">  <!-- MP4 format -->
                        <source src="" type="video/mpeg"> <!-- MPEG format -->
                        <source src="" type="video/x-m2t"> <!-- M2T format -->
                        <source src="" type="video/3gpp"> <!-- 3GP format -->
                        Your browser does not support the video tag.
                    </video>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- la selection de tous les boxes dans le checkbox champ-->
<script>
    document.getElementById('checklist').addEventListener('click', function() {
        var checkboxes = document.querySelectorAll('input.jpCheckbox');
        for (var checkbox of checkboxes) {
            checkbox.checked = this.checked;
        }
    });
</script>



<!-- script pour la recherche-->
<script>
    $(document).ready(function() {
        $("#myInput").on("keyup", function() {
            var value = $(this).val().toLowerCase();
            $("#myTable tr").filter(function() {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });
    });
</script>



<!--parametrage de la video dans la modale-->
<script>
    $(document).ready(function(){
        // Initialize tooltips for all buttons
        $('[data-toggle="tooltip"]').tooltip();

        // Handle the button click for playing video
        $('.play-video').on('click', function() {
            var videoUrl = $(this).data('video-url');
            var videoTitle = $(this).data('video-title');

            // Set the video URL
            $('#modalVideo').attr('src', videoUrl);

            // Set the modal title
            $('#videoModalLabel').text(videoTitle);
        });

        // Clear video source when modal is closed
        $('#videoModal').on('hidden.bs.modal', function () {
            $('#modalVideo').attr('src', '');
        });

    });
</script>

<script>
  const chambre = {{chambre | raw }};
function createModal(index,Id,name) {
    const popUP = document.createElement('div');
    popUP.setAttribute("class", "modal fade v-modal-main");
    popUP.setAttribute("tabindex", "-1");
    popUP.setAttribute("role", "dialog");
    popUP.setAttribute("id", `modal1-${index}`);
    popUP.setAttribute("aria-labelledby", "modalLabel1");
    popUP.setAttribute("aria-hidden", "true");
    popUP.innerHTML = `
        <div class="modal-dialog" role="document">
            <div class="modal-content v-modal-content-custom">
                <div class="modal-header v-modal-header-container">
                <button id="close" type="button" class="close close2" data-dismiss="modal1-${index}" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <div class="v-modal-custom-header">
                    <img class="v-modal-header-icon" src="{{ asset('images/ler.png') }}" alt="Icon">
                        Lancer Vod ${name}
                    </div>
                </div>
                <form id="form" method="post" enctype="multipart/form-data" action="/vod/LancerVod/${Id}">
                <div class="modal-body" id="modal-body1-${index}" >
                <div class="v-modal-sub-title">Liste Support connecté à choisir</div>
                </div>
                <div class="modal-footer">
                  <button id="envoyervod" type="submit" class="btn btn-primary conf" name="envoyervod"> <i class="glyphicon glyphicon-send"></i> Lancer Vod</button>
                  <a class="btn btn-danger " style="width: 139px;" href="/vod/" role="button"><i class="glyphicon glyphicon-remove"></i> Annuler</a></div>
            </div>
            </form>
        </div>    
    `;
    return popUP;
}

document.addEventListener('click', function (event) {
    const lancerButton = event.target.closest('.lancer-button');
    console.log(lancerButton);
    if(!lancerButton)
      return ;
    const Id = lancerButton.getAttribute('data-id');
    const name = lancerButton.getAttribute('data-name');
    const active = document.getElementById(`active-${Id}`);
    let index = -1;
    if (lancerButton.getAttribute("data-target")) {
      index = lancerButton.getAttribute("data-target").split('-')[1];
      if(index >= 0)
      {
        if (active && !active.checked) {
        confirm("Attention, Vod n'est pas actif, donc non présent sur la box. Merci de le cocher.Faites dans un premier temps la mise à jour sur la BOX.Enfin, vous pouvez lancer la Vod avec l'icône bleue.");
        event.preventDefault(); 
        return false;
      }
      else{
        const body = document.getElementById('div2');
        const modal = createModal(index,Id,name);
        body.appendChild(modal);
    const modalBody1 = document.querySelector(`#modal-body1-${index}`);
    if (modalBody1 && Array.isArray(chambre)) {
      const existeTable = document.getElementById(`table-${index}`);
      if(!existeTable)
      {
      const table = document.createElement('table');
      table.setAttribute("class","table table-striped v-modal-table header-fixed table-bordered table-hover table-checkable order-column dataTable no-footer");
      table.id = `table-${index}`;
      const thead = document.createElement('thead');
      thead.innerHTML = `
        <tr class="v-modal-thead-row">
          <th class="v-modal-th"><input type="checkbox" id="checkAllboxn"/><p class="v-text-red">Selectionner / Désélectionner</p></th>
          <th class="v-modal-th">Chambre</th>
          <th class="v-modal-th">Adresse IP</th>
          <th class="v-modal-th">Adresse MAC</th> 
        </tr>`;
      table.appendChild(thead);
      const tbody = document.createElement('tbody');
      let i = 0;
      chambre.forEach(chbr => {
    const tr1 = document.createElement('tr');
    tr1.classList.add('v-modal-tr', 'v-modal-tr-body');
    tr1.innerHTML = `
        <td class="v-modal-td" data-label="Selectionner">
            <label class="v-modal-checkbox-label">
                <input type="checkbox" value=${chbr.id} name="checked[${i}]" class="boxcheck"/>
                <span class="v-modal-checkbox-text">Selectionner</span>
            </label>
            <input style="display:none" type="text" value=${chbr.id} name="chambre[${i}]">
        </td>
        <td class="v-modal-td" data-label="Chambre">${chbr.nom}</td>
        <td class="v-modal-td" data-label="Adresse IP">${chbr.ip}</td>
        <td class="v-modal-td" data-label="Adresse MAC">${chbr.Mac}</td>`;
    tbody.appendChild(tr1);
    i++;
});
      table.appendChild(tbody);
      modalBody1.appendChild(table);
      const modal = document.getElementById(`modal1-${index}`);
      modal.classList.remove('fade');
      modal.classList.add('show'); 
      modal.style.display = 'block';
		document.body.style.overflow = 'hidden';
		modal.style.overflowY = 'auto';
		modal.style.maxHeight = '90vh';
      if (!$.fn.dataTable.isDataTable(`#table-${index}`)) {
      $(`#table-${index}`).DataTable({
        language: {
        emptyTable: "Aucune chambre disponible."
    },
        oLanguage: {"sSearch": "Recherche:"},
        paging: false,
        searching: true,
        ordering: false,
        info: false,
        columnDefs: [{ orderable: false, targets: 0 }]
      });
    }
    }
      }
      }
    }
  const checkAll = document.getElementById('checkAllboxn');
const checkboxes = document.querySelectorAll('.boxcheck');

if (checkAll) {
    checkAll.addEventListener('change', () => {
        checkboxes.forEach(checkbox => {
            checkbox.checked = checkAll.checked;
        });
    });
}

if (checkboxes) {
    checkboxes.forEach(checkbox => {
        checkbox.addEventListener('change', () => {
            if (!checkbox.checked) {
                checkAll.checked = false;
            } else if (Array.from(checkboxes).every(cb => cb.checked)) {
                checkAll.checked = true;
            }
        });
    });
}
})

document.addEventListener('click', function (event) {
    const CloseButton = event.target.closest('.close2');
    if(!CloseButton)
        return;
  const dataDismiss = CloseButton.getAttribute("data-dismiss");
   if (dataDismiss) {
    const index = dataDismiss.split('-')[1]; 
    const modal = document.getElementById(`modal1-${index}`); 
    const modalBackdrop = document.getElementsByClassName("modal-backdrop");
    if (modal) {
      modal.classList.remove('show');
      modal.classList.add('fade');
      modal.style.display = 'none';
	  document.body.style.overflow = '';
      modal.style.overflowY = '';
      modal.remove();
    }
    if (modalBackdrop[0]) {
      modalBackdrop[0].remove();
      if(modalBackdrop[0]);
      modalBackdrop[0].remove();
    }
    }
});
</script>
</div>
{% endblock %}
