            </div>
        </div>
        <script>
        window.addEventListener('DOMContentLoaded', () => {
            // Gestion des dates
            const now = new Date();
            const localNow = now.toISOString().slice(0, 16);
            const datedebut = document.getElementById('datedebut');
            const datefin = document.getElementById('datefin');
            datedebut.min = localNow;
            datefin.min = localNow;
            datedebut.addEventListener('change', () => {
                datefin.min = datedebut.value;
            });

            // Affichage de l'aperçu stylé du texte en direct
            const textarea = document.getElementById('text');
            const textPreview = document.getElementById('text-preview');
            const fontSelect = document.getElementById('font');
            const fontSizeSelect = document.getElementById('fontSize');
            const animationSelect = document.getElementById('animation');
            const styleSelect = document.getElementById('style');
            const vitesseInput = document.getElementById('vitesseDefilement');
            const textColorInput = document.getElementById('textColorDefilement');
            const bgColorInput = document.getElementById('bgColorDefilement');

            if (window.jQuery && window.jQuery.fn && typeof window.jQuery.fn.colors_picker === 'function') {
                window.jQuery('.colors_picker').colors_picker();
            }

            function getStyledText(text, vitesse) {
                let style = '';
                if (fontSelect && fontSelect.value) style += `font-family:${fontSelect.value};`;
                if (fontSizeSelect && fontSizeSelect.value) style += `font-size:${fontSizeSelect.value}px;`;
                if (textColorInput && textColorInput.value && textColorInput.value !== 'transparent') style += `color:${textColorInput.value};`;
                if (bgColorInput && bgColorInput.value && bgColorInput.value !== 'transparent') style += `background-color:${bgColorInput.value};`;
                if (bgColorInput && bgColorInput.value && bgColorInput.value !== 'transparent') style += 'padding:2px 10px; border-radius:3px;';
                if (styleSelect && styleSelect.value) {
                    if (styleSelect.value === 'Gras') style += 'font-weight:bold;';
                    if (styleSelect.value === 'Italique') style += 'font-style:italic;';
                    if (styleSelect.value === 'Souligné') style += 'text-decoration:underline;';
                    if (styleSelect.value === 'Barré') style += 'text-decoration:line-through;';
                }
                let animClass = '';
                let animStyle = '';
                if (animationSelect && animationSelect.value) {
                    if (animationSelect.value === 'scroll') animClass = 'ia-scroll';
                    if (animationSelect.value === 'bounce') animClass = 'ia-bounce';
                    if (animationSelect.value === 'fade') animClass = 'ia-fade';

                    // Apply speed to all animations in preview
                    if (vitesse && !isNaN(vitesse) && vitesse > 0) {
                        const duration = Math.max(0.3, 50 / vitesse);
                        animStyle = `animation-duration:${duration}s;`;
                    }
                }
                // Ne pas afficher la vitesse dans le preview, juste appliquer la vitesse à l'animation
                return `<span style="${style}${animStyle}" class="${animClass}">${text}</span>`;
            }

            function updatePreview() {
                const text = textarea.value;
                const vitesse = vitesseInput ? parseFloat(vitesseInput.value) : null;
                if (text.trim() !== '') {
                    textPreview.innerHTML = getStyledText(text, vitesse);
                    textPreview.style.display = '';
                } else {
                    textPreview.style.display = 'none';
                }
            }

            textarea.addEventListener('input', updatePreview);
            [fontSelect, fontSizeSelect, animationSelect, styleSelect, textColorInput, bgColorInput].forEach(sel => {
                if (sel) sel.addEventListener('change', updatePreview);
            });
            if (vitesseInput) vitesseInput.addEventListener('input', updatePreview);
        });
        </script>
