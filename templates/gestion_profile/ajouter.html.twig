{% extends 'home/index.html.twig' %}
{# Cette section concerne la conception de modèles pour l'ajout d'un service.#}
{% block body %}

{# offline #}
{% if appConfig.StatusServeur is same as('Offline') %}

<script src="assets/js/all.min.js"></script>
{% else %}
{# online #}
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/js/all.min.js"></script>

{% endif %}

{% for type, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ type }}">
         	{{ message }}
        </div>
    {% endfor %}
{% endfor %}
<div style="border-radius: 8px;margin-left:-70px;  margin-top:10px;text-align: left; margin-bottom: 10px; color: white; font-style: oblique; font-size: 20px; background-color: #3087ce; width: 300px; padding-left: 10px; display: inline-block;">
    <img style="margin-top: -51px; margin-left: -10px; width: 45px; float: left;" src="{{ asset('images/ler.png') }}">
