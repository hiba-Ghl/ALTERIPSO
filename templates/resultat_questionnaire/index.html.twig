<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.4.0/jspdf.umd.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.13/jspdf.plugin.autotable.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.0/xlsx.full.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js"></script>


{# script pour exporter un pdf et Excel  #}
<script>
{# PDF export function #}
document.getElementById('exportPdfBtn').addEventListener('click', function () {
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF();

    // Récupérer les valeurs des filtres
    const startDate = document.getElementById('start_date').value;
    const endDate = document.getElementById('end_date').value;
    const chambreSelect = document.getElementById('chambre_id');
    const chambreName = chambreSelect.options[chambreSelect.selectedIndex].text;
    const serviceSelect = document.getElementById('service_id');
    const serviceName = serviceSelect.options[serviceSelect.selectedIndex].text;

    // Construire le titre en utilisant les filtres
    let title = `Les statistiques du questionnaire du ${startDate} au ${endDate}`;
    if (serviceName && serviceName !== 'Tous les services') {
        title += ` pour le service ${serviceName}`;
    } else {
        title += ' pour tous les services';
    }
    if (chambreName && chambreName !== 'Tous les chambres') {
        title += ` et le support ${chambreName}`;
    } else {
        title += ' et tous les supports';
    }

    // Réduire la taille de la police du titre
    doc.setFontSize(14);

    // Diviser le titre en lignes adaptées à la largeur de la page
    const pageWidth = doc.internal.pageSize.getWidth();
    const margin = 35;
    const textWidth = pageWidth - margin * 2;
    const splitTitle = doc.splitTextToSize(title, textWidth);

    // Ajouter le titre principal avec fond noir et texte blanc
    const titleHeight = splitTitle.length * 10 + 10;
    doc.setTextColor(255, 255, 255);
    doc.setFillColor(0, 0, 0);
    doc.rect(10, 10, pageWidth - 20, titleHeight, 'F');
    let y = 20;
    splitTitle.forEach(line => {
        const textWidth = doc.getTextWidth(line);
        const x = (pageWidth - textWidth) / 2;
        doc.text(line, x, y);
        y += 10;
    });

    // Réinitialiser les couleurs pour le reste du document
    doc.setTextColor(0, 0, 0);

    // Ajouter le titre du diagramme avec un carré noir et texte blanc
    doc.setFontSize(14);
    doc.setTextColor(255, 255, 255);
    doc.setFillColor(0, 0, 0);
    doc.rect(10, y + 10, pageWidth - 20, 15, 'F');
    doc.text('I Représentation graphique', 25, y + 20);

    y += 30;

    // Capturez le graphique sous forme d'image à l'aide de html2canvas
    html2canvas(document.getElementById('chart_div')).then(canvas => {
        const imgData = canvas.toDataURL('image/png');
        doc.addImage(imgData, 'PNG', 10, y, 180, 100);

        // Ajouter le titre du tableau avec fond noir et texte blanc
        doc.setFontSize(14);
        doc.setTextColor(255, 255, 255);
        doc.setFillColor(0, 0, 0);
        doc.rect(10, y + 110, pageWidth - 20, 15, 'F');
        doc.text('II Représentation statistique', 25, y + 120);

        y += 140;

        // Ajouter le tableau au PDF avec pagination
        const table = document.getElementById('example');
        const tableData = [];

        const headers = table.querySelectorAll('thead th');
        const headerRow = [];
        headers.forEach(header => {
            headerRow.push(header.dataset.title || header.textContent.trim());
        });
        tableData.push(headerRow);

        const rows = table.querySelectorAll('tbody tr');
        rows.forEach(row => {
            const rowData = [];
            const cells = row.querySelectorAll('td');
            cells.forEach(cell => {
                rowData.push(cell.textContent.trim());
            });
            tableData.push(rowData);
        });

        doc.autoTable({
            head: [tableData[0]],
            body: tableData.slice(1),
            startY: y,
            theme: 'striped',
            styles: {
                halign: 'center' // Centre le texte dans les cellules
            },
            columnStyles: {
                0: { halign: 'left', cellWidth: 'auto' }, // Aligne le texte de la première colonne à gauche
                1: { cellWidth: 'auto' } // Autres colonnes, alignement centré par défaut
            },
            margin: { bottom: 30 }, // Ajouter une marge en bas pour la pagination
            didDrawPage: function (data) {
                // Ajouter la pagination
                const pageCount = doc.internal.getNumberOfPages();
                doc.setFontSize(10);
                doc.text(`Page ${data.pageNumber} sur ${pageCount}`, data.settings.margin.left, doc.internal.pageSize.height - 10);
            }
        });

        doc.Sauvegarder('statistiques.pdf');
    });
});



{# Excel export function #}
    document.getElementById('exportExcelBtn').addEventListener('click', async function () {
        const ExcelJS = window.ExcelJS;
        const workbook = new ExcelJS.Workbook();
        const worksheet = workbook.addWorksheet('Statistiques');

        {# Récupérer les valeurs du service et du support #}
        const serviceId = document.getElementById('service_id').selectedOptions[0].text;
        const chambreId = document.getElementById('chambre_id').selectedOptions[0].text;
        const startDate = document.getElementById('start_date').value;
        const endDate = document.getElementById('end_date').value;

        {# Ajouter un titre #}
        worksheet.mergeCells('A1:E1');
        worksheet.getCell('A1').value = `Les statistiques du questionnaire du ${startDate} au ${endDate}, Service: ${serviceId}, Support: ${chambreId}`;
        worksheet.getCell('A1').font = { size: 16, bold: true };  // Taille de police pour simuler un titre <h3>
        worksheet.getCell('A1').alignment = { vertical: 'middle', horizontal: 'center' };

        {# Capturez le graphique sous forme d'image à l'aide de html2canvas #}
        const canvas = await html2canvas(document.getElementById('chart_div'));
        const imgData = canvas.toDataURL('image/png');
        const imgId = workbook.addImage({
            base64: imgData,
            extension: 'png',
        });

        {# Ajoutez l'image à la feuille de calcul #}
        worksheet.addImage(imgId, 'A3:C17');

        {# Convertir le tableau en feuille de calcul #}
        const table = document.getElementById('example');
        const headers = table.querySelectorAll('thead th');
        headers.forEach((header, colIndex) => {
            worksheet.getCell(19, colIndex + 1).value = header.dataset.title || header.textContent.trim();
            worksheet.getCell(19, colIndex + 1).font = { bold: true };
            worksheet.getColumn(colIndex + 1).width = header.textContent.trim().length + 15;
        });

        const rows = table.querySelectorAll('tbody tr');
        rows.forEach((row, rowIndex) => {
            const cells = row.querySelectorAll('td');
            cells.forEach((cell, cellIndex) => {
                worksheet.getCell(rowIndex + 20, cellIndex + 1).value = cell.textContent.trim();
                worksheet.getColumn(cellIndex + 1).width = Math.max(worksheet.getColumn(cellIndex + 1).width, cell.textContent.trim().length + 15);
            });
        });

        {# Enregistrer le fichier Excel #}
        const buffer = await workbook.xlsx.writeBuffer();
        const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'statistiques.xlsx';
        a.click();
        URL.revokeObjectURL(url);
    });
</script>
<script>
    {# Fonction pour vérifier si le tableau est vide #}
    function checkTableEmpty() {
        const tableBody = document.querySelector('#example tbody');
        
        {# Vérifiez s'il y a des lignes dans le corps du tableau #}
        if (tableBody.rows.length === 0) {
            {# Assurez-vous que l'alerte ne s'affiche pas plusieurs fois #}
            if (!document.querySelector('#no-data-alert')) {
                alert('Aucune donnée trouvée pour les critères spécifiés.');
                {# Créez un élément pour marquer que l'alerte a été affichée #}
                const noDataAlert = document.createElement('div');
                noDataAlert.id = 'no-data-alert';
                noDataAlert.style.display = 'none'; // Cachez-le
                document.body.appendChild(noDataAlert);
            }
        } else {
            {# Si des données sont présentes, assurez-vous que l'élément d'alerte est supprimé #}
            const noDataAlert = document.querySelector('#no-data-alert');
            if (noDataAlert) {
                noDataAlert.remove();
            }
        }
    }

    {# Vérifiez le tableau après avoir cliqué sur le bouton de recherche #}
    document.getElementById('search-button').addEventListener('click', function() {
        checkTableEmpty();
    });

    {# Vérifiez le tableau après avoir changé la sélection de service #}
    document.getElementById('service_id').addEventListener('change', function() {
        checkTableEmpty();
    });

    {# Vérifiez le tableau après avoir changé la sélection de support #}
    document.getElementById('chambre_id').addEventListener('change', function() {
        checkTableEmpty();
    });

    {# Vérifiez le tableau après avoir chargé la page #}
    window.addEventListener('load', function() {
        checkTableEmpty();
    });
</script>
  
</div>
<script>

   document.getElementById('printPdfBtn').addEventListener('click', function() {
    {# Afficher la zone imprimable #}
    const printableArea = document.getElementById('printableArea');
    printableArea.style.display = 'block';

    {# je m'assure que l'autre contenu est masqué #}
    document.querySelector('.div').style.display = 'none';
    
    {# Impression de déclenchement #}
    window.print();

    {# Masquer à nouveau la zone imprimable après l'impression #}
    printableArea.style.display = 'none';
    
    // Restore the other content
    document.querySelector('.div').style.display = 'block';
    });

</script>

{% endblock %}