// Fonction pour ajouter automatiquement le préfixe "pk_" et "sk_" aux champs payement_pk et payement_sk
function handlePkSkPrefix(event) {
  if (event.target.name === 'payement_pk' || event.target.name === 'payement_sk') {
    const prefix = event.target.name === 'payement_pk' ? 'pk_' : 'sk_';
    if (!event.target.value.startsWith(prefix)) {
      event.target.value = prefix + event.target.value;
    }
  }
}

// Ajout de l'événement keydown aux champs payement_pk et payement_sk
document.querySelector('input[name="payement_pk"]').addEventListener('keydown', handlePkSkPrefix);
document.querySelector('input[name="payement_sk"]').addEventListener('keydown', handlePkSkPrefix);

// ... Suite de votre code existant ...
</script>
