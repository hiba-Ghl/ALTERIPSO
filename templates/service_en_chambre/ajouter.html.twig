  <script>
    function toggleSection() {
        var selectElement = document.getElementById("type_service_en_chambre");
        var selectedOption = selectElement.options[selectElement.selectedIndex];
        
        var selectedId = selectedOption.getAttribute("data-id");
        var selectedNom = selectedOption.getAttribute("data-nom");

        var achatSection = document.getElementById("achatSection");
        var listSection = document.getElementById("listSection");
        var menuSection = document.getElementById("menuSection");
        var priseSection = document.getElementById("priseSection");
        
        // Masquer toutes les sections
        achatSection.style.display = "none";
        listSection.style.display = "none";
        menuSection.style.display = "none";
        priseSection.style.display = "none";

        // Afficher la section appropriée en fonction de la valeur sélectionnée
        if (selectedNom === "Achat" || selectedNom === "achat") {
            achatSection.style.display = "block";
        } else if (selectedNom === "List" || selectedNom === "list") {
            listSection.style.display = "block";
        } else if (selectedNom === "Menu" || selectedNom === "menu") {
            menuSection.style.display = "block";
        }else if (selectedNom === "Prise rendez vous" || selectedNom === "prise rendez vous") {
            priseSection.style.display = "block";
        }
        
    }
</script>
  <!-- verification des champs vide  -->
  <script>
    function validateForm() {
        // Récupérer les valeurs des champs
        var nom = document.getElementById("nom");
        //var description = document.getElementById("Description");
        var logo = document.getElementById("logo");

        // Vérifier si les champs sont vides
        if (nom.value.trim() === '') {
            // Appliquer la classe d'erreur au champ
            nom.classList.add("error");
        } else {
            // Retirer la classe d'erreur si le champ est rempli
            nom.classList.remove("error");
        }

        if (description.value.trim() === '') {
            // Appliquer la classe d'erreur au champ
            description.classList.add("error");
        } else {
            // Retirer la classe d'erreur si le champ est rempli
            description.classList.remove("error");
        }

        if (logo.value.trim() === '') {
            // Appliquer la classe d'erreur au champ
            logo.classList.add("error");
        } else {
            // Retirer la classe d'erreur si le champ est rempli
            logo.classList.remove("error");
        }

        // Vérifier si au moins un champ est vide
        if (nom.value.trim() === '' || description.value.trim() === '' || logo.value.trim() === '') {
            // Empêcher la soumission du formulaire
            return false;
        }

        // Continuer avec la soumission normale si les champs sont remplis
        return true;
    }

    // Ajouter cette fonction à l'événement onsubmit du formulaire
    document.getElementById("formId").onsubmit = function () {
        return validateForm();
    };
  </script>
