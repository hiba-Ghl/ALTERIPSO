                <!-- File upload section -->
                <div id="fileUpload" style="display: none;">
                    <label for="file" class="control-label here">Télécharger un fichier:</label>
                    <span id="annUrl">{{ann.url}}</span>
                </div>

                <div id="error-message" style="color: red;"></div>

                <!-- Text input section -->
