{% extends 'index.html.twig' %}
{% block title %}Log in!
{% endblock %}

{% block body %}

  {# offline #}

<script src="assets/js/all.min.js"></script>


	<style>
		#div1 {
			border-radius: 25px;
			border: 2px solid #3087ce;
			padding: 20px;
			width: 1091px;
			height: 400px;
			margin-left: 10px;
			margin-top: 10px;
			
			padding: 43px;

		}
			{# border: 2px solid #3087ce; #}
		#div2 {
			border-radius: 25px;
			padding: 20px;
			width: 1091px;
			height: 550px;
			margin-left: 10px;
			margin-top: 10px;
		}
	</style>
	<div style="border-radius: 8px;text-align: left;margin-top:30px;margin-left: 40px;color: white;font-style: oblique;font-size: 20px;background-color: #3087ce;width: 350px;padding-left: 10px;">
		<img style="margin-top: -51px;margin-left: -10px;width: 45px;float: left;" src="{{ asset('images/ler.png') }}">
		Réinitialisation de mot de passe
	</div>
    <div id="div2">
        <div id="div1">
        <form method="post" style="display:flex;flex-direction:column;gap:20px;justify-content:center;" action="{{path('reset_pass',{'token':token})}}" onsubmit="return validatePassword()">
        <div id='divPassword'>
			<label for="password"> Entrez votre mot de passe: </label>
			<input type="password" name="password" id="password" class="form-control">
        </div>
        <div id='divConfirmPassword'>
			<label for="confirmerPassword"> Confirmer votre mot de passe: </label>
			<input type="password" name="confirmerPassword" id="confirmerPassword" class="form-control">
        </div>
        <button class="btn btn-success" style="background-color: #3087ce;">Confirmer</button>
        </form>
        </div>
    </div>

<script>
	function validatePassword(){
		const password = document.getElementById('password');
		const confirmerPassword = document.getElementById('confirmerPassword');
		console.log(password.value,confirmerPassword.value);
		if(password.value.trim() === '')
		{
			password.style.border ='2px solid red';
        	const ErreurPassword = document.getElementById('ErreurPassword');
        	if(!ErreurPassword)
        	{
        	const p = document.createElement('p');
        	p.setAttribute('id','ErreurPassword');
        	p.textContent = 'Le mot de passe est obligatoire ';
        	p.style.color ='red';
        	document.getElementById('divPassword').appendChild(p);
        	}
        	return false;
		}
			if(confirmerPassword.value.trim() == '')
		{
			confirmerPassword.style.border ='2px solid red';
        	const ErreurPassword = document.getElementById('ErreurConfirmPassword');
        	if(!ErreurPassword)
        	{
        	const p = document.createElement('p');
        	p.setAttribute('id','ErreurConfirmPassword');
        	p.textContent = 'Confirmer votre mot de passe s\'il vous plait';
        	p.style.color ='red';
        	document.getElementById('divConfirmPassword').appendChild(p);
        	}
        	return false;
		}
		if(password.value != confirmerPassword.value)
		{
			
        		confirmerPassword.style.border ='2px solid red';
        		const ErreurPassword = document.getElementById('ErreurConfirmPassword');
        	if(ErreurPassword)
        	{
				ErreurPassword.remove();
        	}
        	const p = document.createElement('p');
        	p.setAttribute('id','ErreurConfirmPassword');
        	p.textContent = 'Confirmer avec le même mot de passe s\'il vous plait';
        	p.style.color ='red';
        	document.getElementById('divConfirmPassword').appendChild(p);
        	return false;
		}
        return true;
		
	}
const password = document.getElementById('password');
const confirmerPassword = document.getElementById('confirmerPassword');
password.addEventListener('click',(e) => {
const ErreurPassword = document.getElementById('ErreurPassword');
	if(ErreurPassword)
	{
    password.style.border ='2px solid black';
	ErreurPassword.remove();
}
})

confirmerPassword.addEventListener('click',(e) => {
const ErreurPassword = document.getElementById('ErreurConfirmPassword');
	if(ErreurPassword)
	{
    confirmerPassword.style.border ='2px solid black';
	ErreurPassword.remove();
}
})
</script>
{% endblock %}
