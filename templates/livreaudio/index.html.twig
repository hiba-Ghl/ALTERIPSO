{% extends 'home/index.html.twig' %}
{% block body %}

<link rel="stylesheet" href="{{ asset('css/css_livreaudio.css') }}">

<div id="titre_livreaudio">
    <img id="logo_titre" src="{{ asset('images/ler.png') }}" alt="Logo">
    <span>Liste Livre Audio</span>
</div>

<!--le formulaire de modification d'un LivreAudio-->	
<form action="{{ path('modifier_livreaudio')}}" name="form" method="post" enctype="multipart/form-data" onsubmit="return validateListeIpForm();">
<!--les boutons en haut du tableau-->
	<div id="div2">
	  <div id="div_btn">
		<div>
			<button type="submit" name="valider"   {% if app.user.SauvegarderLiveAudio == '0' %} disabled {% endif %}  class="btn btn-success btn-sm" id="button_sm" href="{{path('modifier_chaine')}}">
				<i class="glyphicon glyphicon-floppy-disk"></i> Sauvegarder
			</button>
			<a name="annuler" href="{{ path('app_livreaudio') }}" class="btn btn-danger btn-sm" id="button_sm">
				<i class="glyphicon glyphicon-remove"></i> Annuler
			</a>
			</div>
			<!--la barre de recherche-->
			<input id="myInput" type="text" placeholder="Search..">
	</div>
	<br> <br>
	<div class="table-scrollable">
 		<table class="table table-striped table-bordered table-hover table-livreaudio" id="dataTables-example">
				<thead>
					<tr>
						<th class="col-nom">Nom Livre Audio</th>
						<th class="col-fichier">Fichier Livre Audio</th>
						<th class="col-categorie">Catégorie</th>
						<th class="col-icons">Icons</th>
						<th class="col-active">
							<div class="col-active-content">
								<span>Active</span>
								<input type="checkbox" id="checklist">
							</div>
						</th>
						<th class="col-action">Action</th>
					</tr>
				</thead>
				<tbody id="myTable"> 
					{% for tele in livreaudio %}
						<tr class="{% if tele.id in favorisLivreaudioIds %}livreaudio-favori-row{% endif %}">
							<!--le nom-->
							<td class="col-nom">
								<input {% if app.user.SauvegarderLiveAudio == '0' %} disabled {% endif %} name='listenom[{{tele.Id}}]' type="text" value="{{tele.nom|capitalize}}" class="form-control form-control-sm">
							</td>
							<!--le nom du fichier-->
							<td class="col-fichier">
								<input {% if app.user.SauvegarderLiveAudio == '0' %} disabled {% endif %} name='listeip[{{tele.Id}}]' class="form-control form-control-sm" value="{{tele.Ip}}">
							</td>
							<!--la categorie-->
							<td class="col-categorie">
								<select {% if app.user.SauvegarderLiveAudio == '0' %} disabled {% endif %} class="form-select form-select-sm" name='listcatlivreaudio[{{tele.Id}}]'> 
									{% if tele.categorie is not null %}
									<option selected=selected value ='{{tele.categorie.Id}}'>{{tele.categorie.nom|capitalize }}</option>
									 {% for a in categorielivreaudio %}      
								  	{% if a.nom == tele.categorie.nom %}
								  	{% else %}
									<option value ='{{a.id}}'>{{a.nom|capitalize }}</option>
									{% endif %}
									{% endfor %} 
									{% endif %}
								</select>
							</td>
							<!--l'icone-->
							<td class="col-icons">
								<div class="fileUpload" id="mainform">
									<img id="preview-{{tele.Id}}" style="width:50px;height:50px;"  src="{{ path('afficher_image', { filename: tele.logo|split('/')|last, directory: 'livreaudio_directory' }) }}" alt="Logo" class="img-rounded img-responsive center-block">
									<input {% if app.user.SauvegarderLiveAudio == '0' %} disabled {% endif %}  id="{{tele.Id}}" type="file" class="upload" name="listelogo[{{tele.Id}}]" accept=".jpg, .jpeg, .png"/>
								</div>
							</td>
							<!--le status active-->
							{% set ch = ' ' %}
							{% set chg = ' ' %}
							{% if (tele.active) == 1 %}
								{% set ch = 'checked' %}
							{% endif %}
							{% set isFavorite = tele.id in favorisLivreaudioIds %}
							<td class="col-active">
								<input {% if app.user.SauvegarderLiveAudio == '0' %} disabled {% endif %}  name='listeactive[{{tele.Id}}]' type="checkbox" {{ch}} class="jpCheckbox">
							</td>
							<!--l'action-->
							<td class="col-action">
								<div class="livreaudio-action-item">
									<label class="btn btn-warning btn-xs livreaudio-favori-toggle" style="margin-bottom:0; cursor:pointer;">
										<input
											{% if app.user.SauvegarderLiveAudio == '0' %} disabled {% endif %}
											name="listefavoris[{{tele.Id}}]"
											type="checkbox"
											value="1"
											{% if isFavorite %}checked{% endif %}
											class="livreaudio-favori-checkbox"
											onchange="toggleLivreaudioFavoriteState(this)"
											style="display:none;"
										>

										<i class="glyphicon {% if isFavorite %}glyphicon-star{% else %}glyphicon-star-empty{% endif %}" style="font-size:16px;color:#3087ce;"></i>
									</label>
								</div>
								<div class="livreaudio-action-item">
									<a data-bs-toggle="tooltip" data-bs-placement="top" {% if app.user.SupprimerLiveAudio == '0' %} disabled {% endif %} title="supprimer la chaîne"  href="{{path('supprimer_livreaudio',{'id':tele.id})}}"  class="btn btn-danger btn-sm" onclick="return confirm('Voulez-vous vraiment supprimer le Livre Audio : {{tele.nom}} ?')">
										<i class="glyphicon glyphicon-trash"></i>
									</a>
								</div>
							</td>
						</tr>
					{% endfor %}				
				</tbody>
			</table>

			<table class="table table-striped table-bordered table-hover table-livreaudio">
				<tbody>
					<tr>
						<!--le nom-->
						<td class="col-nom">
							<input {% if app.user.AjoutLiveAudio == '0' %} disabled {% endif %} form="ajouter_livreaudio_form" name='nom' type="text" value="" class="form-control form-control-sm" placeholder="Nom...">
						</td>

						<!--le nom du fichier -->
						<td class="col-fichier">
							<input {% if app.user.AjoutLiveAudio == '0' %} disabled {% endif %} form="ajouter_livreaudio_form" name='ip' class="form-control form-control-sm" placeholder="Fichier..."></input>
						</td>

						<!--la categorie-->
						<td class="col-categorie">
							<select {% if app.user.AjoutLiveAudio == '0' %} disabled {% endif %} form="ajouter_livreaudio_form" class="form-select form-select-sm" name='catlivreaudio'>								
								{% for a in categorielivreaudio %}      
								  <option value ='{{a.id}}'>{{a.nom|capitalize }}</option>
								  {% endfor %} 
							</select>
						</td>

						<!--l'icone-->

						<td class="col-icons">
							<div class="fileUpload" id="mainform0" >
								<img id="preview-0" style="width:50px;height:50px;" src="{{ asset('images/no_image.png') }}" alt="Logo" class="img-rounded img-responsive center-block">
								<input {% if app.user.AjoutLiveAudio == '0' %} disabled {% endif %} form="ajouter_livreaudio_form" id="0" type="file" class="upload" name="logo" accept=".jpg, .jpeg, .png"/>
							</div>

						</td>				
						<!--le status active-->
						<td class="col-active">
							<input {% if app.user.AjoutLiveAudio == '0' %} disabled {% endif %} form="ajouter_livreaudio_form" name='active' type="checkbox" class="jpCheckbox">
						</td>
						<!--l'action -->
						<td class="col-action">
							<div class="livreaudio-action-item">
								<label class="btn btn-warning btn-xs livreaudio-favori-toggle" style="margin-bottom:0; cursor:pointer;">
									<input {% if app.user.AjoutLiveAudio == '0' %} disabled {% endif %} form="ajouter_livreaudio_form" name='favoris' type="checkbox" value="1" class="livreaudio-favori-checkbox" onchange="toggleLivreaudioFavoriteState(this)" style="display:none;">
									<i class="glyphicon glyphicon-star-empty" style="font-size:16px;color:#3087ce;"></i>
								</label>
							</div>
							<div class="livreaudio-action-item">
								<button type="submit" form="ajouter_livreaudio_form" {% if app.user.AjoutLiveAudio == '0' %} disabled {% endif %} class="btn btn-info btn-sm">
									<i data-bs-toggle="tooltip" data-bs-placement="top" title="Ajouter un livre audio" class="glyphicon glyphicon-plus"></i>
								</button>
							</div>
						</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>
</form>

