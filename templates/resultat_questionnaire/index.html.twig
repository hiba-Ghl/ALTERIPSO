{% extends 'home/index.html.twig' %}
{% block body %}
<h1>Resultat <strong id="cat"> QUESTIONNAIRE</strong></h1>
<link rel="stylesheet" href="{{ asset('css/css_resultatQuest.css') }}">
<div class="div">
    <form method="get" action="{{ path('app_resultat_questionnaire') }}">
      <div class="container">
    {# partie de filtrage #}
    <table id="filtre">
    <tr class="date-row">
        <td>
            <div class="form-group">
                <label class="form-label" for="start_date">Date Début: </label>
                <input id="start_date" name="start_date" type="date" class="form-control" value="{{ startDate ? startDate|date('Y-m-d') : '2020-01-01' }}">
            </div>
        </td>
        <td>
            <div class="form-group">
                <label class="form-label" for="end_date">Date Fin: </label>
                <input id="end_date" name="end_date" type="date" class="form-control" value="{{ endDate ? endDate|date('Y-m-d') : 'now'|date('Y-m-d') }}">
            </div>
        </td>
        <td>
            <div class="form-group">
                <label class="form-label" for="chambre_id">Support ID:</label>
                <select id="chambre_id" class="form-control" name="chambre_id">
                    <option value="">Tous les chambres</option>
                    {% for chambre in chambres %}
                        <option value="{{ chambre.id }}" {{ selectedChambreId == chambre.id ? 'selected' : '' }}>
                            {{ chambre.nom }}
                        </option>
                    {% endfor %}
                </select>
            </div>
        </td>
          <td>
            <div class="form-group">
                <label class="form-label" for="service_id"> Service: </label>
                <select id="service_id" class="form-control" name="service_id">
                    <option value="">Tous les services</option>
                    {% for s in serviceetablissement %}
                        <option value="{{ s.id }}" {{ selectedServiceId == s.id ? 'selected' : '' }}>
                            {{ s.nom }}
                        </option>
                    {% endfor %}
                </select>
            </div>
        </td>
    </tr>

    <tr class="button-row">
        <td colspan="2">
            <div class="form-group">
                <button data-toggle="tooltip" data-placement="top" class="btn btn-sm btn-primary" type="submit" name="search-button" id="search-button"><span class="desktop-text">Rechercher </span><i class="glyphicon glyphicon-search"></i></button>                   
                        <button id="printPdfBtn" class="btn btn-sm btn-warning"><i class="glyphicon glyphicon-print"></i><span class="desktop-text"> Imprimer</span></button>
                        <button id="exportPdfBtn" class="btn btn-sm btn-danger"><i class="glyphicon glyphicon-file"></i><span class="desktop-text"> PDF</span></button>
                        <button id="exportExcelBtn" class="btn btn-sm btn-success"><i class="glyphicon glyphicon-list-alt"></i><span class="desktop-text"> Excel</span></button>
            </div>
        </td>
    </tr>
</table>
</div>
    {# partie d'affichage #}
       <h3 id="titre">
            Les statistiques du questionnaire
             {% if startDate and endDate %}
                du {{ startDate|date('Y-m-d') }} au {{ endDate|date('Y-m-d') }}
            {% endif %}
            {% if selectedServiceId %}
                {% set selectedService = serviceetablissement|filter(service => service.id == selectedServiceId)|first %}
                pour le service {{ selectedService.nom }}
            {% else %}
                pour tous les services
            {% endif %}
            {% if selectedChambreId %}
                {% set selectedChambre = chambres|filter(chambre => chambre.id == selectedChambreId)|first %}
                et le support {{ selectedChambre.nom }}
            {% else %}
                et tous les supports
            {% endif %}
    </h3>
    <div class="table-container">
        <table class="table" id="example">
        <caption class="title"><h6>Statistiques de satisfaction par nombre de vote</h6></caption>
            <thead>
                <tr>
                    <th class="text-left">Questions</th>
                    <th data-title="Extrêmement satisfait"><img src="{{ asset('images/0.png') }}" alt="Extrêmement satisfait" title="Extrêmement satisfait"></th>
                    <th  data-title="Très satisfait"><img src="{{ asset('images/1.png') }}" alt="Très satisfait" title="Très satisfait"></th>
                    <th  data-title="Satisfait"><img src="{{ asset('images/2.png') }}" alt="Satisfait" title="Satisfait"></th>
                    <th  data-title="Mécontent"><img src="{{ asset('images/3.png') }}" alt="Mécontent" title="Mécontent"></th>
                    <th  data-title="Très Mécontent"><img src="{{ asset('images/4.png') }}" alt="Très mécontent" title="Très mécontent"></th>

                </tr>
            </thead>
            <tbody>                 
              {% for questionnaire in questionnaires %}
                    <tr class="questionnaire-row" data-service="{{ questionnaire.service.id }}">
                    <!-- Afficher la question en français -->
                    <td class="text-left" >{{ questionnaire.fr }}</td>
                    <!-- Récupérer les votes pour le questionnaire actuel -->
                    {% set votes = voteCounts[questionnaire.id] ?? [0, 0, 0, 0, 0] %}
                    <!-- Afficher le nombre de votes pour chaque niveau de satisfaction -->
                        <td>{{ votes[0] }}</td>
                        <td>{{ votes[1] }}</td>
                        <td>{{ votes[2] }}</td>
                        <td>{{ votes[3] }}</td>
                        <td>{{ votes[4] }}</td>
                    </tr>
                    {% endfor %}
                
            </tbody>
        </table>
        </div>
    </form>
</div>
 <!-- Hidden table for printing -->
        <div id="printableArea" class="printable-area">
            <h3>
                Les statistiques du questionnaire
                Les statistiques du questionnaire
                {% if startDate and endDate %}
                    du {{ startDate|date('Y-m-d') }} au {{ endDate|date('Y-m-d') }}
                {% endif %}
                {% if selectedServiceId %}
