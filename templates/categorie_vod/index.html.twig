{% extends 'home/index.html.twig' %}

{% block body %}
<style>
    #div2 {
        border-radius: 25px;
        border: 2px solid #3087ce;
        padding: 20px;
        display: flex;
        background-color: white;
        margin: 10px -30px;
        flex-direction: column;
    }

   table {
    width: 100%;
    border-collapse: collapse;
}

thead {
    background-color: #f2f2f2;
    position: sticky;
    top: 0;
    z-index: 2;
}

tbody {
    display: block;
    max-height: 360px; 
    overflow-y: auto;
}

tr {
    display: table;
    width: 100%;
    table-layout: fixed;
}

    .alert{
        color: white;
        border-radius: 5px;
    }


</style>

<div style="border-radius: 8px;text-align: left;margin-bottom: 10px;margin-left: -30px;color: white;font-style: oblique;font-size: 20px;background-color: #3087ce;width: 250px;padding-left: 10px;">
    <img style="margin-top: -51px;margin-left: -10px;width: 45px;float: left;" src="{{ asset('images/ler.png') }}">
    Liste Catégorie VOD
</div>




<!-- la gestion des flash -->
 {% for label, messages in app.flashes %}
        <div class="alert alert-danger"> <!-- -{{ label }} -->
            {% for message in messages %}
                <p>{{ message }}</p>
            {% endfor %}
        </div>
    {% endfor %}




    <form name="form" action="{{ path('app_update_active_categorie_vod')}}" method="post" enctype="multipart/form-data">
        <a href="{{ path('app_ajouter_categorievod') }}" class="btn btn-info btn-sm" name="add" id="add" style="margin-bottom: 10px; margin-right: 5px;">
            <i class="glyphicon glyphicon-plus"></i>
            Ajouter Catégorie VOD
        </a>

        <button type="submit"  name="valider" class="btn btn-primary btn-sm" style=" margin-bottom: 10px;border: 2px; padding:8px; margin-right: 5px;">
            <i class="glyphicon glyphicon-floppy-disk"></i>
            Enregistrer
        </button>

        <a name="annuler" href="{{ path('app_categorie_vod') }}" class="btn btn-danger btn-sm" style=" margin-bottom: 10px;border: 2px; padding:8px;">
            <i class="glyphicon glyphicon-remove"></i>
            Annuler
        </a>


      <div id="div2">
        <div class="table-container">
        <table class="table table-striped table-bordered table-hover table-checkable order-column" id="sample_1">
            
            
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Logo</th>
                    <th ><input type="checkbox" id="checklist" style="margin-right: 10px;">Active</th>
                    <th>Position</th>
                    <th style="width:246px">Actions </th>
                </tr>
            </thead>


            <tbody >
                {% for catvod in categorie_v_o_ds %}
                    <tr class="odd gradeX">
                        <td>{{ catvod.nom|capitalize}}</td>
                        <td>
                            <img style="width:50px;height:50px;text-align:center" src="{{ asset(catvod.logo) }}" alt="..." class="img-rounded img-responsive center-block">
                        </td>
                        <!-- checkbox -->
                        {% set ch = '' %}
                        {% if catvod.active == 1 %}
                            {% set ch = 'checked' %}
                        {% endif %}
                        <td >
                            <label><input name="listeactive[{{ catvod.id }}]" type="checkbox" {{ ch }} class="jpCheckbox"></label>
                        </td>
                        <td>{{ catvod.position }}</td>
                        <td>
                            <a data-toggle="tooltip" data-placement="top" title="Modifier Catégorie VOD" href="{{ path('app_modifier_categorievod', { 'id': catvod.id }) }}" class="btn btn-warning btn-xs">
                                <i class="glyphicon glyphicon-pencil"></i>
                            </a>
                            <a data-toggle="tooltip" data-placement="top" title="Supprimer Catégorie VOD" href="{{ path('app_supprimer_categorievod', { 'id': catvod.id }) }}" class="btn btn-danger btn-xs" onclick="return confirm('Voulez-vous vraiment supprimer la catégorie VOD : {{ catvod.nom }} ?')">
                                <i class="glyphicon glyphicon-trash"></i>
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5">No records found</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
       </div>  
    </form>


<!-- Script pour cocher ou décocher toutes les cases à cocher -->
<script>
    document.getElementById('checklist').addEventListener('click', function() {
        var checkboxes = document.querySelectorAll('input.jpCheckbox');
        for (var checkbox of checkboxes) {
            checkbox.checked = this.checked;
        }
    });

</script>
<script>
    $(document).ready(function(){
        // Initialize tooltips for all buttons
        $('[data-toggle="tooltip"]').tooltip();
    });
</script>



{% endblock %}
