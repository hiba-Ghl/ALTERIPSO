<script>

document.addEventListener("DOMContentLoaded", function() {
    // Récupère les éléments du formulaire pour les mots de passe et le message d'erreur
    var passwordInput = document.getElementById('fos_user_registration_form_plainPassword_first');
    var confirmPasswordInput = document.getElementById('fos_user_registration_form_plainPassword_second');
    var passwordError = document.getElementById('passwordError');

    // Fonction pour valider la correspondance des mots de passe
    function validatePassword() {
        // Vérifie si les valeurs des champs de mot de passe sont différentes
        if (passwordInput.value !== confirmPasswordInput.value) {
            // Affiche le message d'erreur si les mots de passe ne correspondent pas
            passwordError.style.display = 'block';
        } else {
            // Masque le message d'erreur si les mots de passe correspondent
            passwordError.style.display = 'none';
        }
    }

    // Fonction qui semble être redondante et inutile dans ce contexte
    function validateOnInput() {
        // Vérifie si le message d'erreur est actuellement affiché
        if (passwordError.style.display === 'block') {
            // Appelle la fonction de validation des mots de passe si le message d'erreur est affiché
            validatePassword();
        }
    }

    // Ajoute un écouteur d'événement pour détecter les saisies dans le champ de confirmation du mot de passe
    confirmPasswordInput.addEventListener('input', validatePassword);
});

</script>

