{% extends 'home/index.html.twig' %}

{% block body %}

<link rel="stylesheet" href="{{ asset('css/css_servicePayant.css?v=' ~ random()) }}">

<div id="header">
    <img id="header_img" src="{{ asset('images/ler.png') }}" alt="Services">
    Services Payants
</div>

<div id="div2">
    <form action="" method="post" enctype="multipart/form-data">

        <input type="file" name="file" id="file" class="upload" accept=".pdf" /> <br> 
        <label>Seul les fichiers pdf peuvent être téléchargés</label>

        <div>
            <button type="submit" {% if app.user.SauvgarderServicePayant == '0' %} disabled {% endif %} name="valider" class="btn btn-success btn-sm btn-action">
                <i class="glyphicon glyphicon-floppy-disk"></i>
                Sauvegarder
            </button>

            <a name="annuler" class="btn btn-danger btn-sm btn-action" href="/home">
                <i class="glyphicon glyphicon-remove"></i>
                Annuler
            </a>
        </div>

        <div id="pdf-container">
            <object data="{{path('afficher_image',{ filename: package |split('/')|last, directory: 'service_payant_directory' })}}" type="application/pdf">
                <p>Impossible d'afficher le fichier PDF. Vous pouvez le <a href="{{path('afficher_image',{ filename: package |split('/')|last, directory: 'service_payant_directory' })}}">télécharger ici</a>.</p>
            </object>
        </div>

    </form>
</div>

{% endblock %}