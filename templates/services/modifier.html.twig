{# cette page pour modifier un service #}
{% extends 'home/index.html.twig' %}
{# ####################################################################################### #}
{# Cette section concerne la conception de modèles pour la modification d'un service.#}
{% block body %}
<link rel="stylesheet" href="{{ asset('css/css_service.css') }}">
{# offline #}
{% if appConfig.StatusServeur is same as('Offline') %}

<script src="{{ asset('javascript/all.min.js') }}"></script>
{% else %}
{# online #}
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/js/all.min.js"></script>

{% endif %}
<div class="md-header-title">
    <img class="md-header-icon" src="{{ asset('images/ler.png') }}">
    Mise à jour Service
</div>
<div class="div2">
    <form id="form" class="form" action="{{ path('update_service', {'id': service.id}) }}" onsubmit="return validateForm(false)" method="post" enctype="multipart/form-data">
        <div class="div1">
            <div class="col-md-4">
                <img src="{{ path('afficher_image', { filename: service.logo|split('/')|last, directory: 'services_directory' }) }}" class="img image-thumbnail" alt="Aucune image disponible" id="img"/>
            </div>
            <div class="col-md-4 div">
                <div id="divNom">
                    <label class="control-label">Nom de Service</label>
                    <input type="text" id="nom_service" class="form-control test" name="nom" value="{{service.nom}}"/>
                </div>
                <div class="form-group md-form-group-icon">
                    <button type="button" class="btn btn-success btn btn-sm" data-toggle="modal" id="ajoute">
                     Choisissez un icone
                </button>
                </div>
                    <div>
                    <label class="control-label">Position</label>
                    <select id="service_position" class="form-control test" name="service_position" value="{{service.position}}">
                        <option style="display:none">{{service.position}}</option>
                    </select>
                    </div>
                    <div>
                    <label class="control-label">Active</label>
                    <select id="service_active" class="form-control test" name="active" value="{{service.active}}">
                        <option value='1' {% if service.active == '1' %}selected{% endif %}>Oui</option>
                        <option value='0' {% if service.active == '0' %}selected {% endif %}>Non</option>
                    </select>
                    </div>
                     <div class="md-translate-row">
                 <div class="form-group">
                    <button type="button" class="btn btn-info"  id ="test" >
                        Traduire le service
                    </button>
                </div>
                 <a type="button" class="accordion-toggle" data-toggle="collapse" data-parent="#accordion" href="#collapseTwo">
                        <span><i class="glyphicon glyphicon-plus"></i></span>
                </a>
                </div>
                    <div id="collapseTwo" class="panel-collapse collapse">
                        <div class="panel-body md-panel-body-traduction">
                            <table class="table md-table-traduction">
                                <tr>
                                    <td>
                                        <img class="md-flag-img" src="{{ asset('images/eng.png') }}">
                                        <label class="control-label required" for="EN">English</label>
                                        <input  type="text" id="EN" name="EN" class="form-control" value="{{service.En}}">
                                    </td>
                                    <td>
                                        <img class="md-flag-img" src="{{ asset('images/es.png') }}">
                                        <label class="control-label required" for="ES">Espagnol</label>
                                        <input  type="text" id="ES" name="ES" class="form-control" value="{{service.Es}}">
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <img class="md-flag-img" src="{{ asset('images/pt.png') }}">
                                        <label class="control-label required" for="PT">Portugues</label>
                                        <input  type="text" id="PT" name="PT" class="form-control" value="{{service.Pt}}">
                                    </td>
                                    <td>
                                        <img class="md-flag-img" src="{{ asset('images/ita.png') }}">
                                        <label class="control-label required" for="IT">Italiano</label>
                                            <input  type="text" id="IT" name="IT" class="form-control" value="{{service.It}}">
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <img class="md-flag-img" src="{{ asset('images/rus.png') }}">
                                        <label class="control-label required" for="RU">Russian</label>
                                        <input  type="text" id="RU" name="RU" class="form-control" value="{{service.Ru}}">
                                    </td>
                                    <td>
                                        <img class="md-flag-img" src="{{ asset('images/deu.png') }}">
                                        <label class="control-label required" for="DE">Deutsch</label>
                                        <input  type="text" id="DE" name="DE" class="form-control" value="{{service.De}}">
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <img class="md-flag-img" src="{{ asset('images/ch.png') }}">
                                        <label class="control-label required" for="ZH">China</label>
                                        <input  type="text" id="ZH" name="ZH" class="form-control" value="{{service.Zh}}">
                                    </td>
                                    <td>
                                        <img class="md-flag-img" src="{{ asset('images/ma.png') }}">
                                        <label class="control-label required" for="AR">العربية</label>
                                        <input  type="text" id="AR" name="AR"  class="form-control" value="{{service.Ar}}">
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
            </div>
            <div class="col-md-4 div" id="diapo">
                    <div>
                    
                        <label class="control-label">Type:</label>
                        <select id="service_type" name="service_type" class="form-control test" value={{service.type}}>
                            <option value={{service.type}} style="display: none;">
                            <option value="DIAPO" {% if service.type == 'DIAPO' %}selected {% endif %}>DIAPO</option>
                            <option value="IMAGE" {% if service.type == 'IMAGE' %}selected {% endif %}>IMAGE</option>
                            <option value="PDF" {% if service.type == 'PDF' %}selected{% endif %}>PDF</option>
                            <option value="URL" {% if service.type == 'URL' %}selected {% endif %}>URL</option>
                            <option value="VIDEO" {% if service.type == 'VIDEO' %}selected {% endif %}>VIDEO</option>
                        </select>
                    </div>
                    <div class="md-div-file" id="divFile">
                        <input type="file" id="service_src" name="service_src" class="form-control test" value="{{service.src}}">
                        <p id="fichier" style="display:none">{{service.src}}</p>
                    </div>
                    <div style="">
                        <label class="control-label">Description</label>
                        <textarea id="service_description" class="form-control test md-textarea-description" placholder="description" name="Description" value="{{service.description}}">{{service.description}}</textarea>
                    </div>
                 <div >
                    <label class="control-label">Service</label>
                    <select id="service_service" class="form-control test" name="service_service" value="{{categorie1}}">
                    <option value="{{ categorie1|capitalize }}" style="display: none;">
  {{categorie1|capitalize }}
</option>
                    </select>
                </div>               
            </div>
        </div>

        <div class="button">
            <button type="button" class="btn btn-danger mt-3 md-btn-action" onclick="window.location.href='{{ path('services_Categorie',{id: id_categorie}) }}'">
                <i class="glyphicon glyphicon-remove"></i> Annuler
            </button>
            <button type="submit" class="btn btn-primary mt-3 md-btn-action">
                <i class="glyphicon glyphicon-floppy-disk"></i> Enregistrer
            </button>
        </div>
        
        </form>
</div>
