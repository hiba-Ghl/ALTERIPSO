{% extends 'home/index.html.twig' %}
{% block body %}
	<link rel="stylesheet" href="{{ asset('css/css_support.css') }}">

<p id='p'></p>
<div class="support-titre">
<img src="{{ asset('images/ler.png') }}">
		Liste Support Connecté
</div>
	<div id="div2">
	<div class="support-actions">
	<div>
		<button type="button" class="btn btn-info btn-sm" {% if app.user.AjouteServiceEtablissement == '0' %} disabled {% endif %} data-toggle="modal" data-target="#exampleModal"><i class="glyphicon glyphicon-plus"></i>
			Ajouter Service Etablissement
		</button>

		{% set nb =  chambres|length %}
		{% if nb >= etablissement.licence  %}
			<a href="" class="btn btn-info btn-sm" name="add" id="add" {% if app.user.AjouteSupport == '0' %} disabled {% endif %}>
				<i class="glyphicon glyphicon-plus"></i>
				Ajouter support
			</a>
			<div class="licence-warning">
				<i class="glyphicon glyphicon-warning-sign"></i>-vous n'avez pas assez de licences, pour ajouter un support merci d'envoyer un email à : contact@alteripso.com
			</div>
		{% else %}
				<a href="{{path('app_ajouter_chambre')}}" class="btn btn-info btn-sm" name="add" id="add" {% if app.user.AjouteSupport == '0' %} disabled {% endif %}>
					<i class="glyphicon glyphicon-plus"></i>
					Ajouter support</a>
				<br>
		{% endif %}
		<B>Nombre de  licence &nbsp;&nbsp;:
			{{etablissement.licence}}
		</B><br>
		<B>Nombre de Support :
			{{nb}}
	</div>
	<div>
		<button type="button" class="btn btn-success btn-sm" data-toggle="modal" data-target="#myModal" {% if not app.user.CheckSupport %} disabled {% endif %}>
			<i class="glyphicon glyphicon-log-in"></i>
			Check-in/Check-out
		</button>
	</div>
	</div>
		<div class="extraction-label">Choisissez le modèle d'extraction de données:</div>
		<div class="modnt"></div>
		<div id="myDiv">

		<div class="dataTables_filter support-filter">
		<label>Recherche par service:</label>
		<select onchange="getval2(this)" id="form_Active" name="selectservices">
			{% for s in serviceetablissement %}
				<option value="{{s.nom}}">{{s.nom|upper}}</option>
			{% endfor %}
		</select>
		</div>
			<!--<table class="table table-striped table-bordered table-hover" id="dataTables-example">-->
    <table class="table table-striped header-fixed table-bordered table-hover table-checkable order-column support-table" id="dataTables-example" role="none">
				<thead>

					<tr>
						<th class="col-identifiant">Identifiant support</th>
						<th class="col-connexion">Connexion</th>
						<th class="col-ip">Ip</th>
						<!--<th>Support connecté</th>-->
						<th class="col-modele">Modèle TV</th>
						<th class="col-date">Date Mise à jour</th>
						<th class="col-etage">Etage</th>
						<th class="col-service">Service</th>
						<th class="col-droit">Droit TV</th>
						<th class="col-affichage">Type Affichage</th>
						<th class="col-fond">Fond d'écran</th>
						<th class="col-actions">Actions</th>


					</tr>
				</thead>

				<tbody>
					{% set i=0 %}

					{% for box in chambres %}


						<tr class="odd gradeX">
							<td class="td-identifiant">{{box.nom}}</td>




							<!--<td class="{#{i}#}"></td>-->

							{% if ar[i] == 0 %} 


							<td class="td-connexion"><p><i class="glyphicon glyphicon-stop status-off"></i> OFF</p></td>

							{% else %} 

							<td class="td-connexion"><p><i class="glyphicon glyphicon-stop status-on"></i> ON </p></td>


							{% endif  %} 


							<td class="td-ip">{{box.Ip}}</td>


							<!--<td>{{box.Support}}</td>-->

							<td class="td-modele">{{box.type}}</td>
							<td class="td-date">{{box.date}}</td>
							<td class="td-etage">{{box.etage}}</td>
							<td class="td-service">{{box.service.nom|capitalize}}</td>
							{% if (box.checkval) == 1 %}
								<td class="td-droit checkin-status">Check-in</td>
							{% else %}
								<td class="td-droit checkout-status">Check-out
								</td>
							{% endif %}


							{% if (box.typeaffichage) == 1 %}
								<td class="td-affichage">Alteripso</td>
							{% else %}
								<td class="td-affichage">Dynamique
									<br><div class="chaine-dynamique">
										({{box.chaine.nom}})
									</div>
								</td>
							{% endif %}


							<td class="td-fond">
								{% if (box.background) == '' %}
									<i class="glyphicon glyphicon-remove status-off"></i>
								{% elseif ( '.mp4' in box.background ) %}
									Vidéo
								{% else %}
								<img class="fond-ecran-img img-rounded img-responsive center-block" src="{{ path('afficher_image', { filename: box.background|split('/')|last, directory: 'etablissement_directory' }) }}" alt="...">

									{# <img class="fond-ecran-img img-rounded img-responsive center-block" src="{{ asset('images/'~box.background) }}" alt="..."> #}
								{% endif %}
							</td>


<td class="td-actions">
	<a data-toggle="tooltip" data-placement="top"  {% if app.user.RedimarerSupport == '0' %} disabled {% endif %} title="redémarrer le support" href="{{path('app_redemarrer',{'id':box.id})}}"   class="reboot btn btn-info btn-xs">
		<i class="glyphicon glyphicon-refresh"></i>
	</a>
	<a data-toggle="tooltip" data-placement="top"  {% if app.user.SupprimerSupport == '0'  %} disabled {% endif %} title="supprimer le support" id="" href="{{path('app_supprimer_chambre',{'id':box.id})}}" class="ida btn btn-danger btn-xs" onclick="return confirm('Voulez-vous vraiment supprimer la chambre : {{box.nom}} ?')">
		<i class="glyphicon glyphicon-trash"></i>
	</a>
	<a data-toggle="tooltip" data-placement="top"  {% if app.user.ModifierSupport == '0'  %} disabled {% endif %} title="Modifier le support" id="ida" href="{{path('app_modifier_chambre',{'id':box.id})}}" class="btn btn-warning btn-xs">
		<i class="glyphicon glyphicon-edit"></i>
	</a>
</td>

						</tr>
						{% set i=i+1 %}

						{% endfor %}

					</tbody>
				</tbody>
			</table>

		</div>


		<!-- fin div2-->


	</div>
	<br>
	<!-- Modals -->
	<!-- Modal ajout service etablissement -->		
	<div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
		<form action="{{path('app_ajouter_service_etablissement')}}" name="form" method="post" enctype="multipart/form-data">
		<div class="modal-dialog" role="document">
		<div class="modal-content">
			<div class="modal-header">
			<h5 class="modal-title" id="exampleModalLabel">Ajouter Service Etablissement</h5>
			<button type="button" class="close" data-dismiss="modal" aria-label="Close">
				<span aria-hidden="true">&times;</span>
			</button>
			</div>
			<div class="modal-body">
				<div class="form-group">
					<label  class="col-lg-2 control-label">Nom Service</label>
					<div class="col-lg-10">
		
						<input type="text" id="nom" name="nom" class="form-control"/>
		
					</div>
					<br><br>
				</div>
			</div>
			<div class="modal-footer">
				<button id='' type="submit" class="btn btn-primary " name="">
					<i class="glyphicon glyphicon-floppy-disk"></i>Valider</button>

				<button type="button" class="btn btn-danger" data-dismiss="modal">
					<i class="glyphicon glyphicon-remove"></i>Annuler</button>
			</div>
		</div>
		</div>
		</form>
	</div>
	<!-- Modal -->
		<div id="myModal" class="modal fade" role="dialog"> 
			<form action="{{path('app_checkin')}}" name="form" method="post" enctype="multipart/form-data">
			<div
				class="modal-dialog">

				<!-- Modal content-->
				<div class="modal-content">

					<div class="modal-header">
						<button type="button" class="close" data-dismiss="modal">&times;</button>


					</button>
					<h4 class="modal-title">Veuillez choisir une option:</h4>


					<p></p>


					<input type="radio" name="etatcheckin" value="checkin" class="etatcheckin">
					<label class="checkin-status">Check-in</label>
					<br>
					<input type="radio" name="etatcheckin" value="checkout" class="etatcheckin">
					<label class="checkout-status">Check-out</label>
				</div>
				<div
					class="modal-body">
					<!-- -->
					<label>
						Recherche par service : &nbsp;&nbsp;&nbsp;
					</label>
					<select class="form-control modal-search-select" onchange="getval(this);" name="selectservices">
						<option selected value="">Tous les services</option>
						{% for s in serviceetablissement %}
							<option value="{{s.nom}}">{{s.nom|upper}}</option>
						{% endfor %}
					</select>
					<br>
					<label>
						Recherche du support : &nbsp;&nbsp;&nbsp;
					</label>
					<input id="myInput" type="text" placeholder="Search.." class="form-control modal-search-input">

					<div class="modal-scroll-container">
						<br><br>
						<!--<table class="table table-striped table-bordered table-hover" id="dataTables-example">-->
						<table id="example20" class="table table-striped table-bordered table-hover">
							<thead>
								<tr>
									<th>
										<input type="checkbox" id="checkAllboxnx">
										Sélectionner</th>
									<th>
										Chambre</th>
									<th>
										IP</th>
									<th>
										Service</th>
								</tr>
							</thead>
							<tbody id="myTable">
								{% for box in chambres %}
									<tr>
										<td>
											<label class="labelbox"><input data-boxid='{{box.etage}}' class='boxchecke' name='box[{{box.Id}}]' type="checkbox">
												{{box.nom}}</label>
										</td>
										<td>
											{{box.etage}}</td>
										<td>
											{{box.ip}}</td>
										<td>{{box.service.nom|capitalize}}</td>
									</tr>
									<tr>{% endfor%}
									</tr>
								</tbody>
							</tbody>
						</table>
					</div>

					<!-- -->


				</div>
				<div class="modal-footer">


					<button id='' type="submit" class="btn btn-primary " name="">
						<i class="glyphicon glyphicon-floppy-disk"></i>Valider</button>

					<button type="button" class="btn btn-danger" data-dismiss="modal">
						<i class="glyphicon glyphicon-remove"></i>Annuler</button>


				</div>
				</div>
			</form>

		</div>
{# offline #}
{% if appConfig.StatusServeur is same as('Offline') %}
  <script src="{{ asset('javascript/jszip.min.js') }}"></script>
<script src="{{ asset('javascript/pdfmake.min.js') }}"></script>
