{% extends 'home/index.html.twig' %}
{% block body %}
 <script src="{{asset('javascript/jquery.min.js')}}"> </script>

<script >
$('.dt-buttons').after('<hr>')
</script>

<h1><strong id="cat"> Messages personnels </strong></h1><hr>
<br>


{% if app.request.get('msg') is defined %}
{% if app.request.get('msg') ==1 %}
    


<div class="alert alert-success alert-dismissible fade in" role="alert"> <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">×</span></button> <strong><i class='glyphicon glyphicon-thumbs-up' ></i> votre message</strong> a été envoyé avec succès </div>




{% endif %}
{% endif %}





<form action="{{ path('app_envoyer_message_chambre')}}" method="post">

<div class="col-md-12">


<div class="form-group">
<label for="exampleInputPassword1">Ecrire votre message (max 120 caractères)</label>
<input maxlength="120" required class="form-control" name="Question">
</div>

</div>

<div class="col-md-12" style="margin-bottom:30px">

<div class="form-group">




<button type="submit" id="envoyer" name="valider" class="btn-primary btn btn-sm"><i class="glyphicon glyphicon-comment"></i> Envoyer message aux chambres sélectionnées</button>

</div>

<hr>
<div class="col-md-8" >
</div>


<div class="col-md-12" margin-buttom:25px>




  <!--<table class="table table-striped header-fixed table-bordered table-hover table-checkable order-column" id="dataTables-example">-->

 <table class="table table-striped table-bordered table-hover header-fixed" id="dataTables-example">
<thead> 

<tr>
<th  style="height: 50px;width: 100px;" > <input  type="checkbox"  id="checkAll" >   Selectionner</th>

<th style="">Connexion</th>
<th style="">Ip</th>
<th style="">Support connecté</th>
<th style="">Type</th>
<th style="">Date Mise à jour</th>
<th style="">Chambre</th>
<th style="">Service</th>

</tr>
</thead> 

<tbody>
    {% set i=0 %}
    {% for box in boxs %}

<tr class="odd gradeX">


<td style="" >
<label >

<input class='arch' name='list[{{box.Id}}]' type="checkbox"  >

</label>
{{box.nom}}
</td>



{% if ar[i] == 0 %} 


<td><p style="text-align: center;" ><i style="color:red;" class="glyphicon glyphicon-stop"></i> OFF</p></td>

 {% else %} 

 <td><p style="text-align: center;" ><i style="color:green;" class="glyphicon glyphicon-stop"></i> ON </p></td>


 {% endif  %} 

<td style="">{{box.Ip}}</td>


<td style="">{{box.Support}}</td>
<td style="">{{box.type}}</td>
<td style="">{{box.date}}</td>
<td style="">{{box.Etage}}</td>
<td style="">{{box.service.nom|capitalize}}</td>







</tr>

{% set i=i+1 %}
{% endfor %}


</tbody>

</table>


<div class="form-group">


</div>

</div>




</form>

<script type="text/javascript">
  


$(function () {
    $('#envoyer').click(function(){
       if ($(".arch:input:checkbox:checked").length == 0) 
 {
alert(' vous n\'avez selectionner aucun support impossible d\'envoyer le message');
return false;
 }
 else
       
            $.toast('<i class="glyphicon glyphicon-fire"></i> envoie en cours ...', {'align': 'top','type': 'success'});
  
    });
});

$(document).ready(function() {
 


$('.arch').click(function() {
 
   if(this.checked){ // si 'checkAll' est coché
$(this).parent('label').children('i').text(1);

   }else{ // si on décoche 'checkAll'
$(this).parent('label').children('i').text('xxx');
   }          
});
//-->

$('#checkAll').click(function() {
 
// on cherche les checkbox à l'intérieur de l'id  'magazine'
var magazines = $("label").find(':checkbox'); 
   if(this.checked){ // si 'checkAll' est coché
      magazines.prop('checked', true); 
   }else{ // si on décoche 'checkAll'
      magazines.prop('checked', false);
   }          
});
//-->
$('.dt-buttons').after('<hr>');




    });
    
</script>

{% endblock %}


