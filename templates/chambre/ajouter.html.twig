{% extends 'home/index.html.twig' %}
{% block body %}
<style>
    #div2 {
			border-radius: 25px;
			border: 2px solid #3087ce;
			padding: 20px;
			width: 1300px;
			height: 500px;
			margin-left: -70px;
			margin-top: 10px;
			background-color: white;
		}
</style>


<div style="margin-top: -40px;position: absolute;border-radius: 8px;text-align: left;margin-left: -68px;color: white;font-style: oblique;font-size: 20px;background-color: #3087ce;width: 250px;padding-left: -27px;">
    Ajouter Support 
</div>

<div id="div2">


	
		<form action="{{path('app_ajouter_chambre')}}" method="post" enctype="multipart/form-data">


			<table style="width: 100%;">
				<tr>
					<td style="width: 33%;">
						<div class="control-label">
							<label  class=" control-label">Nom Support:
							</label>
							<input type="text" name="nom" class="form-control" style="width: 75%;">
						</div>

					</td>

					<td style="width: 33%;">
						<div class="control-label">
							<label class=" control-label">
								Support:
							</label>
							<select class="form-control" name="typesupport" id="typesupport" style="width: 75%;">
								<option selected="selected" value='Box-Ip'>Box-Ip</option>
								<option value='Samsung'>Samsung</option>
								<option value='Samsung Tizen'>Samsung Tizen
								</option>
								<option value='LG'>LG</option>
								<option value='Philips'>Philips</option>
								<option value='Box-Coax'>Box-Coax</option>
							</select>
						</div>

					</td>

					<td style="width: 33%;">
						<div class="control-label">
							<label  class=" control-label">Type:
							</label>


							<select class="form-control" name="type" id="type" style="width: 75%;">

								<option value='ip'>ip</option>
								<option value='coax'>coax</option>

							</select>
						</div>

					</td>


				</tr>
				
                <tr>

					<td style="width: 33%;">

						<div class="control-label">
							<label  class=" control-label">Mac:
							</label>
							<input type="text" name="mac" id="mac" class="form-control" style="width: 75%;" placeholder="xx:xx:xx:xx:xx:xx">
						</div>

					</td>

					<td style="width: 33%;">
						<div class="control-label">
							<label class=" control-label">Chambre:
							</label>
							<input type="text" name="etage" class="form-control" style="width: 75%;">
						</div>

					</td>

					<td style="width: 33%;">
						<div class="control-label">
							<label  class=" control-label">Ip:
							</label>
							<input type="text" name="ip" id="ip" class="form-control" style="width: 75%;" placeholder="127.0.0.1">
						</div>
					</td>

				</tr>
				
                <tr>

					<td style="width: 33%;">
						<div class="control-label">
							<label  class=" control-label">
								Service:
							</label>
							<select class="form-control" name="Service" id="Service" style="width: 75%;">
								<option selected="selected" value='1'>Géneral</option>
								{% for serv in serviceasc %}
									<option value="{{serv.id}}">{{serv.title|upper}}</option>
								{% endfor %}

							</select>
						</div>

					</td>
                    <td style="width: 33%;">
                        <div  class="control-label" >
                        <label    class=" control-label">Type d'affichage: </label><label class="glyphicon glyphicon-question-sign" title="
                            Règle :   

                    - Affichage Atreipso :
                    -> Fonctionnement normal

                    - Affichage dynamique
                        * cas checkout 
                        -> afficher la chaine interne en prio.
                        -> si pas de chaine interne affichage de la 1ere chaine gratuite.
                        -> si on clique sur return on revient sur l'interface alteripso

                        * cas checkin 
                        -> on peut changer la chaine (sans revenir sur l'interface alteripso)
                        -> si on clique sur return on revient sur l'interface alteripso
                        -> afficher la chaine choisi qq soit le bouquet

                        * tv en mode veille
                        -> dés qu'on la rallume elle se remet directement sur la chaine sélectionnée
                    "   data-placement="top" ></label>

                    <select name="typeaffichage" class="form-control typeaffichage" style="width: 75%;">
                    
                        <option selected="selected" value="1" >Alteripso</option>
                        <option  value="2" >Dynamique</option>
                    
                    </select>
                        </div>

                    </td>

                    <td style="width: 33%;" class="listechaine">
                        <div  class="control-label" >
                            <label  class=" control-label ">Liste chaines </label>

                    <select name="listechaine" class="form-control" style="width: 75%;">
                    
                    {% for ch in listechaine %}


                    <option  value="{{ch.id}}" >{{ch.nom}}</option>

                    {% endfor%}

                    </select>
                        </div>

                    </td>
				</tr>
				
                <tr>
					
							<td style="width: 33%;">
								<div class="control-label">
									<label  class=" control-label">
										Fond d'écran:
									</label>
									<br>

									{% for back in listback %}
									 {% if ( '.mp4' not in back ) %}
										<table>
											<tr>
												<td>
													<input type="radio" name="back" value="{{back}}">
												</td>
												<td>
												

													<img style="width:150px;height:100px;text-align:center;margin-left: 10px;" src="{{ asset('images/'~back) }}" alt="..." class="img-rounded img-responsive center-block">
											
												</td>
											</tr>
										</table>
										<br>
										{% else %}

										<table>
											<tr>
												<td>
													<input type="radio" name="back" value="{{back}}" checked> 
												</td>
												<td>
												

													Vidéo
											
												</td>
											</tr>
										</table>
										<br>

										{% endif %}
									{% endfor %}

								</div>

							</td>
					
				</tr>
			</table>

			<br>

			<button type="submit" class="button btn btn-primary btn-sm" style="margin-left:800px;" name="valider" onclick='return CheckForm();'>
				<i class="glyphicon glyphicon-floppy-disk"></i>
				Enregistrer
			</button>


		</form>

		<form method="POST" action="{{path('app_chambre')}}">
			<button type="submit" class="button btn btn-danger btn-sm" style="width: 103px;margin-left: 911px;margin-top: -57px;">
				<i class="glyphicon glyphicon-remove"></i>
				Annuler
			</button>
		</form>


	

</div>
<!-- Scripts -->
<script type="text/javascript">

$(window).load(function() {
   $(".listechaine").hide();
      });
  $(document).ready(function(){

       $(".typeaffichage").change(function(){
      az=this.value;
     if(az=='1'){
       $(".listechaine").hide();
       }

      else{
        $(".listechaine").show();
      
     
      }
    

   });
});

</script>
	<script>
		function CheckForm() {
var type = $("#type").val();
var msg = "";
if (type == 'Samsung' || type == 'LG' || type == 'Philips') {


if (!CheckIp("ip")) {
msg += "Merci d'Intoduire une adresse ip (format:127.0.0.1)";
}
if (msg != "") {
alert(msg);
return false;
}
}

if (type == 'Box-Coax' || type == 'Box-Ip') {
if (!CheckMac("mac")) {
msg += "Merci d'Intoduire une adresse Mac (format:AA:BB:CC:DD:EE:FF)";
}
if (msg != "") {
alert(msg);
return false;
}
}


return true;
}


function CheckIp(ObjId) {
Obj = document.getElementById(ObjId);
var reg = new RegExp("^([0-9]{1,3}\.){1,3}[0-9]{1,3}", "g");
// var reg=new RegExp("[0-9]{1,3}.[0-9]{1,3}.[0-9]{1,3}.[0-9]{1,3}:[0-9]{5}","g");
// [0-9]{3}.[0-9]{3}.[0-9]{3}.[0-9]{3}:[0-9]{5}


return reg.test(Obj.value)
}

function CheckMac(ObjId) {
Obj = document.getElementById(ObjId);
// var reg=new RegExp("^([0-9A-Fa-f]{2}[:]){5}([0-9A-Fa-f]{2})$");
var reg = new RegExp("^[a-fA-F0-9:]{17}|[a-fA-F0-9]{12}$");


return reg.test(Obj.value)
}
	</script>


{% endblock %}
