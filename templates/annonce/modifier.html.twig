                    <label for="text" class="control-label">Entrer un texte:</label>
                    <textarea class="form-control" name="text" id="text" rows="3" style="margin-bottom: 5px;margin-top: 5px;">{{ann.url}}</textarea>
                      
                                <!-- Font selection -->
                                <div id="fontSelection" style="display: none;" class="form-row">
                                    <!-- la police -->
                                    <div class="form-group col-md-4">
                                        <label for="font">Choisir une police:</label>
                                        <select id="font" name="font" class="form-control"  style="width:100%;" >
                                            <option value="{{ann.police}}">{{ann.police}}</option>
                                            <option value="">Sélectionner une police</option>
                                            <option value="Arial">Arial</option>
                                            <option value="Helvetica">Helvetica</option>
                                            <option value="Times New Roman">Times New Roman</option>
                                            <option value="Courier New">Courier New</option>
                                            <option value="Verdana">Verdana</option>
                                        </select>
                                    </div>
                                    <!-- la taille -->
                                    <div class="form-group col-md-4" style="margin-left:30px">
                                        <label for="fontSize">Choisir une taille:</label>
                                        <select id="fontSize" name="fontSize" class="form-control"  style="width:100%;" >
                                            <option value="{{ann.taille}}">{{ann.taille}}</option>
                                            <option value="">Sélectionner une taille (px)</option>
                                            <option value="12">12</option>
                                            <option value="14">14</option>
                                            <option value="16">16</option>
                                            <option value="18">18</option>
                                            <option value="20">20</option>
                                            <option value="22">22</option>
                                        </select>
                                    </div>
                                    <!-- le style -->
                                    <div class="form-group col-md-4" style="margin-left:30px"> 
                                            <label for="style">Choisir un style:</label>
                                            <select id="style" name="style" class="form-control" style="width:100%; ">
                                                    <option value="{{ann.style}}">{{ann.style}}</option>
                                                    <option value="">Sélectionner un style</option>
                                                    <option value="Gras">Gras</option>
                                                    <option value="Italique">Italique</option>
                                                    <option value="Souligné">Souligné</option>
                                                    <option value="Barré">Barré</option>
                                            </select>
                                    </div>
                                </div>
                </div>
      
