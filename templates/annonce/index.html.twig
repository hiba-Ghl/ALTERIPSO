  {% endif %} 

<link rel="stylesheet" href="{{ asset('css/css_annonce.css') }}">


<!--le title header-->
{% for message in app.flashes('warning') %}
    <div class="alert alert-warning">
        {{ message }}
    </div>
{% endfor %}
<div class="annonce-header">
    <img src="{{ asset('images/ler.png') }}">
    Gestion des Annonces
</div>
   
<!--le tableau-->
<form id="form" method="post" enctype="multipart/form-data" action="/annonce/update/">
<div id="div2">
<!--le bouton d'ajout-->
<div class="action-buttons">
<div>
<a href="{{ path('app_ajouter_annonce') }}" class="btn btn-info btn-sm" name="add" id="add" {% if app.user.AjouterAnnonce == '0' %} disabled {% endif %}>
            <i class="glyphicon glyphicon-plus"></i>
            Ajouter Annonce
        </a>
        <button id="sauv" type="submit" class="btn btn-success btn-sm " {% if app.user.SauvegarderAnnonce == '0' %} disabled {% endif %}>
					<i class="glyphicon glyphicon-floppy-disk"></i>
					Sauvegarder
				</button>
				  <a name="annuler" href="{{ path('app_annonce') }}" class="btn btn-danger btn-sm btn-annuler">
        <i class="glyphicon glyphicon-remove"></i>
        Annuler
    </a>
</div>
<!--la barre de recherche-->
</div>
 <table class="table table-striped table-bordered header-fixed table-hover table-annonces" id="dataTables-example">
    <thead> 
        <tr>
        <th class="cell-standard cell-narrow">Nom</th>
        <th class="cell-standard cell-narrow">Type</th>
        <th class="cell-standard cell-narrow">Active</th>
        <th class="cell-standard cell-narrow">Position</th>
        <th class="cell-standard cell-narrow">Date début</th>
        <th class="cell-standard cell-narrow">Date fin</th>
        <th class="cell-standard cell-narrow">Durée (secondes)</th>
        <th class="cell-standard cell-wide">Actions</th>
        </tr>
    </thead> 
    <tbody id="myTable">
        {% for annonce in annonces %}
            <tr class="odd gradeX" >
                <td class="cell-standard cell-medium" data-label="Nom">{{annonce.nom|capitalize}}</td>
                <td class="cell-standard cell-medium" data-label="Type">{{annonce.type}}</td>
                <td class="cell-standard cell-medium" data-label="Active">        
                <input id="active-{{annonce.Id}}" name="active[{{annonce.Id}}]" type="checkbox" {% if annonce.active == '1' %} checked {% endif %} value="1">
</td>
                <td class="cell-standard cell-medium" data-label="Position">{{annonce.position|capitalize}}</td>
                <td class="cell-standard cell-medium" data-label="Date début">{{annonce.datedebut}}</td>
                <td class="cell-standard cell-medium" data-label="Date fin">{{annonce.datefin}}</td>
                <td class="cell-standard cell-medium" data-label="Durée">{{annonce.duree}}</td>

                <td class="cell-actions" data-label="Actions">
                    <div>
                    <a   data-toggle="tooltip" data-placement="top" title="Modifier l'annonce " href="{{ path('app_modifier_annonce', { 'id': annonce.id }) }}" class="btn btn-warning btn-xs"  {% if app.user.ModifierAnnonce == '0' %}  disabled {% endif %}><i class="glyphicon glyphicon-edit"></i></a>									
                    </div>
                    <div data-toggle="modal"  data-target="#modal-{{annonce.id}}" data-position="{{ annonce.position }}" data-url="{{ annonce.url }}" data-type="{{ annonce.type }}" data-animation="{{ annonce.animation }}" data-couleur="{{ annonce.couleur }}" data-couleur-bande="{{ annonce.couleurBande }}" data-police="{{ annonce.police }}" data-taille="{{ annonce.taille }}" data-style="{{ annonce.style }}" data-vitesse="{{ annonce.vitesseDefilement }}" class="visualiser">
                        <a data-toggle="tooltip"  data-placement="top" title="Pré-visualiser l'annonce"   class="ida btn btn-primary btn-xs" ><i class="glyphicon glyphicon-blackboard"></i></a>
                    </div>
                    <div data-toggle="modal" data-target="#modal2-{{annonce.id}}" data-id ="{{annonce.id}}"  data-name="{{annonce.nom}}" class="lancer-button">
                        <a   data-toggle="tooltip" data-placement="top" title="Lancer l'annonce"  class="ida btn btn-info btn-xs" ><i class="glyphicon glyphicon-play-circle"></i></a>
                    </div>
                    <div data-toggle="modal" data-target="#modal3-{{annonce.id}}" data-id ="{{annonce.id}}" data-name="{{annonce.nom}}" class="arreter-button">
                        <a   data-toggle="tooltip" data-placement="top" title="Arreter l'annonce" class="ida btn btn-primary btn-xs" ><i class="glyphicon glyphicon-minus-sign"></i></a>
                    </div>
                    <div>
                         <a data-toggle="tooltip" data-placement="top" title="Journal"  href="{{path('app_journal_annonce', { 'id': annonce.id })}}" class=" ida btn btn-success btn-xs" ><i class="glyphicon glyphicon-list" ></i></a>
                    </div>

                    <div>
                    <a   data-toggle="tooltip" data-placement="top" title="Supprimer l'annonce" href="{{ path('app_supprimer_annonce', { 'id': annonce.id }) }}" class="ida btn btn-danger btn-xs" onClick="return(confirm('voullez vous vraiment supprimer cette annonce ?'));" {% if app.user.SuppAnnonce == '0' %} disabled {% endif %}><i class="glyphicon glyphicon-trash"></i></a>
                    </div>
                </td>
            </tr>
        {% endfor %}
    </tbody>

</table>

</div>
</form>
<script>

 $(document).ready(function () {
      $('#dataTables-example').DataTable({
         language: {
            search: "Recherche:",
            emptyTable: "Aucun Annonce disponible."
         },
         paging: false,
         searching: true,
         ordering: true,
         info: false,
         columnDefs: [{ orderable: false, targets: 3 }]
      });
   });

</script>


<script>
  const chambre = {{chambre | raw }};
  document.addEventListener('click', function (event) {
  const PrevisualiserButton = event.target.closest('.visualiser');
  console.log(PrevisualiserButton);
  if (!PrevisualiserButton) return;
  const position = PrevisualiserButton.getAttribute('data-position');
  const type = PrevisualiserButton.getAttribute('data-type');
  const url = PrevisualiserButton.getAttribute('data-url');
  
  const animation = PrevisualiserButton.getAttribute('data-animation') || 'scroll';
  const couleur = PrevisualiserButton.getAttribute('data-couleur') || '#FFFFFF';
  const couleurBande = PrevisualiserButton.getAttribute('data-couleur-bande') || '#FF0000';
  const police = PrevisualiserButton.getAttribute('data-police') || 'Arial';
  let taille = PrevisualiserButton.getAttribute('data-taille') || '20';
  if (!taille.includes('px')) taille += 'px';
  const style = PrevisualiserButton.getAttribute('data-style') || 'normal';
  const vitesseStr = PrevisualiserButton.getAttribute('data-vitesse') || '5';
  
  let vitesse = 5;
  switch (vitesseStr) {
      case 'tres_rapide': vitesse = 1; break;
      case 'rapide': vitesse = 3; break;
      case 'normal': vitesse = 5; break;
      case 'lent': vitesse = 7; break;
      case 'tres_lent': vitesse = 10; break;
      default: vitesse = parseInt(vitesseStr) || 5;
  }
  
  let animClass = 'ia-scroll'; // default
  if (animation === 'bounce') animClass = 'ia-bounce';
  else if (animation === 'scroll') animClass = 'ia-scroll';
  else if (animation === 'fade') animClass = 'ia-fade';
  else if (animation === 'snake') animClass = 'ia-snake';
  else if (animation === 'snake-wave') animClass = 'ia-snake-wave';
  else if (animation === 'snake-zigzag') animClass = 'ia-snake-zigzag';
  else if (animation === 'rotate') animClass = 'ia-rotate';
  else if (animation === 'zoom') animClass = 'ia-zoom';
  else if (animation === 'shake') animClass = 'ia-shake';
  else if (animation === 'rainbow') animClass = 'ia-rainbow';
  else if (animation === 'typing') animClass = 'ia-typing';

  const animStyle = `animation-duration:${vitesse}s;`;
  const textStyle = `color:${couleur};font-family:'${police}', sans-serif;font-size:${taille};font-style:${style.includes('italic')?'italic':'normal'};font-weight:${style.includes('bold')?'bold':'normal'};text-decoration:${style.includes('underline')?'underline':'none'};white-space:nowrap;display:inline-block;margin:0 10px;`;
  const bandeStyle = `background-color:${couleurBande};`;
  const innerHtml = `<span style="${textStyle}${animStyle}" class="${animClass}">${url}</span>`;

  const filename = url.split('/').pop();
  const finalUrl = `/images/${filename}/annonce_directory`;
  let content = '';
if (position === "Bas") {
  if (type === "Image") {
    content = `<img style="position:absolute;left:38%;bottom:10%;width:150px;height:150px" src="${finalUrl}" />`;
  } else if (type === "Message défilant") {
    content = `<div style="position:absolute;right:0;bottom:8%;width:100%;overflow:hidden;text-align:center;${bandeStyle}">${innerHtml}</div>`;
  } else if (type === "Message") {
    content = `<p style="position:absolute;right:48%;bottom:8%;color:white;background-color:red;">${url}</p>`;
  } else {
    content = `<object data="${finalUrl}" type="application/pdf" style="position:absolute;left:38%;bottom:10%;width:150px;height:150px"></object>`;
  }
} else if (position === "Haut") {
  if (type === "Image") {
    content = `<img style="position:absolute;right:38%;top:2%;width:150px;height:150px" src="${finalUrl}" />`;
  } else if (type === "Message défilant") {
    content = `<div style="position:absolute;right:0;top:4%;width:100%;overflow:hidden;text-align:center;${bandeStyle}">${innerHtml}</div>`;
  } else if (type === "Message") {
    content = `<p style="position:absolute;right:48%;top:4%;color:white;background-color:red;">${url}</p>`;
  } else {
    content = `<object data="${finalUrl}" type="application/pdf" style="position:absolute;right:38%;top:2%;width:150px;height:150px"></object>`;
  }
}
 else if (position === "Gauche") {
  if (type === "Image") {
    content = `<img style ="position:absolute;left:2%;  top:25%;width:150px;height:150px" src="${finalUrl}" />`;
  } else if (type === "Message défilant") {
    content = `<div style="position:absolute;left:2%;top:45%;width:40%;max-width:200px;overflow:hidden;text-align:center;${bandeStyle}">${innerHtml}</div>`;
  } else if (type === "Message") {
    content = `<p style="position:absolute;left:2%;top:45%;color:white;background-color:red;">${url}</p>`;
  } else {
    content = `<object data="${finalUrl}" type="application/pdf" style ="position:absolute;left:2%;  top:25%;width:150px;height:150px"></object>`;
  }
}
 else if (position === "Droite") {
  if (type === "Image") {
    content = `<img style ="position:absolute;right:2%;  top:25%;width:150px;height:150px" src="${finalUrl}" />`;
  } else if (type === "Message défilant") {
    content = `<div style="position:absolute;right:5%;top:45%;width:40%;max-width:200px;overflow:hidden;text-align:center;${bandeStyle}">${innerHtml}</div>`;
  } else if (type === "Message") {
    content = `<p style="position:absolute;right:5%;top:45%;color:white;background-color:red;">${url}</p>`;
  } else {
    content = `<object data="${finalUrl}" type="application/pdf" style ="position:absolute;right:10%;  top:25%;width:150px;height:150px"></object>`;
  }
}
else 
{
    content = `<object data="${finalUrl}" type="application/pdf" style ="position:absolute; top:10%;left:20%;width:350px;height:250px" >
                    </object>`;

}
  if (PrevisualiserButton.getAttribute("data-target")) {
    const index = PrevisualiserButton.getAttribute("data-target").split('-')[1];
    const body = document.getElementById('div2');

    const popUP = document.createElement('div');
    popUP.setAttribute("class", "modal fade modal-popup");
    popUP.setAttribute("tabindex", "-1");
    popUP.setAttribute("role", "dialog");
    popUP.setAttribute("id", `modal-${index}`);
    popUP.setAttribute("aria-labelledby", "modalLabel1");
    popUP.setAttribute("aria-hidden", "true");

    popUP.innerHTML = `
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header">
            <button id="close" type="button" class="close close3" data-dismiss="modal-${index}" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
          <h4 class="modal-title" style="color: grey;">Pré-visualisation</h4>
        </div>
        <div class="modal-body" id="modal-body-${index}" style="text-align: center;">
          <div class="form-group" style="position:relative; display:inline-block; margin: 0 auto; max-width: 100%;">
          <img src="{{ asset('images/aaa.png') }}"  class="frame" style="display:block; max-width:100%;">
            <div style="position:absolute; top:4.5%; bottom:16.5%; left:3.5%; right:3.5%; overflow:hidden; border-radius:2px;">
              ${content}
            </div>
          </div>
        </div>
        <div class="modal-footer" style="text-align: right;">
          <a class="btn btn-danger btn-md btn-ajouter-width" href="/annonce/" role="button"><i class="glyphicon glyphicon-remove"></i> <span>Annuler</span></a>    
        </div>
      </div>
    </div>
    `;

    body.appendChild(popUP);
    const modal = document.getElementById(`modal-${index}`);
    modal.classList.remove('fade');
    modal.classList.add('show'); 
    modal.style.display = 'block';
  }
});

</script>
<script>
document.addEventListener('click', function (event) {
    const CloseButton = event.target.closest('.close3');
    if(!CloseButton)
        return;
  const dataDismiss = CloseButton.getAttribute("data-dismiss");
   if (dataDismiss) {
    const index = dataDismiss.split('-')[1]; 
    const modal = document.getElementById(`modal-${index}`); 
    const modalBackdrop = document.getElementsByClassName("modal-backdrop");
    if (modal) {
      modal.classList.remove('show');
      modal.classList.add('fade');
      modal.style.display = 'none';
      modal.remove();
    }
    if (modalBackdrop[0]) {
      modalBackdrop[0].remove();
      if(modalBackdrop[0]);
      modalBackdrop[0].remove();
    }
  }

})
</script>


<script>
function createModal(index,Id,name) {
  const popUP = document.createElement('div');
  popUP.setAttribute("class", "modal fade modal-popup");
  popUP.setAttribute("tabindex", "-1");
  popUP.setAttribute("role", "dialog");
  popUP.setAttribute("id", `modal2-${index}`);
  popUP.setAttribute("aria-labelledby", "modalLabel1");
  popUP.setAttribute("aria-hidden", "true");
  popUP.innerHTML = `
    <div class="modal-dialog modal-lg" style="width: 800px; max-width: 37vw;" role="document">
      <div class="modal-content">
        <form id="form" method="post" enctype="multipart/form-data" action="/annonce/LancerAnnonce/${Id}">
            <div class="modal-header modal-header-custom">
            <button id="close" type="button" class="close close2" data-dismiss="modal2-${index}" aria-label="Close">
                <span aria-hidden="true">&times;</span>
              </button>
              <div class="modal-header-title">
              <img src="{{ asset('images/ler.png') }}" alt="Icon">
                Lancer l'annonce
              </div>
            </div>
            <div class="modal-body" id="modal-body2-${index}" style="overflow-y: auto; max-height: 60vh;">
              <div style="font-size:16px;color:black;">Liste Support connecté à choisir</div>
            </div>
            <div class="modal-footer" style="text-align: right;">
              <button id="envoyervod" type="submit" class="btn btn-primary btn-md btn-action-wide" name="envoyervod"> <i class="glyphicon glyphicon-send"></i> Lancer l'annonce</button>
              <a class="btn btn-danger btn-md btn-action-wide" href="/annonce/" role="button"><i class="glyphicon glyphicon-remove"></i> <span>Annuler</span></a>
            </div>
        </form>
      </div>
    </div>    
    `;
    return popUP;
}

document.addEventListener('click', function (event) {
    const lancerButton = event.target.closest('.lancer-button');
    if(!lancerButton)
      return ;
    const Id = lancerButton.getAttribute('data-id');
    const name = lancerButton.getAttribute('data-name');
    const active = document.getElementById(`active-${Id}`);
    let index = -1;
    if (lancerButton.getAttribute("data-target")) {
      index = lancerButton.getAttribute("data-target").split('-')[1];
      if(index >= 0)
      {
        if (active && !active.checked) {
        confirm("Attention, l'annonce n'est pas actif, donc non présent sur la box. Merci de le cocher.Faites dans un premier temps la mise à jour sur la BOX.Enfin, vous pouvez lancer l'annonce avec l'icône bleue.");
        event.preventDefault(); 
        return false;
      }
      else{
        const bodyContainer = document.body;
        const modal = createModal(index,Id,name);
        bodyContainer.appendChild(modal);
    const modalBody1 = document.querySelector(`#modal-body2-${index}`);
    if (modalBody1 && Array.isArray(chambre)) {
      const existeTable = document.getElementById(`table-${index}`);
      if(!existeTable)
      {
      const table = document.createElement('table');
      table.style.width = "100%";
      table.setAttribute("class","table table-striped header-fixed table-bordered table-hover table-checkable order-column dataTable no-footer table-modal");
      table.id = `table-${index}`;
      const thead = document.createElement('thead');
      thead.style.width = "100%";
      thead.innerHTML = `
        <tr>
          <th><input type="checkbox" id="checkAllboxn"/><!--<p style="color:red; font-size:10px; margin:0;">Selectionner / Désélectionner</p>--></th>
          <th>Chambre</th>
          <th>Adresse IP</th>
          <th>Adresse MAC</th> 
        </tr>`;
      table.appendChild(thead);
      const tbody = document.createElement('tbody');
      tbody.style.width = "100%";
      let i = 0;
      chambre.forEach(chbr => {
    const tr1 = document.createElement('tr');
    tr1.innerHTML = `
        <td data-label="Sélection"><input type="checkbox" value=${chbr.id} name="checked[${i}]" class="boxcheck"/><input style="display:none" type="text" value=${chbr.id} name="chambre[${i}]"></td>
        <td data-label="Chambre">${capitalize(chbr.nom)}</td>
        <td data-label="Adresse IP">${chbr.ip}</td>
        <td data-label="Adresse MAC">${chbr.Mac}</td>`;
    tbody.appendChild(tr1);
    i++;
});
      table.appendChild(tbody);
      modalBody1.appendChild(table);
      const modal = document.getElementById(`modal2-${index}`);
      modal.classList.remove('fade');
      modal.classList.add('show'); 
      modal.style.display = 'block';
      document.body.style.overflow = 'hidden';
      if (!$.fn.dataTable.isDataTable(`#table-${index}`)) {
      $(`#table-${index}`).DataTable({
        language: {
        emptyTable: "Aucune chambre disponible."
    },
        oLanguage: {"sSearch": "Recherche:"},
        paging: false,
        searching: true,
        ordering: false,
        info: false,
        columnDefs: [{ orderable: false, targets: 0 }]
      });
    }
    }
      }
      }
      }
    }
  const checkAll = document.getElementById('checkAllboxn');
const checkboxes = document.querySelectorAll('.boxcheck');

if (checkAll) {
    checkAll.addEventListener('change', () => {
        checkboxes.forEach(checkbox => {
            checkbox.checked = checkAll.checked;
        });
    });
}

if (checkboxes) {
    checkboxes.forEach(checkbox => {
        checkbox.addEventListener('change', () => {
            if (!checkbox.checked) {
                checkAll.checked = false;
            } else if (Array.from(checkboxes).every(cb => cb.checked)) {
                checkAll.checked = true;
            }
        });
    });
}
})

document.addEventListener('click', function (event) {
    const CloseButton = event.target.closest('.close2');
    if(!CloseButton)
        return;
  const dataDismiss = CloseButton.getAttribute("data-dismiss");
   if (dataDismiss) {
    const index = dataDismiss.split('-')[1]; 
    const modal = document.getElementById(`modal2-${index}`); 
    const modalBackdrop = document.getElementsByClassName("modal-backdrop");
    if (modal) {
      modal.classList.remove('show');
      modal.classList.add('fade');
      modal.style.display = 'none';
      document.body.style.overflow = '';
      modal.remove();
    }
    if (modalBackdrop[0]) {
      modalBackdrop[0].remove();
      if(modalBackdrop[0]);
      modalBackdrop[0].remove();
    }
  }

})
</script>



<script>

  function createModal1(index,Id,name) {
    const popUP = document.createElement('div');
    popUP.setAttribute("class", "modal fade modal-popup");
    popUP.setAttribute("tabindex", "-1");
    popUP.setAttribute("role", "dialog");
    popUP.setAttribute("id", `modal3-${index}`);
    popUP.setAttribute("aria-labelledby", "modalLabel2");
    popUP.setAttribute("aria-hidden", "true");
    popUP.innerHTML = `
        <div class="modal-dialog modal-lg" style="width: 800px; max-width: 37vw;" role="document">
            <div class="modal-content">
                <form id="form" method="post" enctype="multipart/form-data" action="/annonce/ArreteAnnonce/${Id}">
                    <div class="modal-header modal-header-custom">
                    <button id="close" type="button" class="close close1" data-dismiss="modal3-${index}" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                        <div class="modal-header-title">
                        <img src="{{ asset('images/ler.png') }}" alt="Icon">
                            Arrêter l'annonce
                        </div>
                    </div>
                    <div class="modal-body" id="modal-body3-${index}" style="overflow-y: auto; max-height: 60vh;">
                      <div style="font-size:16px;color:black;">Liste Support connecté à choisir</div>
                    </div>
                    <div class="modal-footer" style="text-align: right;">
                      <button id="envoyervod" type="submit" class="btn btn-primary btn-md btn-action-wide" name="envoyervod"> <i class="glyphicon glyphicon-send" style="margin-right:3px"></i>Arrêt l'annonce en cours</button>
                      <a class="btn btn-danger btn-md btn-action-wide" href="/annonce/" role="button"><i class="glyphicon glyphicon-remove"></i> <span>Annuler</span></a>
                    </div>
                </form>
            </div>
        </div>    
    `;
    return popUP;
}
