{% extends 'home/index.html.twig' %}
{% block body %}

<link rel="stylesheet" href="{{ asset('css/css_questionnaire.css') }}">
<script src="{{ asset('javascript/jquery.min.js') }}"></script>

<div id="titre">
    <img src="{{ asset('images/ler.png') }}">
    Liste QUESTIONNAIRE
</div>
<div id="div2" class="card p-3 mt-3">
    <div>
        <form method="post" action="{{ path('update_active') }}">
                <div id="div_btn">
                        <a href="{{ path('app_ajouter_question') }}" class="btn btn-info btn-sm" name="add" id="add"   {% if app.user.Ajouteqs == '0' %}   disabled {% endif %}>
                            <i class="glyphicon glyphicon-plus"></i> <span class="btn_text d-none d-md-inline">Ajouter des questions</span>
                        </a>
                        <button  class="btn btn-success btn-sm" type="submit" name="Sauvegarder-button" id="Sauvegarder-button" {% if app.user.Sauvgarderqs == '0' %} disabled {% endif %} style="width:auto;">
                            <i class="glyphicon glyphicon-inbox"></i> <span class="btn_text d-none d-md-inline">Sauvegarder</span>
                        </button>
                        <a name="annuler" href="{{ path('app_questionnaire') }}" class="btn btn-danger btn-sm" style="width:auto;">
                            <i class="glyphicon glyphicon-remove"></i> <span class="btn_text d-none d-md-inline">Annuler</span>
                        </a>
                </div>
                <div id="div_search">
                        <label class="form-label" for="myselect">Liste des services établissement créés :</label>
                    {% set selectedServiceId = app.request.query.get('serviceId') %}
                        <div style="height:40px;">
                        <select id="myselect" class="form-control" name="selectservices">
                            <option value="" slected>Recherche par service</option>
                            {% for s in serviceetablissement %}
                                <option value="{{ s.id }}" {% if s.id == selectedServiceId %}selected{% endif %}>{{ s.nom|upper }}</option>
                            {% endfor %}
                        </select>
                        </div>
                </div>
        <div class="table-wrapper">
        <table class="table table-striped table-bordered table-hover align-middle" id="dataTables-example">
        <thead class="table-light text-center">
            <tr>
                <th class="text-start">Question</th>
                <th>Position</th>
                <th>Service</th>
                <th>
                    Active <br>
                    <input type="checkbox" id="checklist">
                </th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody class="text-center">
        {% for questionnaire in questionnaire %}
            <tr data-service="{{ questionnaire.service.id }}">
                <td class="text-start question-cell">{{ questionnaire.fr }}</td>
                <td>{{ questionnaire.position }}</td>
                <td>{{ questionnaire.service.nom }}</td>
                <td>
                    <input name="list[{{ questionnaire.id }}]" 
                           type="checkbox" 
                           class="btncheckbox"
                           {% if questionnaire.active %}checked{% endif %}
                           {% if app.user.Sauvgarderqs == '0' %} disabled {% endif %}>
                </td>
                <td>
                    <a href="{{ path('app_modifier_question', {'id': questionnaire.id}) }}"
                       class="btn btn-warning btn-sm">
                        <i class="glyphicon glyphicon-pencil"></i>
                    </a>

                    <a href="{{ path('app_supprimer_question', {'id': questionnaire.id}) }}"
                       onclick="return confirm('Voulez-vous vraiment supprimer cette question ?')"
                       class="btn btn-danger btn-sm">
                        <i class="glyphicon glyphicon-trash"></i>
                    </a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

            </div>
        </form>
    </div>
</div>

{# nos scripts #}

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const rows = document.querySelectorAll('#myTab tbody tr');
        let actionsVisible = false;

        rows.forEach(row => {
            const modifierButton = row.querySelector('.btn-modifier');
            const supprimerButton = row.querySelector('.btn-supprimer');

            if (modifierButton || supprimerButton) {
                actionsVisible = true;
            }
        });

        if (!actionsVisible) {
            document.querySelector('#myTab thead th:last-child').style.display = 'none';
            rows.forEach(row => {
                row.querySelector('td:last-child').style.display = 'none';
            });
        }
    });
</script>

<script>
    document.getElementById('myselect').addEventListener('change', function() {
        var selectedService = this.value.toLowerCase();
        var rows = document.querySelectorAll('.questionnaire-row');

        rows.forEach(function(row) {
            var serviceId = row.getAttribute('data-service');
            if (selectedService === "" || serviceId === selectedService) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    });

    // Filtrer les lignes lors du chargement de la page
    window.addEventListener('load', function() {
        var selectedService = document.getElementById('myselect').value.toLowerCase();
        var rows = document.querySelectorAll('.questionnaire-row');

        rows.forEach(function(row) {
            var serviceId = row.getAttribute('data-service');
            if (selectedService === "" || serviceId === selectedService) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    });

    document.getElementById('checklist').addEventListener('click', function() {
        var selectedService = document.getElementById('myselect').value.toLowerCase();
        var checkboxes;
        if (selectedService === "") {
            checkboxes = document.querySelectorAll('.btncheckbox');
        } else {
            checkboxes = document.querySelectorAll('.questionnaire-row[data-service="' + selectedService + '"] .btncheckbox');
        }
        checkboxes.forEach(function(checkbox) {
            checkbox.checked = document.getElementById('checklist').checked;
        });
    });
</script>

{% endblock %}
