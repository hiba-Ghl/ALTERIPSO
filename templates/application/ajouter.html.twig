{% extends 'home/index.html.twig' %}
{% block body %}
<style>
    #div2 {
			border-radius: 25px;
			border: 2px solid #3087ce;
			padding: 20px;
			width: 1300px;
			height: 250px;
			margin-left: -70px;
			margin-top: 10px;
			background-color: white;
		}
</style>

<div style="border-radius: 8px; text-align: left; margin-bottom: 10px; margin-left: -70px; color: white; font-style: oblique; font-size: 20px; background-color: #3087ce; width: 300px; padding-left: 10px; display: inline-block;">
<img style="margin-top: -51px; margin-left: -10px; width: 45px; float: left;" src="{{ asset('images/ler.png') }}">
	Ajouter Application 
</div>

<div id="div2">
		<form action="{{path('app_ajouter_application')}}" method="post" enctype="multipart/form-data">
			<table style="width: 100%;">
				<tr>
					<td style="width: 33%;">
						<div class="control-label">
							<label  class=" control-label">Nom Application:
							</label>
							<input type="text" name="nom" class="form-control" style="width: 99%;">
						</div>
					</td>

					<td style="width: 33%;">
						<div class="control-label">
							<label  class=" control-label">Package:
							</label>
							<input type="text" name="package" class="form-control" style="width: 99%;">
						</div>

					</td>

					<td style="width: 33%;">
						<div class="control-label">
							<label  class=" control-label">Active:
							</label>


							<select class="form-control" name="active" id="active" style="width: 99%;">

								<option value='0'>0</option>
								<option value='1'>1</option>

							</select>
						</div>

					</td>


				</tr>
				
                <tr>

					<td style="width: 33%;">

						<div class="control-label">
							<label  class=" control-label">Position:  
							</label>
							<select class="form-control" id="positionSelect" name="Position" >
                            	<option selected="selected" value=''></option>
                        	</select>
							{# <input type="number" name="position" id="position" class="form-control" style="width: 99%;" > #}
						</div>

					</td>

					<td style="width: 33%;">
						<div class="control-label">
							<label >logo :</label>
							<input type="file" class="form-control" id="logo" name="logo" style="width: 99%;" required>
						</div>
					</td>

					<td style="width: 33%;">
						<div class="control-label">
							<label  class=" control-label">
								Protocole:
							</label>
							<select class="form-control" name="protocole" id="protocole" style="width: 99%;">
    {% for support in supports %}
        <option value="{{ support.protocole }}">{{ support.nom|upper }}</option>
    {% endfor %}
</select>

						</div>

					</td>

				</tr>

			</table>

			<br>
				<div style="float:right;margin-right:0px;">
    		<a class="btn btn-danger btn-md" id = "annulerButton" style="width:130px;" href="/application">
        		<i class="glyphicon glyphicon-remove"></i> Annuler
    		</a>
    		<button type="submit" class="btn btn-primary btn-md" name="valider" >
				<i class="glyphicon glyphicon-floppy-disk"></i>
				Enregistrer
			</button>
			</div>
			


		</form>



	

</div>
<!-- Scripts -->
<script type="text/javascript">


</script>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const protocoleSelect = document.getElementById('protocole');
    const positionSelect = document.getElementById('positionSelect');

    const positionsBySupport = {{ positionsBySupport|json_encode|raw }};
    const firstFreePositionBySupport = {{ firstFreePositionBySupport|json_encode|raw }};

    if (!protocoleSelect || !positionSelect) {
        console.error("Un des éléments (protocole ou positionSelect) est introuvable.");
        return;
    }

    protocoleSelect.addEventListener('change', function () {
        const protocole = this.value;

        // Efface les anciennes options
        positionSelect.innerHTML = '<option value=""></option>';

        const occupiedPositions = positionsBySupport[protocole] || [];

        // Ajoute les positions disponibles
        for (let i = 1; i <= 100; i++) {
            if (!occupiedPositions.includes(i)) {
                const option = document.createElement('option');
                option.value = i;
                option.textContent = i;
                positionSelect.appendChild(option);
            }
        }

        // Sélectionne la première position libre
        const firstFree = firstFreePositionBySupport[protocole];
        if (firstFree) {
            positionSelect.value = firstFree;
        }
    });
});
</script>


{% endblock %}