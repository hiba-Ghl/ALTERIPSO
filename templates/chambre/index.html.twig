{% extends 'home/index.html.twig' %}
{% block body %}
	<style>
		#div1 {
			border-radius: 25px;
			border: 2px solid #3087ce;
			padding: 43px;
			width: 1091px;
			height: 300px;
			margin-left: -70px;
			margin-top: 10px;

		}
		#div2 {
			border-radius: 25px;
			border: 2px solid #3087ce;
			padding: 20px;
			width: 1300px;
			height: 900px;
			margin-left: -70px;
			margin-top: 10px;
			background-color: white;
		}


		.fileUpload {
			position: relative;
			overflow: hidden;
			/* margin: 10px;*/
		}
		.fileUpload input.upload {
			position: absolute;
			top: 0;
			right: 0;
			margin: 0;
			padding: 0;
			font-size: 20px;
			cursor: pointer;
			opacity: 0;
			filter: alpha(opacity=0);

		}

		.w {
			width: 70px;
		}
		.header-fixed {
			width: 1200px;
		}

		.header-fixed > thead,
		.header-fixed > tbody,
		.header-fixed > thead > tr,
		.header-fixed > tbody > tr,
		.header-fixed > thead > tr > th,
		.header-fixed > tbody > tr > td {
			display: block;
		}

		.header-fixed > tbody > tr:after,
		.header-fixed > thead > tr:after {
			content: ' ';
			display: block;
			visibility: hidden;
			clear: both;
		}

		.header-fixed > tbody {
			overflow-y: auto;
			height: 500px;
		}

		.header-fixed > tbody > tr > td,
		.header-fixed > thead > tr > th {
			/*width: 20%;*/
			float: left;
		}
		.paginate_button {
			margin-left: 2px;
		}
	</style>

	<p id='p'></p>
	<div style="margin-top: -40px;position: absolute;border-radius: 8px;text-align: left;margin-left: -68px;color: white;font-style: oblique;font-size: 20px;background-color: #3087ce;width: 250px;padding-left: -27px;">
		Liste Support Connecté
	</div>

	<div id="div2">


		{% set nb =  chambres|length %}
		{% if nb >= etablissement.licence  %}
			<a href="" class="btn btn-info btn-sm" name="add" id="add">
				<i class="glyphicon glyphicon-plus"></i>
				Ajouter support</a>
			<div style="color: red;font-size: 18px;">
				<br>
				<i class="glyphicon glyphicon-warning-sign"></i>-    vous n'avez pas assez de licences, pour ajouter un support merci d'envoyer un email à : contact@alteripso.com
			</div>
		{% else %}
			<a href="{{path('app_ajouter_chambre')}}" class="btn btn-info btn-sm" name="add" id="add">
				<i class="glyphicon glyphicon-plus"></i>
				Ajouter support</a>
			<br>
		{% endif %}


		<B>Nombre de  licence &nbsp;&nbsp;:
			{{etablissement.licence}}
		</B><br>
		<B>Nombre de Support :
			{{nb}}</B>


		<div style="margin-left: 976px;position: absolute;margin-top: -69px;">
			<button type="button" class="btn btn-success btn-sm" data-toggle="modal" data-target="#myModal">
				<i class="glyphicon glyphicon-log-in"></i>
				Check-in/Check-out</button>
		</div>


		<hr>
		<select style="margin-left: 669px;margin-top: 62px;width: 200px;position: absolute;z-index: 1000" onchange="getval2(this)" id="form_Active" name="selectservices">
			<option selected value="">Recherche par service</option>
			{% for s in serviceetablissement %}
				<option value="{{s.nom}}">{{s.nom|upper}}</option>
			{% endfor %}
		</select>


		<div style="color: red;font-size: 14px;">Choisissez le modèle d'extraction de données:</div>
		<br>
		<div class="modnt"></div>
		<div
			id="myDiv" class="col-md-12" margin-buttom:25px>


			<!--<table class="table table-striped table-bordered table-hover" id="dataTables-example">-->
			<table class="table table-striped header-fixed table-bordered table-hover table-checkable order-column" id="dataTables-example">
				<thead>

					<tr>
						<th style="text-align: center;  height: 50px;width: 100px;">Identifiant support</th>
						<th style="text-align: center;height: 50px;width: 50px;">Connexion</th>
						<th style="text-align: center;height: 50px;width: 50px;">Ip</th>
						<!--<th style="text-align: center;height: 50px;width: 50px;">Support connecté</th>-->
						<th style="text-align: center;height: 50px;width: 100px;">Modèle TV</th>
						<th style="text-align: center;height: 50px;width: 50px;">Date Mise à jour</th>
						<th style="text-align: center;height: 50px;width: 50px;">Etage</th>
						<th style="text-align: center;height: 50px;width: 50px;">Service</th>
						<th style="text-align: center;height: 50px;width: 50px;">Droit TV</th>
						<th style="text-align: center;height: 50px;width: 50px;">Type Affichage</th>
						<th style="text-align: center;height: 50px;width: 100px;">Fond d'écran</th>
						<th style="text-align: center;height: 50px;width: 100px;">Actions</th>


					</tr>
				</thead>

				<tbody>


					{% for box in chambres %}


						<tr class="odd gradeX">
							<td style="text-align: center;  height: 50px;width: 122px;">{{box.nom}}</td>


							{#{dump(box)}#}


							<!--<td class="{#{i}#}"></td>-->

							<td style="text-align: center;  height: 50px;width: 72px;">
								<a data-toggle="tooltip" data-placement="top" name="envoyerr" id="envoyerr" title="Etat  support" id="ida" href="{{path('home')}}" class="btn btn-default btn-xs">
									<i class="glyphicon glyphicon-off"></i>
								</a><br>


								{% if box.etat == 'ON' or box.etat == 'On' or box.etat == 'normal' %}
									<p style="text-align: center;">
										<i style="color:green;text" class="glyphicon glyphicon-stop"></i>ON
										{#{box.etat}#}
									</p>

								{% elseif box.etat == 'OFF'  %}
									<p style="text-align: center;">
										<i style="color:red;text" class="glyphicon glyphicon-stop"></i>OFF</p>

								{% elseif box.etat == 'warm' or  box.etat =='Standby' %}
									<p style="text-align: center;">
										<i style="color:#ED7F10;" class="glyphicon glyphicon-stop"></i>Standby</p>

								{% else %}
									<p style="text-align: center;">
										{{box.etat}}</p>


								{% endif %}


							</td>

							<td style="text-align: center;  height: 50px;width: 72px;">{{box.Ip}}</td>


							<!--<td style="text-align: center;  height: 50px;width: 72px;">{{box.Support}}</td>-->

							<td style="text-align: center; height: 50px;width: 122px;">{{box.type}}</td>
							<td style="text-align: center; height: 50px;width: 72px;">{{box.date}}</td>
							<td style="text-align: center; height: 50px;width: 72px;">{{box.etage}}</td>
							<td style="text-align: center; height: 50px;width: 72px;">{{box.service.nom|capitalize}}</td>
							{% if (box.checkval) == 1 %}
								<td style="text-align: center; height: 50px;width: 72px;color:green;">Check-in</td>
							{% else %}
								<td style="text-align: center; height: 50px;width: 72px;color:red;">Check-out
								</td>
							{% endif %}


							{% if (box.typeaffichage) == 1 %}
								<td style="text-align: center; height: 50px;width: 72px;">Alteripso</td>
							{% else %}
								<td style="text-align: center; height: 50px;width: 72px;">Dynamique
									<br><div style="color:red;">
										({{box.chaine.nom}})
									</div>
								</td>
							{% endif %}


							<td style="text-align: center; height: 50px;width: 122px;">
								{% if (box.background) == '' %}
									<i class="glyphicon glyphicon-remove" style="color: red;"></i>
								{% elseif ( '.mp4' in box.background ) %}
									Vidéo
								{% else %}
									<img style="width:50px;height:50px;text-align:center" src="{{ asset('images/'~box.background) }}" alt="..." class="img-rounded img-responsive center-block">
								{% endif %}
							</td>


							<td style="text-align: center; height: 50px;width: 122px;">


								<a data-toggle="tooltip" data-placement="top" title="redémarrer le support" href="{{path('app_redemarrer',{'id':box.id})}}"   class="reboot btn btn-info btn-xs">
									<i class="glyphicon glyphicon-refresh"></i>
								</a>

								<a data-toggle="tooltip" data-placement="top" title="supprimer le support" id="" href="{{path('app_supprimer_chambre',{'id':box.id})}}" class="ida btn btn-danger btn-xs" onclick="return confirm('Voulez-vous vraiment supprimer la chambre : {{box.nom}} ?')">
									<i class="glyphicon glyphicon-trash"></i>
								</a>


								<a data-toggle="tooltip" data-placement="top" title="Modifier le support" id="ida" href="{{path('app_modifier_chambre',{'id':box.id})}}" class="btn btn-warning btn-xs">
									<i class="glyphicon glyphicon-edit"></i>
								</a>


							</td>

						</tr>


						{% endfor%}

						{#{ dump(nb) }#}
					</tbody>
				</tbody>
			</table>

		</div>


		<!-- fin div2-->


	</div>
	<br>
	<!-- Modals -->

	<!-- Modal -->
		<div id="myModal" class="modal fade" role="dialog"> <form action="{{path('app_checkin')}}" name="form" method="post" enctype="multipart/form-data">
			<div
				class="modal-dialog">

				<!-- Modal content-->
				<div class="modal-content">

					<div class="modal-header">
						<button type="button" class="close" data-dismiss="modal">&times;</button>


					</button>
					<h4 class="modal-title">Veuillez choisir une option:</h4>


					<p></p>


					<input type="radio" name="etatcheckin" value="checkin" class="etatcheckin">
					<label style="color: green;">Check-in</label>
					<br>
					<input type="radio" name="etatcheckin" value="checkout" class="etatcheckin">
					<label style="color: red;">Check-out</label>
				</div>
				<div
					class="modal-body">
					<!-- -->
					<label style="">
						Recherche par service : &nbsp;&nbsp;&nbsp;
					</label>
					<select style="width: 200px;margin-top: -39px;margin-left: 175px;" onchange="getval(this);" name="selectservices" class="form-control">
						<option selected value="">Tous les services</option>
						{% for s in serviceetablissement %}
							<option value="{{s.nom}}">{{s.nom|upper}}</option>
						{% endfor %}
					</select>
					<br>
					<label style="">
						Recherche du support : &nbsp;&nbsp;&nbsp;
					</label>
					<input id="myInput" type="text" placeholder="Search.." style="width: 200px;margin-top: -39px;margin-left: 175px;" class="form-control">

					<div style="height:500px;overflow-y: scroll;">
						<br><br>
						<!--<table class="table table-striped table-bordered table-hover" id="dataTables-example">-->
						<table id="example20" class="table table-striped table-bordered table-hover">
							<thead>
								<tr>
									<th>
										<input type="checkbox" id="checkAllboxnx">
										Sélectionner</th>
									<th>
										Chambre</th>
									<th>
										IP</th>
									<th>
										Service</th>
								</tr>
							</thead>
							<tbody id="myTable">
								{% for box in chambres %}
									<tr>
										<td>
											<label class="labelbox"><input data-boxid='{{box.etage}}' class='boxchecke' name='box[{{box.Id}}]' type="checkbox">
												{{box.nom}}</label>
										</td>
										<td>
											{{box.etage}}</td>
										<td>
											{{box.ip}}</td>
										<td>{{box.service.nom|capitalize}}</td>
									</tr>
									<tr>{% endfor%}
									</tr>
								</tbody>
							</tbody>
						</table>
					</div>

					<!-- -->


				</div>
				<div class="modal-footer">


					<button id='' type="submit" class="btn btn-primary " name="">
						<i class="glyphicon glyphicon-floppy-disk"></i>Valider</button>

					<button type="button" class="btn btn-danger" data-dismiss="modal">
						<i class="glyphicon glyphicon-remove"></i>Annuler</button>


				</div>
			</div>
		</form>

	</div>

	<!-- Scripts -->
    <!-- online -->
	<!--<script src="https://code.jquery.com/jquery-3.5.1.js"></script>-->
    <script src="{{asset('javascript/jquery.min.js')}}"> </script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
	<style type="text/css" src="https://cdn.datatables.net/1.10.23/css/jquery.dataTables.min.css"></style>
	<style type="text/css" src="https://cdn.datatables.net/buttons/1.6.5/css/buttons.dataTables.min.css"></style>


	<!-- offline -->
	<!--<script src="{{asset('javascript/jquery-3.5.1.js')}}"></script>
				<script src="{{asset('javascript/jszip.min.js')}}"></script>
				<script src="{{asset('javascript/pdfmake.min.js')}}"></script>
				<script src="{{asset('javascript/vfs_fonts.js')}}"></script>
				<link href="{{ asset('css/jquery.dataTables.min.css') }}" rel="stylesheet">
				<link href="{{ asset('css/buttons.dataTables.min.css') }}" rel="stylesheet">
				-->

  <script src="{{ asset('javascript/datatables2.min.js') }}"></script>

    <script>
    

        var maintable = $('#dataTables-example').DataTable({
           aLengthMenu: [[-1, 10, 100, 200],["All", 10, 100, 200]],
           "aaSorting": [[ 1, "dsc" ]],
                responsive: true,
                 dom: 'Bfrtip',
                 info: false, // Masquer les informations sur le tableau
                paging: false, // Masquer la pagination
        buttons: [
            { extend: 'copy', className: 'btn-info w' ,title: 'Liste Support Connecté'},
            { extend: 'excel', className: 'btn-danger w' ,title: 'Liste Support Connecté'},
            { extend: 'csv', className: 'btn-warning w' ,title: 'Liste Support Connecté'},
            { extend: 'pdf', className: 'btn-primary w' ,title: 'Liste Support Connecté',orientation:'landscape',
             customize: function(doc) {
              const o_date = new Intl.DateTimeFormat;
              const f_date = (m_ca, m_it) => Object({...m_ca, [m_it.type]: m_it.value});
              const m_date = o_date.formatToParts().reduce(f_date, {});
              //console.log(m_date.day + '-' + m_date.month + '-' + m_date.year);
                                doc['footer'] = (function(page, pages) {
                    return {
                      columns: [
                        {
                          alignment: 'center',
                          text: [
                          
                            { text: page.toString(), italics: true },
                  ' / ',
                            { text: pages.toString(), italics: true },

                            { text: '   |'+ m_date.day + '-' + m_date.month + '-' + m_date.year },

                            
                  ]
                      }],
                      margin: [10, 0]
                    }
                  });
              }

          },   

      // { extend: 'print', className: 'btn-default w' ,title: 'Liste Support Connecté'},




        ]
        });
        </script>
	<script type="text/javascript">


		$(function () {
$('#envoyerr').click(function () {
$.toast('<i class="glyphicon glyphicon-fire"></i> envoie en cours ...', {
'align': 'top',
'type': 'success'
});
});
});
	</script>


	<script>


		$(document).ready(function () {
$('#checkAllboxnx').click(function () {

$(".boxchecke").prop("checked", false);
if (this.checked) {

$(".boxchecke:visible").each(function () {
$(this).prop("checked", true);
});
}
});

});
	</script>
	<script>
		function Check() {


var msg = "";
if (nb > etablissement.licence) {
msg += "vous avez atteint le nb de licence";
}
if (msg != "") {
alert(msg);
return false;
}


return true;
}
	</script>
	<script>
		function getval2(sel) { // alert(sel.value);
$('input').val(sel.value);
// $(this).toggle($(this).text().toLowerCase().indexOf(sel.value.toLowerCase()) > -1)
maintable.search(sel.value).draw();

}
	</script>
    
<script type="text/javascript">
  // recherhe par service
function getval(sel)
{
   
     $('#myInput').val(sel.value);
     $("#myTable tr").filter(function() {
      $(this).toggle($(this).text().toLowerCase().indexOf(sel.value.toLowerCase()) > -1)
    });
}
</script>
{% endblock %}
