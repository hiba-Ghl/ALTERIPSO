  <div class="modal-dialog" role="document" style="width:300px">
    <div class="modal-content">
	<form action="{{ path('modifierposition', {'id': categorie.id}) }}"  id="modifierposition{{categorie.id}}" name="modifierposition{{categorie.id}}" method="post" enctype="multipart/form-data">
      <div class="modal-header">
        <h5 class="modal-title" id="changepositionlabel"> {{categorie.nom}}</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <select class="form-control" name="selectedcat">
