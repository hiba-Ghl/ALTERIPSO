  <!-- script d'ajout des requetes  -->
  <script>
    function addText() {
      // Récupérer la valeur du champ de saisie
      var inputText = document.getElementById("requete").value;

      // Récupérer le contenu actuel du textarea
      var currentText = document.getElementById("listrequte").value;

      // Ajouter le texte du champ dans le textarea avec un saut de ligne
      document.getElementById("listrequte").value = currentText + inputText + "\n";

      // Effacer le champ de saisie après l'ajout
      document.getElementById("requete").value = "";
    }
  </script>

  <!-- script pour ajout nouveau champ prix/quantit  -->
  <script>
    function createElement(type, className, textContent = null) {
      var element = document.createElement(type);
      element.className = className;
        if (textContent !== null) {
           element.textContent = textContent;
        }
              
       return element;
    }
              
    function ajouterChampQuantitePrix() {
      var divRow = createElement("div", "form-row");
      divRow.style.marginLeft = "27px";
              
      // Créer les éléments pour Quantité
      var divQuantite = createElement("div", "form-group col-md-6");
      divQuantite.appendChild(createElement("label", null, "Quantité:"));
      divQuantite.appendChild(createElement("input", "form-control", null, "quantite[]"));
              
      // Créer les éléments pour Prix
      var divPrix = createElement("div", "form-group col-md-6");
      divPrix.style.marginLeft = "27px";
      divPrix.appendChild(createElement("label", null, "Prix:"));
      divPrix.appendChild(createElement("input", "form-control", null, "prix[]"));
              
      divRow.appendChild(divQuantite);
      divRow.appendChild(divPrix);
              
      // Récupérer le conteneur prixquantite
      var prixquantite = document.getElementById("prixquantite");
              
      // Insérer les nouveaux champs avant le bouton Enregistrer
      prixquantite.insertBefore(divRow, prixquantite.lastElementChild.previousElementSibling);
    }
  </script>

 <!-- script pour changer le forum entre forum prix normal et prix par quantite  -->
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      // Afficher initialement le champ "Prix" et cacher le champ "Quantité"
      var prixnormal = document.getElementById("prixnormal");
      var prixquantite = document.getElementById("prixquantite");
      prixnormal.style.display = "block";
      prixquantite.style.display = "none";
    });

    function toggleInput(inputType) {
      var prixnormal = document.getElementById("prixnormal");
      var prixquantite = document.getElementById("prixquantite");

      // Cacher tous les champs d'entrée
      prixnormal.style.display = "none";
      prixquantite.style.display = "none";

      // Afficher le champ d'entrée en fonction du type sélectionné
      if (inputType === 'prix') {
        prixnormal.style.display = "block";
      } else if (inputType === 'quantite') {
        prixquantite.style.display = "block";
      }
    }
  </script>
  
