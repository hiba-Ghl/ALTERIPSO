{% extends 'home/index.html.twig' %}
{% block body %}
<style>


		.fileUpload {
			position: relative;
			overflow: hidden;
		}
		.fileUpload input.upload {
			position: absolute;
			top: 0;
			right: 0;
			margin: 0;
			padding: 0;
			font-size: 20px;
			cursor: pointer;
			opacity: 0;
			filter: alpha(opacity=0);

		}

		.header-fixed {
			width: 1200px;
		}

		.header-fixed > thead,
		.header-fixed > tbody,
		.header-fixed > thead > tr,
		.header-fixed > tbody > tr,
		.header-fixed > thead > tr > th,
		.header-fixed > tbody > tr > td {
			display: block;
		}
	
		.header-fixed > tbody > tr:after,
		.header-fixed > thead > tr:after {
			content: ' ';
			display: block;
			visibility: hidden;
			clear: both;
		}

		.header-fixed > tbody {
			overflow-y: auto;
			height: 300px;
		}

		.header-fixed > tbody > tr > td,
		.header-fixed > thead > tr > th {
			float: left;
			
		}

		.table-container {
        max-height: 400px; 
        overflow-y: auto;
        margin-top: 10px;
       }
	   
	    thead, th {
        background-color: #f2f2f2;
        position: sticky;
        top: 0;
        z-index: 2;
		
    }
	

</style>
<div style="border-radius: 8px;text-align: left;margin-bottom: 10px;margin-left: -120px;color: white;font-style: oblique;font-size: 20px;background-color: #3087ce;width: 250px;padding-left: 10px;">
    <img style="margin-top: -51px;margin-left: -10px;width: 45px;float: left;" src="{{ asset('images/ler.png') }}">
    Liste Livre Audio
</div>

<!--le formulaire de modification d'un LivreAudio-->	
<form action="{{ path('modifier_livreaudio')}}" name="form" method="post" enctype="multipart/form-data" onsubmit="return validateListeIpForm();">
			<!--les boutons en haut du tableau-->
	<div id="div2">
	 <div style="display:flex;align-items:center;justify-content:space-between;gap:3px;">
		<div>
			<button type="submit" name="valider"   {% if app.user.SauvegarderLiveAudio == '0' %} disabled {% endif %}  class="btn btn-success btn-sm" style="margin-right: 5px;width:150px;" href="{{path('modifier_chaine')}}">
				<i class="glyphicon glyphicon-floppy-disk"></i> Sauvegarder
			</button>
			<a name="annuler" href="{{ path('app_livreaudio') }}" class="btn btn-danger btn-sm" style="margin-right: 5px;width:150px;">
				<i class="glyphicon glyphicon-remove"></i> Annuler
			</a>
			</div>
			<!--la barre de recherche-->
			<input id="myInput" type="text" placeholder="Search.." style="float: right;width:200px; padding: 6px; border-radius: 5px;" >
	</div>
		<div class="table-container">
 <table class="table table-striped table-bordered header-fixed table-hover" id="dataTables-example" style="width: 100%;margin-top:20px;">
				<thead>
					<tr>
						<th style="height: 50px;width:220px;text-align:center;">Nom Livre Audio</th>
						<th style="height: 50px;width:220px;text-align:center;">Fichier Livre Audio</th>
						<th style="height: 50px;width:220px;text-align:center;">Catégorie </th>
						<th style="height: 50px;width:220px;text-align:center;">Icons</th>
						<th style="height: 50px;width:220px;text-align:center;">
						 <p style="display:flex;gap:10px;justify-content:center">
                        <span>
                            Active
                        </span>
                        <input type="checkbox" id="checklist" style="margin-top:-1px;">
                        </p>
						</th>
						<th style="height: 50px;width:220px;text-align:center;">Action</th>


					</tr>
				</thead>

				<tbody id="myTable"> 

					{% for tele in livreaudio %}


						<tr >
							<!--le nom-->
							<td style="height: 50px;width:220px;text-align:center;">
								<label><input {% if app.user.SauvegarderLiveAudio == '0' %} disabled {% endif %} name='listenom[{{tele.Id}}]' type="text" value="{{tele.nom|capitalize}}" class="form-control"></label>
							</td>
							<!--le nom du fichier-->
							<td  style="height: 50px;width:220px;text-align:center;">
								<label>
									<input {% if app.user.SauvegarderLiveAudio == '0' %} disabled {% endif %} name='listeip[{{tele.Id}}]' class="form-control" value="{{tele.Ip}}" ></input>
								</label>
							</td>
							<!--la categorie-->
							<td style="height: 50px;width:220px;text-align:center;">
								<label>
									<select {% if app.user.SauvegarderLiveAudio == '0' %} disabled {% endif %} class="form-control" name='listcatlivreaudio[{{tele.Id}}]' > 
										{% if tele.categorie is not null %}
										<option selected=selected value ='{{tele.categorie.Id}}'>{{tele.categorie.nom|capitalize }}</option>
										 {% for a in categorielivreaudio %}      
									  	{% if a.nom == tele.categorie.nom %}
									  	{% else %}
										<option value ='{{a.id}}'>{{a.nom|capitalize }}</option>
										{% endif %}
										{% endfor %} 
										{% endif %}
									</select>
								</label>
							</td>
							<!--l'icone-->
							<td style="height: 50px;width:220px;text-align:center;">
								<div class="fileUpload " id="mainform">
									<img id="preview-{{tele.Id}}" style="width:50px;height:50px;text-align:center" src="{{asset(tele.logo)}}" alt="..." class="img-rounded img-responsive center-block">
									<input {% if app.user.SauvegarderLiveAudio == '0' %} disabled {% endif %}  id="{{tele.Id}}" type="file" class="upload" name="listelogo[{{tele.Id}}]" accept=".jpg, .jpeg, .png" style="width:50px;text-align:center"/>
								</div>
							</td>

							<!--le status active-->
							{% set ch = ' ' %}
							{% set chg = ' ' %}
							{% if (tele.active) == 1 %}
								{% set ch = 'checked' %}
							{% endif %}
							
							<td style="width:220px; text-align: center; vertical-align: middle;">
								<label><input {% if app.user.SauvegarderLiveAudio == '0' %} disabled {% endif %}  name='listeactive[{{tele.Id}}]' type="checkbox" {{ch}} class="jpCheckbox" style="height: 36.5px;"></label>
							</td>
							<!--l'action-->
							<td style="width:220px; height: 68px; text-align: center; vertical-align: middle;">
								<a data-toggle="tooltip" data-placement="top" {% if app.user.SupprimerLiveAudio == '0' %} disabled {% endif %} title="supprimer la chaîne"  href="{{path('supprimer_livreaudio',{'id':tele.id})}}"  class="btn btn-danger btn-xs" onclick="return confirm('Voulez-vous vraiment supprimer le Livre Audio : {{tele.nom}} ?')">
									<i class="glyphicon glyphicon-trash"></i>
								</a>
							</td>
						</tr>

					{% endfor %}



				

				</tbody>
			</table>
		</div>
</form>

<!--le formulaire d'ajout d'un LivreAudio-->

<form action="{{ path('ajouter_livreaudio')}}" name="form" method="post" enctype="multipart/form-data" onsubmit="return validateIpForm();" style="height: 70px;">
 <table class="table table-striped table-bordered header-fixed table-hover" id="dataTables-example" style="width: 100%;margin-top:20px;">
				<tbody style="height: auto !important;">
					<tr  style="background-color:white;">
					<!--le nom-->
						<td style="height: 50px;width:220px;text-align:center;">
							<label><input {% if app.user.AjoutLiveAudio == '0' %}	disabled {% endif %} name='nom' type="text" value="" class="form-control"></label>
						</td>

					<!--le nom du fichier -->
						<td style="height: 50px;width:220px;">
							<label>
								<input {% if app.user.AjoutLiveAudio == '0' %}	disabled {% endif %} name='ip' class="form-control" ></input>
							</label>
						</td>

					<!--la categorie-->
						<td style="height: 50px;width:220px;text-align:center;">
							<label>
								<select {% if app.user.AjoutLiveAudio == '0' %}	disabled {% endif %} class="form-control" name='catlivreaudio'> 								
									{% for a in categorielivreaudio %}      
									  <option value ='{{a.id}}'>{{a.nom|capitalize }}</option>
								  	{% endfor %} 
								</select>
							</label>
						</td>

						<!--l'icone-->

						<td style="height: 50px;width:220px;text-align:center;">
							<div class="fileUpload " id="mainform0">
								<img id="preview-0" style="width:50px;height:50px;text-align:center" src="{{ asset('images/no_image.png') }}" alt="..." class="img-rounded img-responsive center-block">
								<input {% if app.user.AjoutLiveAudio == '0' %}	disabled {% endif %} id="0" type="file" class="upload" name="logo" accept=".jpg, .jpeg, .png" style="width:50px;height:50px;text-align:center"/>
							</div>

						</td>

				
						<!--le status active-->
						<td style="width:220px; text-align: center; vertical-align: middle;">
							<label><input {% if app.user.AjoutLiveAudio == '0' %}	disabled {% endif %} name='active' type="checkbox" style="height: 36.5px;"></label>
						</td>

						<!--l'action -->
						<td style="width:220px; height: 68px; text-align: center; vertical-align: middle;">
						<button type="submit" {% if app.user.AjoutLiveAudio == '0' %}	disabled {% endif %} id="" href="{{path('ajouter_chaine')}}" class="btn btn-info btn-xs">
								<i data-toggle="tooltip" data-placement="top" title="Ajouter un livre audio" class="glyphicon glyphicon-plus"></i>
							</button>
						</td>
					</tr>
				</tbody>
			</table>
</form>

</div>


<!--script de la recherche-->
<script >

		
    $(document).ready(function () {
        // Fonction de recherche pour filtrer les lignes du tableau
        $("#myInput").on("keyup", function () {
            var value = $(this).val().toLowerCase(); // Récupère la valeur entrée et la convertit en minuscules
            $("#myTable tr").filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1); // Affiche uniquement les lignes qui contiennent le texte recherché
            });
        });
    });
</script>


<!--l'affichage de l'icone dès le telechargement-->
<script>
	function readURL(input) {
		if (input.files && input.files[0]) {
		var reader = new FileReader();

		reader.onload = function (e) {
		imgId = '#preview-' + $(input).attr('id');
		$(imgId).attr('src', e.target.result);
		}

		reader.readAsDataURL(input.files[0]);
		}
	}


			$("div#mainform input[type='file']").change(function () {
			readURL(this);
			});
			$("div#mainform0 input[type='file']").change(function () {
			readURL(this);
			});
</script>


<!--checking les checkboxes -->
<script>

		$('#checklist').click(function () { // on cherche les checkbox à l'intérieur de l'id  'magazine'
		var magazines = $("label").find(':checkbox.jpCheckbox');
		if (this.checked) { // si 'checkAll' est coché
		magazines.prop('checked', true);
		} else { // si on décoche 'checkAll'
		magazines.prop('checked', false);
		}
		});

</script>

<!--le control de l'extension du fichier durant l'ajout -->
<script>
	function validateIpForm() {
		// Sélectionner le champ textarea avec le nom 'ip'
		var urlInput = document.querySelector("input[name='ip']");
		var url = urlInput.value.toLowerCase(); // Convertir l'URL en minuscules

		// Liste des extensions audio autorisées
		var audioExtensions = [".mp3", ".aac", ".wav", ".flac", ".m4a", ".ogg"];

		// Vérifier si l'URL se termine par l'une des extensions autorisées
		var isValidExtension = audioExtensions.some(function(extension) {
			return url.endsWith(extension);
		});

		// Si l'extension n'est pas valide, afficher un message d'alerte
		if (!isValidExtension) {
			alert("Le fichier Livre Audio doit avoir l'une des extensions suivantes : .mp3, .aac, .wav, .flac, .m4a, .ogg");
			return false;
		}

		// Si l'extension est valide, retourner true
		return true;
	}
</script>

<!--le control de l'extension du fichier durant la modification -->
<script>
	function validateListeIpForm() {
    var urlInputs = document.querySelectorAll("input[name^='listeip']");
    
    // List of allowed audio extensions
    var audioExtensions = [".mp3", ".aac", ".wav", ".flac", ".m4a", ".ogg"];
    
    for (var i = 0; i < urlInputs.length; i++) {
        var url = urlInputs[i].value.toLowerCase(); // Convert to lowercase to avoid case sensitivity issues

        // Check if the URL ends with one of the allowed extensions
        var isValidExtension = audioExtensions.some(function(extension) {
            return url.endsWith(extension);
        });

        if (!isValidExtension) {
            alert("Le Fichier Livre Audio doit avoir l'une des extensions suivantes : .mp3, .aac, .wav, .flac, .m4a, .ogg");
            return false;
        }
    }
    return true;
	}
</script>


<!-- le control de la taille du fichier-->
<script>
  	document.querySelectorAll('input[type="file"]').forEach(function(input) {
    input.addEventListener('change', function(event) {
        var file = event.target.files[0];

        if (file && file.size > 400 * 1024) { // 400KB = 400 * 1024 bytes
            alert('La taille maximale du fichier est de 400 Ko. Veuillez choisir un fichier de taille plus petite');
            event.target.value = ''; // Clear the file input
        }
    });
	});
</script>

<!-- l'initialisation des tooltips-->
<script>
    $(document).ready(function(){
    $('[data-toggle="tooltip"]').tooltip();

    // Re-initialize tooltips after any form submit or dynamic content change
    $("form").on("submit", function() {
        $('[data-toggle="tooltip"]').tooltip('dispose').tooltip();
    });
 });

</script>


{% endblock %}
