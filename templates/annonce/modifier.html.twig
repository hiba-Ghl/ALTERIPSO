<!--for translation part in the form -->

<script>
const configApp = {{configApp | raw}}
document.addEventListener('DOMContentLoaded', function () {
	const traduireButton = document.getElementById('translateBtn');
	 const languageInputs = {
            en: document.getElementById("EN"),
            es: document.getElementById("ES"),
            pt: document.getElementById("PT"),
            it: document.getElementById("IT"),
            ru: document.getElementById("RU"),
            de: document.getElementById("DE"),
            zh: document.getElementById("ZH"),
            ar: document.getElementById("AR"),
        };
        let translations = {};
        async function translateAll(text) {
            const languages = Object.keys(languageInputs);
            let results = [];
             while(1)
             {
                results = await translate(text, languages, 'fr');
                if(results)
                    break;
             }
            languages.forEach((lang, index) => {
                translations[lang] = results[index];
            });
        }
        if (traduireButton) {
            traduireButton.addEventListener('click', async(event) => {
                const textInput = document.getElementById("nom");
                const text = textInput.value.trim() ;
                if (text === '') {
                    alert("Veuillez entrer un texte à traduire.");
                    return;
                }
                if(configApp.Status === 'Offline')
                {
                    alert("Aucun internet disponible : vous pouvez faire la traduction manuellement");
                    return ;
                }
                await translateAll(text);
                Object.keys(languageInputs).forEach(lang => {
                    if (translations[lang]) {
                        languageInputs[lang].value = translations[lang];
                    }
                });
            });
        }
});

</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    // Traduction (inchangé)
    const traduireButton1 = document.getElementById('translateBtn1');
    const languageInputs = {
        en: document.getElementById("ENMessage"),
        es: document.getElementById("ESMessage"),
        pt: document.getElementById("PTMessage"),
        it: document.getElementById("ITMessage"),
        ru: document.getElementById("RUMessage"),
        de: document.getElementById("DEMessage"),
        zh: document.getElementById("ZHMessage"),
        ar: document.getElementById("ARMessage"),
    };
    let translations = {};
    async function translateAll(text) {
        const languages = Object.keys(languageInputs);
        let results = [];
        while(1) {
            results = await translate(text, languages, 'fr');
            if(results)
                break;
        }
        languages.forEach((lang, index) => {
            translations[lang] = results[index];
        });
    }
    if (traduireButton1) {
        traduireButton1.addEventListener('click', async(event) => {
            const textInput1 = document.getElementById("text");
            const text = textInput1.value.trim() ;
            if (text === '') {
                alert("Veuillez entrer un message à traduire.");
                return;
            }
            if(configApp.Status === 'Offline') {
                alert("Aucun internet disponible : vous pouvez faire la traduction manuellement");
                return ;
            }
            await translateAll(text);
            Object.keys(languageInputs).forEach(lang => {
                if (translations[lang]) {
                    languageInputs[lang].value = translations[lang];
                }
            });
        });
    }

    // Aperçu dynamique du texte défilant (comme sur ajouter)
    const textarea = document.getElementById('text');
    const textPreview = document.getElementById('text-preview');
    const fontSelect = document.getElementById('font');
    const fontSizeSelect = document.getElementById('fontSize');
    const animationSelect = document.getElementById('animation');
    const styleSelect = document.getElementById('style');
    const vitesseInput = document.getElementById('vitesseDefilement');
    const textColorInput = document.getElementById('textColorDefilement');
    const bgColorInput = document.getElementById('bgColorDefilement');

    function getStyledText(text, vitesse) {
        let style = '';
        if (fontSelect && fontSelect.value) style += `font-family:${fontSelect.value};`;
        if (fontSizeSelect && fontSizeSelect.value) style += `font-size:${fontSizeSelect.value}px;`;
        if (textColorInput && textColorInput.value && textColorInput.value !== 'transparent') style += `color:${textColorInput.value};`;
        if (bgColorInput && bgColorInput.value && bgColorInput.value !== 'transparent') style += `background-color:${bgColorInput.value};`;
        if (bgColorInput && bgColorInput.value && bgColorInput.value !== 'transparent') style += 'padding:2px 10px; border-radius:3px;';
        if (styleSelect && styleSelect.value) {
            if (styleSelect.value === 'Gras') style += 'font-weight:bold;';
            if (styleSelect.value === 'Italique') style += 'font-style:italic;';
            if (styleSelect.value === 'Souligné') style += 'text-decoration:underline;';
            if (styleSelect.value === 'Barré') style += 'text-decoration:line-through;';
        }
        let animClass = '';
        let animStyle = '';
        if (animationSelect && animationSelect.value) {
            if (animationSelect.value === 'scroll') animClass = 'ia-scroll';
            if (animationSelect.value === 'bounce') animClass = 'ia-bounce';
            if (animationSelect.value === 'fade') animClass = 'ia-fade';
            if (vitesse && !isNaN(vitesse) && vitesse > 0) {
                const duration = Math.max(0.3, 50 / vitesse);
                animStyle = `animation-duration:${duration}s;`;
            }
        }
        return `<span style="${style}${animStyle}" class="${animClass}">${text}</span>`;
    }

    function updatePreview() {
        const text = textarea.value;
        const vitesse = vitesseInput ? parseFloat(vitesseInput.value) : null;
        if (text.trim() !== '') {
            textPreview.innerHTML = getStyledText(text, vitesse);
            textPreview.style.display = '';
        } else {
            textPreview.style.display = 'none';
        }
    }

    [fontSelect, fontSizeSelect, animationSelect, styleSelect, textColorInput, bgColorInput].forEach(sel => {
        if (sel) sel.addEventListener('change', updatePreview);
        if (sel && sel.type === 'color') sel.addEventListener('input', updatePreview);
    });
    if (vitesseInput) vitesseInput.addEventListener('input', updatePreview);
    textarea.addEventListener('input', updatePreview);

    // Affiche/cacher les couleurs selon le type
    const typeSelect = document.getElementById('type');
    function toggleColorFieldsModif() {
        const show = typeSelect.value === 'Message défilant';
        if (textColorInput) textColorInput.disabled = !show;
        if (bgColorInput) bgColorInput.disabled = !show;
        const textColorBlock = document.getElementById('textColorDefilementBlock');
        const bgColorBlock = document.getElementById('bgColorDefilementBlock');
        if (textColorBlock) textColorBlock.style.display = show ? '' : 'none';
        if (bgColorBlock) bgColorBlock.style.display = show ? '' : 'none';
    }
    if (typeSelect) {
        typeSelect.addEventListener('change', toggleColorFieldsModif);
        toggleColorFieldsModif();
    }
    // Initialisation à l'ouverture
    updatePreview();
});

</script>
