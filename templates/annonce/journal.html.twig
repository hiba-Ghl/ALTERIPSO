<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
{% endif %} #} 


 {% if appConfig.StatusServeur is same as('Offline') %}
  <script src="{{ asset('javascript/jszip.min.js') }}"></script>
<script src="{{ asset('javascript/pdfmake.min.js') }}"></script>
<script src="{{ asset('javascript/vfs_fonts.js') }}"></script>
<script src="{{ asset('javascript/dataTables.buttons.min.js') }}"></script>
<script src="{{ asset('javascript/buttons.html5.min.js') }}"></script>
<script src="{{ asset('javascript/jquery.min.js') }}"></script>
<script src="{{ asset('javascript/jquery.dataTables.min.js') }}"></script>
<script src="{{ asset('javascript/datatables2.min.js') }}"></script>
<script src="{{ asset('javascript/xlsx.full.min.js') }}"></script> 
<script src="{{ asset('javascript/dataTables.buttons.min.js') }}"></script>
<script src="{{ asset('javascript/clipboard.min.js') }}"></script>
   {% else %}
  <script src="{{asset('javascript/jquery.min.js')}}"> </script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
	<style type="text/css" src="https://cdn.datatables.net/1.10.23/css/jquery.dataTables.min.css"></style>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
  <script src="{{ asset('javascript/datatables2.min.js') }}"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.4/xlsx.full.min.js"></script> 
  <script src="https://cdn.datatables.net/buttons/2.3.3/js/dataTables.buttons.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/clipboard.js/2.0.8/clipboard.min.js"></script> 
  {% endif %} 



<!--le title header-->
<p id='p'></p>
<div class="journal-header">
    <img src="{{ asset('images/ler.png') }}">
    Journal des Annonces
</div>
   
<!--le tableau-->
<div id="journal-container">
<!--le bouton d'ajout-->
<div class="journal-btn-area">
<div>
    <a href="{{ path('app_annonce') }}" class="button btn btn-danger btn-retour-journal" name="add" id="add">
            <i class="glyphicon glyphicon-arrow-left"></i>
            Retour
</a>
</div>
<!--la barre de recherche-->
</div>
 <table class="table table-striped table-bordered header-fixed table-hover journal-table" id="dataTables-example">
    <thead> 
        <tr><th>Date envoie</th><th>Chambre</th><th>Annonce</th></tr>
    </thead> 
    <tbody id="myTable">
    {% for ann in annonceHistorique  %}
    <tr>
        <td data-label="Date envoie">{{ ann.date|date('d/m/Y H:i') }}</td>
        <td data-label="Chambre">{{ann.nom_chambre.nom}}</td>
        <td data-label="Annonce">{{ann.nom_annonce.nom}}</td>
    </tr>
    {% endfor %}
    </tbody>

</table>
</div>
<script>
   $(document).ready(function () {
      $('#dataTables-example').DataTable({
         language: {
            search: "Recherche:",
            emptyTable: "Aucun Annonce disponible."
         },
         paging: false,
         searching: true,
         ordering: true,
         info: false,
      });
   });
</script>


{% endblock %}
