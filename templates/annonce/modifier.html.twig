<!-- le control de la validite de l'adresse ip-->
<script>
        document.getElementById('ip').addEventListener('input', function() {
    var ipPattern = /^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$/;
    var ipAddress = this.value;

    if (!ipPattern.test(ipAddress)) {
        this.setCustomValidity("Veuillez entrer une adresse IP valide (par exemple, 192.168.1.1)");
    } else {
        this.setCustomValidity("");
    }
    });

</script>

<!-- l'affichage les champs et positions associees au type des le telechagement de la page-->
<script>
    
    document.addEventListener('DOMContentLoaded', function() {
        var type = '{{ ann.type }}';

        //les champs a afficher selon chaque type
        var fileUpload = document.getElementById('fileUpload');
        var textInput = document.getElementById('textInput');
        var fontSelection = document.getElementById('fontSelection');
        var languagesPart = document.getElementById('languagesPart');

        if (type === 'Message' ) {
            fileUpload.style.display = 'none';
            textInput.style.display = 'block';
            fontSelection.style.display = 'block';
            languagesPart.style.display = 'block';
            ipAddress.style.display = 'none';
        } else if (type === 'Image' || type === 'Video' || type === 'PDF') {
            fileUpload.style.display = 'block';
            textInput.style.display = 'none';
            fontSelection.style.display = 'none';
            languagesPart.style.display = 'none';
            ipAddress.style.display = 'none';
            const file = document.getElementById('file');
            if(type === 'Image')
                file.setAttribute('accept','.png, .jpeg, .jpg');
            if(type === 'Video')
                file.setAttribute('accept','.mp4');
            if(type === 'PDF')
            {
                console.log(file);
                file.setAttribute('accept','.pdf');
            }
        } else if (type === 'Localtv'){
            fileUpload.style.display = 'none';
            textInput.style.display = 'none';
            fontSelection.style.display = 'none';            
            ipAddress.style.display = 'block';
            languagesPart.style.display = 'none';
        }

        const positionSelect = document.getElementById('position');
        const positions = type === 'Video' || type === 'Localtv' || type === 'PDF'
            ? ['Milieu']
            : ['Haut', 'Bas', 'Gauche', 'Droite', 'Milieu'];

        const selectedValue = positionSelect.getAttribute("value");
        positionSelect.innerHTML = '';
        positions.forEach(function(pos) {
            const option = document.createElement('option');
            if(selectedValue === pos)
                option.selected = true;
            option.value = pos;
            option.textContent = pos.charAt(0).toUpperCase() + pos.slice(1);
            positionSelect.appendChild(option);
        });


    });


    
        
    
</script>


<!--le control de la taille du fichier a telecharger selon le type-->
<script>
    document.getElementById('annonceForm').addEventListener('submit', function(event) {
        const type = document.getElementById('type').value;
        const oldType = document.getElementById('type').getAttribute('oldvalue');

        const fileInput = document.getElementById('file');
        const errorMessage = document.getElementById('error-message');

        // Clear previous error messages
        errorMessage.textContent = '';
    

        const file = fileInput.files[0];
        if (!file && oldType != type && (type === 'Image' || type === 'Video' || type === 'PDF')) {
        console.log(type,oldType,fileInput.value);
            errorMessage.textContent = 'Veuillez sélectionner un fichier s\'il vous plait .';
            event.preventDefault();
            return;
        }

        const fileSize = file.size;

        let valid = true;
        if (type === 'Image') {
            const maxSize = 400 * 1024; // 400 KB            
            if (  fileSize > maxSize) {
                valid = false;
                errorMessage.textContent = 'La taille de l\'image est invalide. Max 400KB (PNG, JPEG, JPG).';
            }
        } else if (type === 'Video') {
            const maxSize = 60 * 1024 * 1024; // 60 MB

            if (  fileSize > maxSize) {
                valid = false;
                errorMessage.textContent = 'La taille de la video est invalide. Max 60MB (MP4, MPG2, M2T, 3GP).';
            }
        } else if (type === 'PDF') {
            const maxSize = 100 * 1024 * 1024; // 100 MB

            if ( fileSize > maxSize) {
                valid = false;
                errorMessage.textContent = 'La taille du PDF est invalide. Max 200MB.';
            }
        }

        if (!valid) {
            console.log("test");
            event.preventDefault(); // pas de submission si la validation echoue
        }
    });
</script>

