 {% extends 'home/index.html.twig' %}
 
{% block body %}

<style>
		#div1 {
			border-radius: 25px;
			border: 2px solid #3087ce;
			padding: 20px;
			width: 1091px;
			height: 500px;
			margin-left: 10px;
			margin-top: 10px;	
			padding: 43px;
		}
		#div2 {
			border-radius: 25px;
			border: 2px solid #3087ce;
			padding: 20px;
			width: 1091px;
			height: 550px;
			margin-left: 10px;
			margin-top: 10px;
		}
	</style>
 
<!--     -->
<div style="border-radius: 8px;text-align: center;margin-left: 10px;color: white;font-style: oblique;font-size: 20px;background-color: #3087ce;width: 250px;padding-left: 10px;">
    Profil
</div>
 
<br>

{% for message in app.flashes('success') %}
    <div class="alert alert-success">
        {{ message }}
    </div>
{% endfor %}

{% for message in app.flashes('error') %}
    <div class="alert alert-danger">
        {{ message }}
    </div>
{% endfor %}


<div id="div2">
<!--  -->
<form name="" method="post" action="{{ path('modifierProfil', {'id': app.user.id}) }}" class="form-horizontal" enctype="multipart/form-data">
    <div style="border-radius: 8px;text-align: center;margin-left: 200px;color: white;font-style: oblique;font-size: 20px;background-color: #3087ce;width: 250px;padding-left: 10px;">
        Modifier votre profil
    </div>          
       <br>
        <!-- username -->
        <div class="form-group">
            <label for="username" class="col-lg-2 control-label">Nom d'utilisateur
            </label>
            <div class="col-lg-10">
                <input type="text" id="username" name="username" class="form-control" value="{{app.user.username}}" required />
            </div>
        </div>

        <!-- email -->
        <div class="form-group">
            <label for="email" class="col-lg-2 control-label">Email
            </label>
            <div class="col-lg-10">
                <input type="email" id="email" name="email" class="form-control" value="{{app.user.email}}"  required/>
            </div>
        </div>

        <div style="border-radius: 8px;text-align: center;margin-left: 200px;color: white;font-style: oblique;font-size: 20px;background-color: #3087ce;width: 250px;padding-left: 10px;">
                Modifier votre mot de passe
        </div>

        <br>

        <!-- ancien password -->
        <div class="form-group">
            <label for="password" class="col-lg-2 control-label">Ancien mot de passe
            </label>
            <div class="col-lg-10">
                <input type="password" id="password" name="password" class="form-control"  placeholder="Veuillez saisir votre mot de passe" required />
            </div>
        </div>

        <!-- nouveau password -->
        <div class="form-group">
            <label for="newPassword" class="col-lg-2 control-label">Nouveau mot de passe</label>
            <div class="col-lg-10">
                <input type="password" id="newPassword" name="newPassword" class="form-control" placeholder="Veuillez saisir le nouveau mot de passe"  />
                <svg class="toggle-password" style="cursor: pointer; margin-right: 20px;"  onclick="togglePasswordVisibility()" width="16" height="16" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16">
                <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                </svg>
                </svg>
            </div>
        </div>

        <!--confirmer password -->
        <div class="form-group">
            <label for="confirmPassword" class="col-lg-2 control-label">Confirmer mot de passe
            </label>
            <div class="col-lg-10">
                <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" placeholder="Confirmez le nouveau mot de passe"/>
            </div>
        </div>
        <script>
            // Fonction de la visibilité du mot de passe
            function togglePasswordVisibility() {
                  // Sélectionne l'élément du champ de saisie 
                var passwordInput = document.getElementById("newPassword");
                // Sélectionne l'icône de basculement de la visibilité  
                var toggleIcon = document.querySelector(".toggle-password");
                // Vérifie le type actuel du champ de saisie du mot de passe
                if (passwordInput.type === "password") {
                    // Si le mot de passe est masqué, le rend visible
                    passwordInput.type = "text";
                    // Change l'icône en un œil ouvert pour indiquer que le mot de passe est visible
                    toggleIcon.classList.remove("bi-eye-slash");
                    toggleIcon.classList.add("bi-eye");
                } else {
                    // Si le mot de passe est visible, le masque
                    passwordInput.type = "password";
                    // Change l'icône en un œil barré pour indiquer que le mot de passe est masqué
                    toggleIcon.classList.remove("bi-eye");
                    toggleIcon.classList.add("bi-eye-slash");
                }
            }
        </script>
        <style>
                /* Style pour l'icône */
                .toggle-password {
                    position: absolute;
                    top: 50%;
                    right: 10px;
                    transform: translateY(-50%);
                    cursor: pointer;
                }

                /* Style pour cacher l'icône lorsque le champ est vide */
                .toggle-password.hidden {
                    display: none;
                }
        </style>
        <br>
        <!-- button enregistrer et annuler  -->
        <button type="submit" class="btn btn-success" style="margin-left: 920px;position: absolute;background-color: #3087ce; border: 2px solid #3087ce;"><svg  width="16" height="16" fill="currentColor" class="bi bi-floppy" viewBox="0 0 16 16">
        <path d="M11 2H9v3h2z"/>
        <path d="M1.5 0h11.586a1.5 1.5 0 0 1 1.06.44l1.415 1.414A1.5 1.5 0 0 1 16 2.914V14.5a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 0 14.5v-13A1.5 1.5 0 0 1 1.5 0M1 1.5v13a.5.5 0 0 0 .5.5H2v-4.5A1.5 1.5 0 0 1 3.5 9h9a1.5 1.5 0 0 1 1.5 1.5V15h.5a.5.5 0 0 0 .5-.5V2.914a.5.5 0 0 0-.146-.353l-1.415-1.415A.5.5 0 0 0 13.086 1H13v4.5A1.5 1.5 0 0 1 11.5 7h-7A1.5 1.5 0 0 1 3 5.5V1H1.5a.5.5 0 0 0-.5.5m3 4a.5.5 0 0 0 .5.5h7a.5.5 0 0 0 .5-.5V1H4zM3 15h10v-4.5a.5.5 0 0 0-.5-.5h-9a.5.5 0 0 0-.5.5z"/>
        </svg></i> Enregistrer</button>
        <button type="button" class="btn btn-danger" style="margin-left: 800px; position: absolute; border: 2px solid;" onclick="annuler()"><svg  width="16" height="16" fill="currentColor" class="bi bi-x-lg" viewBox="0 0 16 16">
        <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z"/>
        </svg></i> Annuler</button>
        <script>
        // fonction pour le button annulé
            function annuler() {
                window.location.href = "home"; 
            }     
        </script>

 </form>
 
</div>
<br>
{% endblock %}