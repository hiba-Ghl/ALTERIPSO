<script>
// Affichage/Masquage du bloc d'émoticônes
document.addEventListener('DOMContentLoaded', function() {
    var btn = document.getElementById('openEmojiBlock');
    var block = document.getElementById('emojiSpecialBlock');
    var textarea = document.getElementById('text');
    var preview = document.getElementById('text-preview');

    if (btn && block && textarea) {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            block.style.display = (block.style.display === 'none' ? 'block' : 'none');
        });
        // Clic sur un élément du bloc : insérer dans le textarea
        block.addEventListener('click', function(e) {
            if (e.target && e.target.classList.contains('emoji-item')) {
                insertAtCursor(textarea, e.target.innerText);
                block.style.display = 'none';
                
                // Déclencher l'événement input pour que le script d'animation le prenne en compte
                textarea.dispatchEvent(new Event('input', { bubbles: true }));
            }
        });
        // Fermer le bloc si clic ailleurs
        document.addEventListener('mousedown', function(e) {
            if (!block.contains(e.target) && e.target !== btn) {
                block.style.display = 'none';
            }
        });
    }
    // Fonction d'insertion à la position du curseur
    function insertAtCursor(myField, myValue) {
        if (document.selection) {
            myField.focus();
            var sel = document.selection.createRange();
            sel.text = myValue;
        } else if (myField.selectionStart || myField.selectionStart === 0) {
            var startPos = myField.selectionStart;
            var endPos = myField.selectionEnd;
            myField.value = myField.value.substring(0, startPos)
                + myValue
                + myField.value.substring(endPos, myField.value.length);
            myField.selectionStart = myField.selectionEnd = startPos + myValue.length;
            myField.focus();
        } else {
            myField.value += myValue;
            myField.focus();
        }
    }
});
</script>

