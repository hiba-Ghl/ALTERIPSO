<script>
  document.addEventListener("DOMContentLoaded", function () {
    if (typeof errorUrl !== 'undefined' && typeof service_src !== 'undefined') {
      handleErrorAndReset(errorUrl, service_src);
    }
    const serviceSrcInput = document.getElementById("service_src");
    if (serviceSrcInput) {
      serviceSrcInput.addEventListener("change", getFiles, false);
    }
    if (!document.getElementById("dia")) {
      const newElement = createDiapoInfo(); 
      const add = document.getElementById("diapo");
      if (add && add.children.length > 0) {
        add.children[0].appendChild(newElement);
      }
    }
  });
</script>

{# ################################################################################################## #}
{# Cette fonction change les attributs de la source input selon le type que je sélectionne#}
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const service_type = document.getElementById("service_type");
    const service_src = document.getElementById("service_src");

    service_type.addEventListener("click", function () {  
  const errorUrl = document.getElementById("url");
  const divAll = document.querySelector('#divAll');
  const pError = document.getElementById("pError");
  service_src.style.border = '';
  if(pError)
    pError.remove();
  if(divAll)
    divAll.remove();

service_src.removeAttribute('multiple');
  service_src.removeEventListener("change", getFiles, false);
  clearFileInput(service_src);
  if (service_type.value === "PDF") {
    service_src.type = "file";
    service_src.name = "service_src";
    service_src.setAttribute("accept", ".pdf");
    handleErrorAndReset(errorUrl, service_src);
  } else if (service_type.value === "IMAGE") {
    service_src.type = "file";
    service_src.name = "service_src";
    service_src.setAttribute("accept", ".png, .jpeg, .jpg");
    handleErrorAndReset(errorUrl, service_src);
  } else if (service_type.value === "DIAPO") {
    service_src.type = "file";
    service_src.setAttribute("multiple", "multiple");
    service_src.setAttribute("accept", ".jpg, .jpeg, .png");
    handleErrorAndReset(errorUrl, service_src);

    service_src.addEventListener("change", getFiles, false);
    if (!document.getElementById("dia")) {
      const newElement = createDiapoInfo(); 
      const add = document.getElementById("diapo");
      add.children[0].appendChild(newElement);
    }
  } else if (service_type.value === "VIDEO") {
    service_src.type = "file";
    service_src.name = "service_src";
    service_src.setAttribute("accept", ".mp4, .mpg");
    handleErrorAndReset(errorUrl, service_src);
  } else if (service_type.value === "URL") {
    service_src.type = "text";
    service_src.name = "url";
    service_src.placeholder = "https://example.com";
    const add = document.getElementById("dia");
    if (add) add.remove();
  }
});

  });
</script>
