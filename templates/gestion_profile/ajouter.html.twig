<script>
 	const username = document.getElementById('contact_Identifiant');
    const email = document.getElementById('contact_email');
    const password =  document.getElementById('contact_plainPassword_first');
    const confirmPassword = document.getElementById('contact_plainPassword_second'); 
	username.addEventListener('change',async (e) => {
			const response = await fetch("/searchExisteUtilisateur", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({ username : e.target.value, email })
        });

        if (!response.ok) {
            console.error("Network response was not ok");
            return false;
        }
        var text = e.target.value;
    	var firstLetter = text.slice(0,1);
    	text =firstLetter.toUpperCase() + text.substring(1);
    	username.value = text;
        const data = await response.json();
		if(data.exists)
		{
		username.style.border ='2px solid red';
        const ErreurNom = document.getElementById('ErreurNom');
        if(!ErreurNom)
        {
        const p = document.createElement('p');
        p.setAttribute('id','ErreurNom');
        p.textContent = 'Le nom d\'utilisateur existe déjà.';
        p.style.color ='red';
        document.getElementById('requiredNom').appendChild(p);
        }
		}
	})
	username.addEventListener('click',(e) => {
		const ErreurNom = document.getElementById('ErreurNom');
		const existUseName = document.getElementById('existUseName');
		if(existUseName)
		{
			existUseName.remove();
		}
        if(ErreurNom)
		{
		    username.style.border ='2px solid black';
			ErreurNom.remove();
		}
	})
	email.addEventListener('click',(e) =>{
		const ErreurEmail = document.getElementById('ErreurEmail');
		const existMail = document.getElementById('existMail');
		if(existMail)
		{
			existMail.remove();
		}
        if(ErreurEmail)
        {
			email.style.border ='2px solid black';
			ErreurEmail.remove();
		}
		 const ErreurEmail1 = document.getElementById('ErreurEmailValid');
        if(ErreurEmail1)
        {
			email.style.border ='2px solid black';
			ErreurEmail1.remove();
		}
	})
	email.addEventListener('change',async (e) => {
			const response = await fetch("/searchExisteUtilisateur", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({ username : null, email:e.target.value})
        });
        if (!response.ok) {
            console.error("Network response was not ok");
            return false;
        }
        
        const data = await response.json();
		var text = e.target.value;
    	var firstLetter = text.slice(0,1);
    	text =firstLetter.toUpperCase() + text.substring(1);
    	email.value = text;
		if(data.exists)
		{

		email.style.border ='2px solid red';
        const ErreurEmail = document.getElementById('ErreurEmail');
        if(!ErreurEmail)
        {
        const p = document.createElement('p');
        p.setAttribute('id','ErreurEmail');
        p.textContent = 'L \'email d\'utilisateur existe déjà.';
        p.style.color ='red';
        document.getElementById('requiredEmail').appendChild(p);
        }
		}
	})
	password.addEventListener('click',(e)=>{
	const ErreurPassword = document.getElementById('ErreurPassword');
