{# fonction pour verifier le mot de passe pour exporter les donnes d'etablissement #}
<script>
   document.addEventListener('submit', async function(event) {
    if (event.target.id === 'passwordForm1') {
        event.preventDefault();
        const password = document.querySelector('input[name="password2"]').value;
        const userId = document.getElementById("submit").getAttribute('data-id');
        const EtablissementId = document.getElementById("submit").getAttribute('data-user-id');
		const modalBody = document.getElementById("modal-body");
        if (password === "") {
            	if(modalBody)
					{
						const erreur = document.getElementById('erreurExport');
                		if(!erreur)
                		{
							const p = document.createElement('p');
							p.textContent="Entrez votre mot de passe s'il vous plaît";
							p.setAttribute('id','erreurExport');
							p.style.color = "red";
							modalBody.appendChild(p);
						}
					}
            		return false;
        } else {
            try {
                const response = await fetch(`/app_Confirme_export/${userId}`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({ password: password }) 
                });
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                const data = await response.json();
                if (data.passwordValid) {
                $('.modal').modal('hide');
					window.location.href =`/export/${EtablissementId}`;
                } else {
					if(modalBody)
					{
						const erreur = document.getElementById('erreurExport');
                		if(!erreur)
                		{
							const p = document.createElement('p');
							if(data.message)
								p.textContent = data.message;
							else 
								p.textContent="Le mot de passe est invalide. Merci de réessayer avec un mot de passe correct.";
							p.setAttribute('id','erreurExport');
							p.style.color = "red";
							modalBody.appendChild(p);
						}
					}
                }
            } catch (error) {
                console.error('Error:', error);
                alert("There was an error processing your request.");
            }
        }
        return true;
    }
    });
    
</script>
