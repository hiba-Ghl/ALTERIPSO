<script>
    function readURL(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();

            reader.onload = function (e) {
                imgId = '#preview-' + $(input).attr('id');
                $(imgId).attr('src', e.target.result);
            }

            reader.readAsDataURL(input.files[0]);
        }
    }

    $("div#mainform input[type='file']").change(function () {
        readURL(this);
    });
    $("div#mainform0 input[type='file']").change(function () {
        readURL(this);
    });

    $(document).ready(function () {
        $("#myInput3").on("keyup", function () {
            var value = $(this).val().toLowerCase();
            $("#myTable3 tr").filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });
    });

    $(document).ready(function () {
        $('input:radio').change(function () {
            if ($(this).val() === 'r_defini') {
                $(".d_defini").show();
                $("#d_fin").attr("required", "true");
                $("#d_debut").attr("required", "true");
            } else {
                $(".d_defini").hide();
            }
        });
    });

    $('#checklist').click(function () {
        var magazines = $("label").find(':checkbox.jpCheckbox');
        if (this.checked) {
            magazines.prop('checked', true);
        } else {
            magazines.prop('checked', false);
        }
    });

    $('#checklistgratuite').click(function () {
        var magazines = $("label").find(':checkbox.jpCheckbox2');
        if (this.checked) {
            magazines.prop('checked', true);
        } else {
            magazines.prop('checked', false);
        }
    });

</script>









<script>
  const chambre = {{chambre | raw }};
function createModal(index,Id,name) {
    const popUP = document.createElement('div');
    popUP.setAttribute("class", "modal fade");
    popUP.setAttribute("tabindex", "-1");
    popUP.setAttribute("role", "dialog");
    popUP.setAttribute("id", `modal1-${index}`);
    popUP.setAttribute("aria-labelledby", "modalLabel1");
    popUP.setAttribute("aria-hidden", "true");
    popUP.innerHTML = `
        <div class="modal-dialog" role="document">
            <div class="modal-content radio-modal-content-responsive">
                <div class="modal-header" style="margin-top:30px;">
                <button id="close" type="button" class="close close2" data-dismiss="modal1-${index}" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <div style="border-radius: 8px; text-align: left; margin: 10px 0; color: white; font-style: oblique; font-size: 20px; background-color: #3087ce; width: 220px; padding: 5px 10px;">
                    <img style="margin-top: -55px; margin-left: -10px; width: 45px; float: left;" src="{{ asset('images/ler.png') }}" alt="Icon">
                        Lancer la Radio ${name}
                    </div>
                </div>
                <form style="height:100%" id="form" method="post" enctype="multipart/form-data" action="/radio/LancerRadio/${Id}">
                <div class="modal-body" id="modal-body1-${index}" >
                <div style="font-size:16px;color:black;">Liste Support connecté à choisir</div>
                </div>
                <div class="modal-footer">
                  <button id="envoyervod" type="submit" class="btn btn-primary conf" name="envoyervod"> <i class="glyphicon glyphicon-send"></i> Lancer la Radio</button>
                  <a class="btn btn-danger " style="width: 139px;" href="/radio/" role="button"><i class="glyphicon glyphicon-remove"></i> Annuler</a></div>
            </div>
            </form>
        </div>    
    `;
    return popUP;
}

document.addEventListener('click', function (event) {
    const lancerButton = event.target.closest('.lancer-button');
    console.log(lancerButton);
    if(!lancerButton)
      return ;
    const Id = lancerButton.getAttribute('data-id');
    const name = lancerButton.getAttribute('data-name');
    const active = document.getElementById(`active-${Id}`);
    let index = -1;
    if (lancerButton.getAttribute("data-target")) {
      index = lancerButton.getAttribute("data-target").split('-')[1];
      if(index >= 0)
      {
        if (active && !active.checked) {
        confirm("Attention, La radio n'est pas actif, donc non présent sur la box. Merci de le cocher.Faites dans un premier temps la mise à jour sur la BOX.Enfin, vous pouvez lancer la Radio avec l'icône bleue.");
        event.preventDefault(); 
        return false;
      }
      else{
        const body = document.getElementById('div2');
        const modal = createModal(index,Id,name);
        body.appendChild(modal);
    const modalBody1 = document.querySelector(`#modal-body1-${index}`);
    if (modalBody1 && Array.isArray(chambre)) {
      const existeTable = document.getElementById(`table-${index}`);
      if(!existeTable)
      {
      const table = document.createElement('table');
      table.style.width = "100%";
      table.setAttribute("class","table table-striped header-fixed table-bordered table-hover table-checkable order-column dataTable no-footer");
      table.id = `table-${index}`;
      const thead = document.createElement('thead');
      thead.style.width = "100%";
      thead.innerHTML = `
        <tr style="width:100%;display:flex;justify-content:space-between">
          <th style="width:120px;height:60px;display:flex;align-items: center;gap:5px"><input type="checkbox" id="checkAllboxn"/><p style="color:red">Selectionner / Désélectionner</p></th>
          <th style="width:120px;height:60px;display:flex;align-items: center;justify-content:center">Chambre</th>
          <th style="width:120px;height:60px;display:flex;align-items: center;justify-content:center">Adresse IP</th>
          <th style="width:120px;height:60px;display:flex;align-items: center;justify-content:center">Adresse MAC</th> 
        </tr>`;
      table.appendChild(thead);
      const tbody = document.createElement('tbody');
      tbody.style.width = "100%";
      let i = 0;
      chambre.forEach(chbr => {
    const tr1 = document.createElement('tr');
    tr1.style.width = "100%";
    tr1.style.height = "50px";
    tr1.style.display = "flex";
    tr1.style.justifyContent = 'space-between';
    tr1.innerHTML = `
        <td style="width:120px;height:40px;"><input type="checkbox" value=${chbr.id} name="checked[${i}]" class="boxcheck"/><input style="display:none" type="text" value=${chbr.id} name="chambre[${i}]"></td>
        <td style="width:120px;height:40px;text-align:center;">${chbr.nom}</td>
        <td style="width:120px;height:40px;text-align:center;">${chbr.ip}</td>
        <td style="width:120px;height:40px;text-align:center;">${chbr.Mac}</td>`;
    tbody.appendChild(tr1);
    i++;
});
      table.appendChild(tbody);
      modalBody1.appendChild(table);
      const modal = document.getElementById(`modal1-${index}`);
      modal.classList.remove('fade');
      modal.classList.add('show'); 
      modal.style.display = 'block';
		document.body.style.overflow = 'hidden';
      modal.style.overflowY = 'auto';
      modal.style.maxHeight = '90vh';
      if (!$.fn.dataTable.isDataTable(`#table-${index}`)) {
      $(`#table-${index}`).DataTable({
        language: {
        emptyTable: "Aucune chambre disponible."
    },
        oLanguage: {"sSearch": "Recherche:"},
        paging: false,
        searching: true,
        ordering: false,
        info: false,
        columnDefs: [{ orderable: false, targets: 0 }]
      });
    }
    }
      }
      }
      }
    }
  const checkAll = document.getElementById('checkAllboxn');
const checkboxes = document.querySelectorAll('.boxcheck');

if (checkAll) {
    checkAll.addEventListener('change', () => {
        checkboxes.forEach(checkbox => {
            checkbox.checked = checkAll.checked;
        });
    });
}

if (checkboxes) {
    checkboxes.forEach(checkbox => {
        checkbox.addEventListener('change', () => {
            if (!checkbox.checked) {
                checkAll.checked = false;
            } else if (Array.from(checkboxes).every(cb => cb.checked)) {
                checkAll.checked = true;
            }
        });
    });
}
})

document.addEventListener('click', function (event) {
    const CloseButton = event.target.closest('.close2');
    if(!CloseButton)
        return;
  const dataDismiss = CloseButton.getAttribute("data-dismiss");
   if (dataDismiss) {
    const index = dataDismiss.split('-')[1]; 
    const modal = document.getElementById(`modal1-${index}`); 
    const modalBackdrop = document.getElementsByClassName("modal-backdrop");
    if (modal) {
      modal.classList.remove('show');
      modal.classList.add('fade');
      modal.style.display = 'none';
	   document.body.style.overflow = '';
      modal.style.overflowY = '';
      modal.remove();
    }
    if (modalBackdrop[0]) {
      modalBackdrop[0].remove();
      if(modalBackdrop[0]);
      modalBackdrop[0].remove();
    }
  }

})


