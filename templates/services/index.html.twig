{# la fonction pour afficher les images de Diapo sur PopUp sous forme slides #}
const formatTime = (seconds) => {
  const hrs = Math.floor(seconds / 3600).toString().padStart(2, '0');
  const mins = Math.floor((seconds % 3600) / 60).toString().padStart(2, '0');
  const secs = (seconds % 60).toString().padStart(2, '0');
  return `${hrs}:${mins}:${secs}`;
};
document.addEventListener('click', async (event) => {
  if (event.target && event.target.classList.contains('source-link')) {
    event.preventDefault();
    const type = event.target.dataset.type;
    const id = event.target.dataset.id;
    const index = event.target.dataset.target.split('-')[1];
    const value = event.target.dataset.value;
  const modalBody = document.querySelector(`#modal-body-${index}`);
 if (type === 'DIAPO') {
  const images = await getImages(id);
  const imageArray = Object.values(images);

  if (modalBody) {
    modalBody.innerHTML = '';
    const carousel = document.createElement('div');
    carousel.setAttribute('class', 'carousel');

    const carouselInner = document.createElement('div');
    carouselInner.setAttribute('class', 'carousel-inner');
    carouselInner.style.position = 'relative';
    carouselInner.style.width = '100%';
    carouselInner.style.overflow = 'hidden';

    let totalDuration = 0;
    const slideDurations = imageArray.map((image) => {
      const durationValue = image.split('_')[1]?.split('.')[0] || '1';
      const duration = parseInt(durationValue, 10);
      totalDuration += duration;
      return duration;
    });

    imageArray.sort((a, b) => {
      const orderA = parseInt(a.split('_')[0], 10) || 0;
      const orderB = parseInt(b.split('_')[0], 10) || 0;
      return orderA - orderB;
    });
    imageArray.forEach((image, index) => {
      const slideItem = document.createElement('div');
      slideItem.setAttribute('class', `carousel-item ${index === 0 ? 'active' : ''}`);
      slideItem.style.width = '100%';
      slideItem.style.display = index === 0 ? 'block' : 'none';
      slideItem.innerHTML = `<img src="{{ asset('${value}/${image}') }}" style="width: 100%; height: 540px; object-fit:cover" />`;
      carouselInner.appendChild(slideItem);
    });

    carousel.appendChild(carouselInner);
    const progressBarContainer = document.createElement('div');
    progressBarContainer.setAttribute('class', 'divCrono');

    const progressBar = document.createElement('div');
    progressBar.setAttribute('class', 'crono');

    const progress = document.createElement('div');
    progress.setAttribute('class', 'progress');
    progress.style.height = '100%';
    progress.style.backgroundColor = '#3087ce';
    progress.style.width = '0%';

    const progressLabel = document.createElement('span');
    progressLabel.setAttribute('class', 'spanC');
    progressLabel.textContent = `${formatTime(0)}`;
    progress.appendChild(progressLabel);

    progressBar.appendChild(progress);
    progressBarContainer.appendChild(progressBar);

    const totalTimeDisplay = document.createElement('p');
    totalTimeDisplay.setAttribute('class', 'timeTotal');
    totalTimeDisplay.textContent = `${formatTime(0)}`;

    modalBody.appendChild(carousel);
    modalBody.appendChild(progressBarContainer);
    modalBody.appendChild(totalTimeDisplay);

let currentIndex = 0;
let elapsedTime = 0;
let totalElapsedTime = 0;

const updateSlides = () => {
  const slides = carouselInner.querySelectorAll('.carousel-item');
  slides.forEach((slide, index) => {
    slide.style.display = index === currentIndex ? 'block' : 'none';
  });
};
const startSlideshow = () => {
  updateSlides(); 
  const interval = setInterval(() => {
    elapsedTime++;
    totalElapsedTime++;
    const progressPercentage = (totalElapsedTime / totalDuration) * 100;
    progress.style.width = `${progressPercentage}%`;
    totalTimeDisplay.textContent = `${formatTime(totalElapsedTime)}`;
    progressLabel.textContent = `${formatTime(totalElapsedTime)}`;
    if (elapsedTime >= slideDurations[currentIndex]) {
      elapsedTime = 0; 
      currentIndex = (currentIndex + 1) % imageArray.length;
      updateSlides(); 
    }
    if (totalElapsedTime >= totalDuration) {
      totalElapsedTime = 0;
      elapsedTime = 0;
    }
  }, 1000); 
};

startSlideshow();
  }
}
 else if( type === 'VIDEO' && modalBody){
    modalBody.innerHTML = ` <video width="100%" height="680px" controls>
        <source src="{{ asset('${value}')}}" type="video/mp4">
        Votre navigateur ne supporte pas la lecture de la vidéo.
